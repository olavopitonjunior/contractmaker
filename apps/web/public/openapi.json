                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "action": {
                            "type": "string"
                          },
                          "result": {
                            "type": "string"
                          },
                          "resource": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "resourceType": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "metadata": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "additionalProperties": {}
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "userId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "action",
                          "result",
                          "resource",
                          "resourceType",
                          "metadata",
                          "createdAt",
                          "userId"
                        ]
                      }
                    },
                    "count": {
                      "type": "number"
                    },
                    "nextSince": {
                      "type": "string",
                      "format": "date-time"
                    }
