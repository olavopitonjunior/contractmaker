          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "preview": {
                      "type": "object",
                      "additionalProperties": {}
                    },
                    "approvedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "executedAt": {
                      "type": [
                        "string",
