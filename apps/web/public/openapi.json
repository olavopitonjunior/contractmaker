                    "dealId",
                    "status",
                    "version",
                    "partes",
                    "valor",
                    "ultimaAtualizacao",
                    "envelopeAtual",
                    "markdown"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/contracts/{id}/approve": {
      "post": {
        "description": "Aprova contrato. Bearer → cria ActionIntent (HITL). Session → executa direto. Force=true ignora warnings (não bypassa erros).",
        "tags": [
          "Contracts"
        ],
        "security": [
          {
            "bearerAuth": [
              "contracts:rw"
            ]
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "UUID v4 — uma key por intenção, TTL 24h"
            },
            "required": false,
            "description": "UUID v4 — uma key por intenção, TTL 24h",
            "name": "X-Idempotency-Key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "force": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aprovado (session) ou requiresReview com issues",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "aprovado"
                          ]
                        }
                      },
                      "required": [
                        "status"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "requiresReview": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "canForce": {
                          "type": "boolean"
                        },
                        "issues": {
                          "type": "array",
                          "items": {}
                        },
                        "errorCount": {
                          "type": "number"
                        },
                        "warningCount": {
                          "type": "number"
                        },
                        "pendingSuggestions": {
                          "type": "number"
                        },
                        "unresolvedComments": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "requiresReview",
                        "canForce",
                        "issues",
                        "errorCount",
                        "warningCount",
                        "pendingSuggestions",
                        "unresolvedComments"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Bearer: intent pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentPendingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/deals/{dealId}/commission-charges": {
      "post": {
        "description": "Cria cobrança de comissão Asaas. Bearer → ActionIntent (HITL). Session → executa direto.",
        "tags": [
          "Charges"
        ],
        "security": [
          {
            "bearerAuth": [
              "charges:rw"
            ]
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "dealId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "billingType": {
                    "type": "string",
                    "enum": [
                      "PIX",
                      "BOLETO"
                    ]
                  },
                  "dueDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
