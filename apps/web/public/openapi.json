                      ]
                    },
                    "status": {
                      "type": "string"
                    },
                    "version": {
                      "type": "number"
                    },
                    "partes": {
                      "type": "object",
                      "properties": {
                        "vendedores": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "nome": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "nome"
                            ]
                          }
                        },
                        "compradores": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "nome": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "nome"
                            ]
                          }
                        }
                      },
                      "required": [
                        "vendedores",
                        "compradores"
                      ]
                    },
                    "valor": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "ultimaAtualizacao": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "envelopeAtual": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "signedCount": {
                          "type": "number"
                        },
                        "totalSigners": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id",
                        "status",
                        "signedCount",
                        "totalSigners"
