                      "format": "date-time"
                    },
                    "rejectionReason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "result": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": {}
                    },
                    "errorMessage": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
