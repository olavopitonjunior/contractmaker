# Database (PostgreSQL via Neon or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth (NextAuth v5)
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# AI (Anthropic Claude) — agent do chat do editor de contrato
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Cheaper model for passive analysis triggered on every edit (debounced).
# Defaults to claude-haiku-4-5-20251001 if unset.
ANTHROPIC_PASSIVE_MODEL=claude-haiku-4-5-20251001

# Gemini API — usado pela Etapa 0 do formulario (classifyAndExtract) para OCR de RG/CPF/CNH/matricula/IPTU
# Obter em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: override do modelo (default gemini-2.5-flash). Alternativas: gemini-2.5-flash-lite, gemini-2.0-flash
GEMINI_OCR_MODEL=gemini-2.5-flash

# Legacy: modelo para classifyDocument/extractDocumentData (tool do agent do chat, nao o form)
OCR_MODEL=claude-haiku-4-5-20251001

# Voyage AI — embeddings for the knowledge base (RAG).
# Get your key at https://dash.voyageai.com
# Leave empty to disable semantic search; the agent falls back to keyword search.
VOYAGE_API_KEY=
# voyage-law-2 is specialized for legal text in PT-BR (1024 dim, best quality).
VOYAGE_EMBED_MODEL=voyage-law-2

# Storage (optional - S3, defaults to local .storage/)
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OCR (optional - requires AWS Textract + S3)
OCR_ENABLED=false

# Certidoes via Infosimples — extracao automatizada de certidoes juridicas
# (CND Federal, CNDT, TRF Civel, CEAT, protestos, CND IPTU, TJ estadual).
# Obter token em https://infosimples.com — planos a partir de R$ 39/mes.
INFOSIMPLES_TOKEN=
# Budget mensal total em centavos de R$ (default 5000 = R$ 50,00).
# Quando o gasto acumulado do mes atingir esse valor, novas extracoes sao bloqueadas.
INFOSIMPLES_MONTHLY_BUDGET_CENTS=5000
# Segredo para o endpoint de cron /api/cron/certidoes/poll-portal (opcional).
# Se definido, o cron exige Authorization: Bearer <valor> no header.
CRON_SECRET=

# Features
ALLOW_SELF_REGISTER=true
