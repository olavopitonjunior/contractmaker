# Database (PostgreSQL via Neon or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth (NextAuth v5)
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# AI (Anthropic Claude) — agent do chat do editor de contrato
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Cheaper model for passive analysis triggered on every edit (debounced).
# Defaults to claude-haiku-4-5-20251001 if unset.
ANTHROPIC_PASSIVE_MODEL=claude-haiku-4-5-20251001

# Budget de tokens IA por contrato. Soma AIUsage.totalTokens por contractId
# e bloqueia chat + passive analysis quando atinge esse teto. Default 200000
# (~$0.50 USD em Sonnet 4 sem cache, ~25 turns de chat ou ~65 passes passivos).
# Ver lib/ai/budget.ts e endpoint GET /api/contracts/[id]/budget.
# CONTRACT_AI_TOKEN_BUDGET=200000

# Gemini API — usado pela Etapa 0 do formulario (classifyAndExtract) para OCR de RG/CPF/CNH/matricula/IPTU
# Obter em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: override do modelo (default gemini-2.5-flash). Alternativas: gemini-2.5-flash-lite, gemini-2.0-flash
GEMINI_OCR_MODEL=gemini-2.5-flash

# OCR async worker — configuracao por tier Gemini (ver lib/ai/ocr-worker.ts)
#
# Free tier (15 RPM):   CONCURRENCY=1  PACE_MS=4000  (default sem setar nada)
# Tier 1 paid (1000 RPM): CONCURRENCY=5  PACE_MS=0     ← recomendado para uso rotineiro
# Tier 2 ($250, 10K RPM): CONCURRENCY=10 PACE_MS=0
#
# Upgrade tier: gastar $5 organicamente na conta Google AI → vira Tier 1 automaticamente.
#
# OCR_WORKER_CONCURRENCY=5
# OCR_WORKER_PACE_MS=0
# OCR_WORKER_MAX_PER_RUN=30
# OCR_WORKER_RATE_COOLDOWN_MS=65000
# OCR_STALE_MS=90000

# Fallback cascade opcional (quando ambos Gemini Flash + Flash-Lite falham):
# OCR_CLAUDE_FALLBACK_ENABLED=true
# OCR_FALLBACK_CLAUDE_MODEL=claude-haiku-4-5-20251001

# Legacy: modelo para classifyDocument/extractDocumentData (tool do agent do chat, nao o form)
OCR_MODEL=claude-haiku-4-5-20251001

# Voyage AI — embeddings for the knowledge base (RAG).
# Get your key at https://dash.voyageai.com
# Leave empty to disable semantic search; the agent falls back to keyword search.
VOYAGE_API_KEY=
# voyage-law-2 is specialized for legal text in PT-BR (1024 dim, best quality).
VOYAGE_EMBED_MODEL=voyage-law-2

# Storage (optional - S3, defaults to local .storage/)
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OCR (optional - requires AWS Textract + S3)
OCR_ENABLED=false

# Certidoes via Infosimples — extracao automatizada de certidoes juridicas
# (CND Federal, CNDT, TRF Civel, CEAT, protestos, CND IPTU, TJ estadual).
# Obter token em https://infosimples.com — planos a partir de R$ 39/mes.
INFOSIMPLES_TOKEN=
# Budget mensal total em centavos de R$ (default 5000 = R$ 50,00).
# Quando o gasto acumulado do mes atingir esse valor, novas extracoes sao bloqueadas.
INFOSIMPLES_MONTHLY_BUDGET_CENTS=5000
# Segredo para o endpoint de cron /api/cron/certidoes/poll-portal (opcional).
# Se definido, o cron exige Authorization: Bearer <valor> no header.
CRON_SECRET=

# Certidoes via Serasa Experian — score, restritivos (negativacao) e vinculos PJ↔PF.
# Diferente da Infosimples (que emite certidoes de portais), a Serasa devolve JSON
# estruturado e o sistema gera um PDF proprio (Puppeteer) pra anexar no deal.
# Cadastro: https://developer.serasaexperian.com.br/apis
# API v1 sera descontinuada em 2026-07-01 — este cliente fala apenas v2 REST/JSON.
SERASA_CLIENT_ID=
SERASA_CLIENT_SECRET=
# URL base sem barra final, ex: https://api.serasaexperian.com.br
SERASA_BASE_URL=
# sandbox | production — controla URLs internas, fixtures e gate de smoke.
SERASA_ENV=sandbox
# Budget mensal Serasa em centavos de R$ (default 500000 = R$ 5.000). Isolado do
# orcamento Infosimples — uma cobranca cara de Serasa nao bloqueia Infosimples
# e vice-versa.
SERASA_MONTHLY_BUDGET_CENTS=500000

# Features
ALLOW_SELF_REGISTER=true

# ============================================================================
# Google Docs editor migration (Phase 0+) — substitui o TipTap por iframe Google Docs
# ============================================================================
#
# Setup manual obrigatório (por ambiente):
# 1. Criar projeto em https://console.cloud.google.com/
# 2. Habilitar "Google Docs API" e "Google Drive API"
# 3. Criar Service Account → JSON key → guardar como GOOGLE_SERVICE_ACCOUNT_JSON
# 4. Para iframe colaborativo: ou conta Google Workspace com Domain Wide
#    Delegation, OU compartilhar docs via "anyone with link" (menos seguro).
# 5. Criar uma pasta no Drive da service account → guardar id em GOOGLE_DRIVE_FOLDER_ID
#
# A chave de feature flag controla rollout gradual: false = continua TipTap,
# true = novos contratos viram Google Docs. Contratos antigos são lazy-migrados.
USE_GOOGLE_DOCS_EDITOR=false

# JSON de credenciais da service account (string com o JSON inteiro).
# Em Vercel, cole o conteúdo do arquivo .json. NÃO use \n literal.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Pasta raiz no Drive onde os contratos são salvos.
# A service account precisa ter permissão de editor nessa pasta.
GOOGLE_DRIVE_FOLDER_ID=

# Opcional: domínio Workspace para Domain Wide Delegation.
# Quando setado, o cliente impersona um usuário desse domínio em chamadas.
GOOGLE_WORKSPACE_DOMAIN=

# Opcional: email do usuário a impersonar (deve estar no domínio acima).
# Necessário se GOOGLE_WORKSPACE_DOMAIN estiver setado.
GOOGLE_IMPERSONATE_EMAIL=

# Token compartilhado para validar webhook do Drive (item 7).
# Gere com: openssl rand -hex 32
# Sem ele, o watch automático na criação do contrato é desabilitado e o
# webhook /api/webhooks/google-drive aceita qualquer requisição.
GOOGLE_WATCH_TOKEN=

# ============================================================================
# MÓDULO PAGADORIA (Asaas) — adicionado na Fase 1a (2026-04-20)
# ============================================================================

# Asaas — gateway de pagamento (Fase 1b onboarding)
# Master API key cria subcontas white label via POST /v3/accounts
# Sandbox v2: $aact_YT... | Sandbox v3 homologação: $aact_hmlg_... | Produção: $aact_prod...
#
# ⚠ IMPORTANTE: a key começa com $ que o Next.js/dotenv interpreta como expansão
# de variável. Você DEVE escapar o primeiro $ com barra invertida no .env real:
#   ASAAS_API_KEY=\$aact_hmlg_000MzkwODA2...
# Ver DEC-2026-005 + BUG-2026-001 no plano.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
ASAAS_MAX_TRANSFER_VALUE=100000
# Fase 3: walletId master para split com platform fee (deixar vazio em fase 1-2)
PLATFORM_WALLET_ID=

# Segurança — todos OBRIGATÓRIOS em produção
# Gerar com: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=
# Gerar com: openssl rand -hex 32
CHALLENGE_TOKEN_SECRET=
TRUSTED_DEVICE_SECRET=
SUDO_TOKEN_SECRET=
# Opcional — HMAC para tamper evidence em AuditLog.metadata
AUDIT_LOG_SIGNING_KEY=

# Email — OBRIGATÓRIO (acesso do dono do tenant, reset de senha, magic link,
# convites, OTP, dual approval, KYC notif, security alerts)
#
# EMAIL_PROVIDER=smtp  → nodemailer. É o caminho de produção. SMTP genérico serve
#   Brevo (smtp-relay.brevo.com), Mailjet, Postmark e Gmail — trocar de provedor é
#   só mudar estas variáveis. O remetente PRECISA ser de um domínio autenticado
#   (SPF+DKIM) no provedor, senão ele só entrega pro dono da conta.
# EMAIL_PROVIDER=resend → legado. Exige domínio verificado em resend.com/domains.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opcional: force TLS implícito (default: true só na porta 465)
SMTP_SECURE=
# Legado — só usado quando EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=imobpro.ai <contato@imobpro.ia.br>
# Respostas: o domínio não tem caixa de entrada, então aponte pra um e-mail real
EMAIL_REPLY_TO=

# Gate de e-mail do staging (só vale com STAGING_MODE=true).
# ATENÇÃO: com STAGING_MODE=true e STAGING_EMAIL_OVERRIDE VAZIO, todo envio é
# bloqueado silenciosamente (a função devolve ok:true). Se e-mail "some" no
# staging, é aqui.
STAGING_EMAIL_OVERRIDE=
# Domínio cujos destinatários passam direto, sem redirecionar pro override
STAGING_EMAIL_OVERRIDE_DOMAIN=

# Rate limiting (opcional — fallback in-memory se ausente)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================================
# CLICKSIGN — assinatura eletrônica de contratos (API v3, produção)
# ============================================================================
# MULTITENANT: cada org conecta a PRÓPRIA conta ClickSign em Configurações ›
# Assinaturas (token/webhook criptografados no banco — ClickSignAccount). As
# vars abaixo são o FALLBACK LEGADO, usado SÓ pela org compartilhada
# (SHARED_ORG_ID). Novos tenants não dependem delas.
#
# Token de acesso da conta de PRODUÇÃO (fallback legado). Gerar em
# https://app.clicksign.com → conta → API → Gerar token.
CLICKSIGN_API_TOKEN=
# Base URL de produção (default).
CLICKSIGN_API_BASE_URL=https://app.clicksign.com
# Secret HMAC do webhook GLOBAL legado (org compartilhada). Contas próprias têm
# secret per-org (auto-provisionado) e webhook em /api/webhooks/clicksign/[slug].
CLICKSIGN_WEBHOOK_SECRET=
# Budget mensal em centavos de R$ (fallback). Override per-org em
# OrgSignatureSettings.monthlyBudgetCents.
CLICKSIGN_MONTHLY_BUDGET_CENTS=10000
