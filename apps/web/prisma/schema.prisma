model ContractSuggestion {
  id                 String    @id @default(cuid())
  contractId         String
  userId             String?
  authorType         String // "user" | "ai"
  type               String // "insertion" | "deletion" | "replacement"
  suggestionId       String // unique anchor id that ties to the mark in the HTML
  originalText       String?   @db.Text
  newText            String?   @db.Text
  reason             String?   @db.Text
  status             String    @default("pending") // "pending" | "accepted" | "rejected"
  // Google Docs migration: id da suggestion espelhada no documento (formato kix.*).
  googleSuggestionId String?
  resolvedAt         DateTime?
  resolvedBy         String?
  createdAt          DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User?    @relation("suggestionAuthor", fields: [userId], references: [id])

  @@index([contractId, status])
}

