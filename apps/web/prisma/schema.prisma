generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH (NextAuth.js v5 Prisma Adapter)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  orgMemberships      OrgMembership[]
  deals               Deal[]
  contracts           Contract[]
  chatSessions        ChatSession[]
  documents           Document[]
  legacyTemplates     LegacyTemplate[]
  clausesAuthored     Clause[]             @relation("clauseAuthor")
  changeLogs          ContractChangeLog[]  @relation("userChangeLogs")
  contractComments    ContractComment[]    @relation("commentAuthor")
  contractSuggestions ContractSuggestion[] @relation("suggestionAuthor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// MULTI-TENANCY
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             OrgMembership[]
  pipelines           Pipeline[]
  forms               SalesForm[]
  templates           ContractTemplate[]
  clauses             Clause[]
  agentConfig         AgentConfig?
  knowledgeItems      KnowledgeItem[]
  contractMemories    ContractMemory[]
  clauseProposals     ClauseProposal[]
  templateSuggestions TemplateSuggestion[]
  documentStyles      DocumentStyle[]
}

model OrgMembership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   String @default("member")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

// ============================================
// SALES PIPELINE (Kanban)
// ============================================

model Pipeline {
  id        String   @id @default(cuid())
  orgId     String
  name      String   @default("Pipeline Principal")
  createdAt DateTime @default(now())

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]
}

model PipelineStage {
  id         String  @id @default(cuid())
  pipelineId String
  name       String
  color      String?
  position   Int

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, position])
}

model Deal {
  id         String   @id @default(cuid())
  pipelineId String
  stageId    String
  userId     String
  formId     String?  @unique
  title      String
  value      Float?
  dataJson   Json?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline    Pipeline         @relation(fields: [pipelineId], references: [id])
  stage       PipelineStage    @relation(fields: [stageId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  form        SalesForm?       @relation(fields: [formId], references: [id])
  contracts    Contract[]
  attachments  DealAttachment[]
  certidaoJobs CertidaoJob[]
}

model DealAttachment {
  id            String   @id @default(cuid())
  dealId        String
  filename      String
  mime          String
  url           String
  category      String?
  extractedData Json?
  source        String   @default("manual")
  createdAt     DateTime @default(now())

  deal         Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  certidaoJobs CertidaoJob[]
}

model CertidaoJob {
  id              String    @id @default(cuid())
  dealId          String
  batchId         String
  provider        String    @default("infosimples")
  endpoint        String
  label           String
  targetKind      String
  targetIndex     Int
  requestPayload  Json
  status          String    @default("pending")
  resultCode      Int?
  resultMessage   String?
  resultData      Json?
  attachmentId    String?
  errorMessage    String?
  latencyMs       Int?
  costCents       Int?
  startedAt       DateTime?
  finishedAt      DateTime?
  expectedReadyAt DateTime?
  retryCount      Int       @default(0)
  createdAt       DateTime  @default(now())

  deal       Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  attachment DealAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([dealId, batchId])
  @@index([status])
  @@index([status, expectedReadyAt])
}

// ============================================
// SALES FORMS (Shareable)
// ============================================

model SalesForm {
  id         String   @id @default(cuid())
  orgId      String
  token      String   @unique @default(cuid())
  title      String?
  schemaType String   @default("compra_venda_v1")
  dataJson   Json     @default("{}")
  status     String   @default("rascunho")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal        Deal?
  attachments FormAttachment[]
}

// ============================================
// CONTRACT TEMPLATES
// ============================================

model ContractTemplate {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  description      String?
  version          String   @default("1.0.0")
  schemaType       String   @default("compra_venda_v1")
  handlebarsSource String   @db.Text
  engine           String   @default("handlebars")
  status           String   @default("active")
  isDefault        Boolean  @default(false)
  modalidade       String?  @default("a_vista")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contracts   Contract[]
  suggestions TemplateSuggestion[]
}

// ============================================
// CLAUSE LIBRARY
// ============================================

model Clause {
  id          String   @id @default(cuid())
  orgId       String
  authorId    String?
  category    String
  subcategory String?
  title       String
  content     String   @db.Text
  description String?
  agentNotes  String?  @db.Text
  groupCode   String?
  isVariable  Boolean  @default(false)
  tags        String[]
  source      String   @default("manual")
  status      String   @default("approved")
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author          User?            @relation("clauseAuthor", fields: [authorId], references: [id])
  contractClauses ContractClause[]
}

// ============================================
// CONTRACTS + VERSIONING
// ============================================

model Contract {
  id               String   @id @default(cuid())
  dealId           String
  templateId       String
  userId           String
  version          Int      @default(1)
  dataJson         Json
  htmlContent      String?  @db.Text
  templateOverride String?  @db.Text
  status           String   @default("rascunho")
  isLatest         Boolean  @default(true)
  parentVersionId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deal          Deal                 @relation(fields: [dealId], references: [id])
  template      ContractTemplate     @relation(fields: [templateId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])
  parentVersion Contract?            @relation("ContractVersions", fields: [parentVersionId], references: [id])
  childVersions Contract[]           @relation("ContractVersions")
  chatSessions  ChatSession[]
  exports       Export[]
  clauses       ContractClause[]
  changeLogs    ContractChangeLog[]
  comments      ContractComment[]
  suggestions   ContractSuggestion[]
}

model ContractClause {
  id              String  @id @default(cuid())
  contractId      String
  clauseId        String
  position        Int
  isActive        Boolean @default(true)
  overrideContent String? @db.Text

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clause   Clause   @relation(fields: [clauseId], references: [id])

  @@unique([contractId, clauseId])
}

// ============================================
// AI CHAT
// ============================================

model ChatSession {
  id         String   @id @default(cuid())
  contractId String
  userId     String
  createdAt  DateTime @default(now())

  contract Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])
  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ============================================
// COMMENTS & SUGGESTIONS (TRACK CHANGES)
// ============================================

model ContractComment {
  id           String   @id @default(cuid())
  contractId   String
  userId       String?
  authorName   String
  authorType   String // "user" | "ai"
  text         String   @db.Text
  anchorId     String
  selectedText String   @db.Text
  severity     String   @default("info") // "info" | "warning" | "error"
  resolved     Boolean  @default(false)
  parentId     String?
  dedupeKey    String? // hash determinístico usado pela IA para evitar duplicatas em re-análises
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contract Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User?             @relation("commentAuthor", fields: [userId], references: [id])
  parent   ContractComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  ContractComment[] @relation("CommentReplies")

  @@unique([contractId, dedupeKey])
  @@index([contractId, resolved])
  @@index([contractId, authorType, resolved])
}

model ContractSuggestion {
  id           String    @id @default(cuid())
  contractId   String
  userId       String?
  authorType   String // "user" | "ai"
  type         String // "insertion" | "deletion" | "replacement"
  suggestionId String // unique anchor id that ties to the mark in the HTML
  originalText String?   @db.Text
  newText      String?   @db.Text
  reason       String?   @db.Text
  status       String    @default("pending") // "pending" | "accepted" | "rejected"
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User?    @relation("suggestionAuthor", fields: [userId], references: [id])

  @@index([contractId, status])
}

// ============================================
// EXPORTS
// ============================================

model Export {
  id         String   @id @default(cuid())
  contractId String
  format     String
  url        String
  fileSize   Int?
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// ============================================
// AGENT CONFIG
// ============================================

model AgentConfig {
  id           String   @id @default(cuid())
  orgId        String   @unique
  model        String   @default("claude-sonnet-4-20250514")
  ocrModel     String   @default("claude-haiku-4-5-20251001")
  temperature  Float    @default(0.3)
  maxTokens    Int      @default(4096)
  systemPrompt String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ============================================
// CONTRACT CHANGE LOG
// ============================================

model ContractChangeLog {
  id         String   @id @default(cuid())
  contractId String
  userId     String?
  action     String
  summary    String   @db.Text
  details    Json?
  source     String   @default("user")
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User?    @relation("userChangeLogs", fields: [userId], references: [id])
}

// ============================================
// FORM ATTACHMENTS
// ============================================

model FormAttachment {
  id            String   @id @default(cuid())
  formId        String
  filename      String
  mime          String
  url           String
  category      String?
  extractedData Json?
  createdAt     DateTime @default(now())

  form SalesForm @relation(fields: [formId], references: [id], onDelete: Cascade)
}

// ============================================
// LEGACY (preserved for migration)
// ============================================

model Document {
  id            String   @id @default(uuid())
  userId        String
  filename      String
  mime          String
  s3Url         String
  extractedHtml String?  @db.Text
  extractedText String?  @db.Text
  ocrText       String?  @db.Text
  status        String   @default("uploaded")
  createdAt     DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id])
  legacyTemplate LegacyTemplate?
}

model LegacyTemplate {
  id                 String   @id @default(uuid())
  userId             String
  version            String
  sourceDocId        String   @unique
  handlebarsTemplate String   @db.Text
  analysisJson       Json
  status             String   @default("draft")
  createdAt          DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  document Document @relation(fields: [sourceDocId], references: [id])
}

// ============================================
// KNOWLEDGE BASE (RAG)
// ============================================

model KnowledgeItem {
  id         String   @id @default(cuid())
  orgId      String
  category   String // "legislation" | "model" | "rule" | "glossary"
  title      String
  content    String   @db.Text
  chunkIndex Int      @default(0)
  chunkTotal Int      @default(1)
  parentId   String?
  tags       String[]
  source     String? // URL, doc id, "manual", "seed"
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // embedding vector(1024) - added via raw migration, not visible to Prisma

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent KnowledgeItem?  @relation("KnowledgeChunks", fields: [parentId], references: [id], onDelete: Cascade)
  chunks KnowledgeItem[] @relation("KnowledgeChunks")

  @@index([orgId, category])
  @@index([orgId, parentId])
}

// ============================================
// LEARNING: CONTRACT MEMORY + PROPOSALS (Propose mode)
// ============================================

model ContractMemory {
  id                  String   @id @default(cuid())
  orgId               String
  contractId          String? // null if the contract was deleted
  templateId          String?
  dataFingerprint     Json // reduced snapshot: modality, civil status, value range, etc.
  summary             String   @db.Text
  acceptedSuggestions Json // ids + texts of AI suggestions that were accepted
  rejectedSuggestions Json // ids of rejected suggestions (learn what NOT to suggest)
  manualEdits         Json // text added manually that didn't come from the clause library
  createdAt           DateTime @default(now())
  // embedding vector(1024) - added via raw migration

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, templateId])
}

model ClauseProposal {
  id         String    @id @default(cuid())
  orgId      String
  authorType String // "ai" | "user"
  userId     String?
  title      String
  content    String    @db.Text
  groupCode  String? // G1-G6 or null
  category   String? // partes, objeto, compromisso, preco, posse, titulo, comissao, etc.
  reason     String    @db.Text
  evidence   Json? // contractIds that motivated it
  tags       String[]
  status     String    @default("pending") // "pending" | "approved" | "rejected"
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

model TemplateSuggestion {
  id         String    @id @default(cuid())
  templateId String
  orgId      String
  authorType String // "ai" | "user"
  userId     String?
  title      String
  reason     String    @db.Text
  diffHunks  Json // [{ before, after, contextBefore, contextAfter }]
  evidence   Json? // contractIds that motivated the suggestion
  status     String    @default("pending") // "pending" | "approved" | "rejected"
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  template ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([templateId, status])
  @@index([orgId, status])
}

// ============================================
// DOCUMENT STYLE (design system per organization)
// ============================================

model DocumentStyle {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  isDefault      Boolean  @default(false)
  fontFamily     String   @default("Times New Roman")
  fontSizeBase   Int      @default(12) // pt
  lineHeight     Float    @default(1.5)
  marginTopMm    Int      @default(25)
  marginBottomMm Int      @default(25)
  marginLeftMm   Int      @default(25)
  marginRightMm  Int      @default(25)
  colorPrimary   String   @default("#000000")
  colorAccent    String   @default("#C97B0A")
  headerHtml     String?  @db.Text
  footerHtml     String?  @db.Text
  pageNumbers    Boolean  @default(true)
  includeToc     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}
