generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH (NextAuth.js v5 Prisma Adapter)
// ============================================

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                String    @default("user")
  // Newton — telefone E.164 para mapeamento WhatsApp → user. Único, opcional.
  phone               String?   @unique
  // Perfil PII (opcional, usado pra pré-popular OnboardingWizard Asaas)
  cpf                 String?   @unique
  birthDate           DateTime? @db.Date
  incomeValueCents    Int?
  postalCode          String?
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  // LGPD — soft delete com janela de reversal de 30 dias
  deletedAt           DateTime?
  deletionScheduledAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  orgMemberships      OrgMembership[]
  invitationsCreated  OrgInvitation[]      @relation("invitationCreator")
  invitationsApproved OrgInvitation[]      @relation("invitationApprover")
  deals               Deal[]
  managedDeals        Deal[]               @relation("DealManager")
  contracts           Contract[]
  chatSessions        ChatSession[]
  documents           Document[]
  legacyTemplates     LegacyTemplate[]
  clausesAuthored     Clause[]             @relation("clauseAuthor")
  changeLogs          ContractChangeLog[]  @relation("userChangeLogs")
  contractComments    ContractComment[]    @relation("commentAuthor")
  contractSuggestions ContractSuggestion[] @relation("suggestionAuthor")
  aiUsage             AIUsage[]
  certidaoJobs        CertidaoJob[]        @relation("certidaoJobUser")

  // Pagadoria — Fase 1a (segurança)
  twoFactorSecret     TwoFactorSecret?
  operationChallenges OperationChallenge[]
  sessionElevations   SessionElevation[]
  trustedDevices      TrustedDevice[]
  auditLogs           AuditLog[]
  dualApprovalsInit   DualApproval[]       @relation("DualApprovalInit")
  dualApprovalsAck    DualApproval[]       @relation("DualApprovalAck")

  // Pagadoria — Fase 3 (transferências)
  asaasTransfers         AsaasTransfer[]
  reconciliationMatches  BankReconciliation[]
  commissionChargeDrafts CommissionChargeDraft[]
  proposals              Proposal[]
  proposalsResponsible   Proposal[]               @relation("ProposalResponsible")

  // Pagadoria — Multi-account (capabilities granulares por conta bancária)
  accountPermissions      AsaasAccountPermission[] @relation("AccountPermissionUser")
  accountPermissionsGiven AsaasAccountPermission[] @relation("AccountPermissionGranter")

  // Newton — API tokens e idempotência
  apiTokens       UserApiToken[]
  idempotencyKeys IdempotencyKey[]

  // Newton — ActionIntent (dual-approval HITL)
  intentsRequested ActionIntent[] @relation("IntentRequester")
  intentsApproved  ActionIntent[] @relation("IntentApprover")

  // Newton — Leads ownership
  leads Lead[]

  // Locação — Clientes/prospects cadastrados por este usuário ("quem cadastrou")
  leaseClientsCreated         LeaseClient[]
  leaseClientInsurerAnalyses  LeaseClientInsurerAnalysis[]

  // Newton — pedidos de cobrança de informação criados pela negociadora
  newtonRequests NewtonRequest[]

  // Notificações do sistema em canal externo (WhatsApp via Newton)
  notificationPrefs      UserNotificationPreference[]
  notificationDeliveries UserNotificationDelivery[]

  // Multitenant Fase 0a — identidade de plataforma (super-admin)
  platformRole PlatformRole?
}

// ============================================================
// Multitenant Fase 0a — Plataforma (super-admin + config global)
// ============================================================

// Identidade cross-tenant separada de OrgMembership. Quem tem PlatformRole
// é staff da plataforma (Olavo + ops), NÃO membro de uma org específica.
// Verificação centralizada em lib/security/rbac/platform.ts::requirePlatformRole.
model PlatformRole {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "super_admin" | "support" | "billing"
  scope     String[] @default([]) // ex: ["impersonate", "configure_taxes", "audit_query"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// Singleton (1 linha, garantida por singletonKey @unique). Taxas/markup globais
// que o super-admin administra. Mudanças versionadas em PlatformConfigHistory.
// asaasParentAccountId fica nullable até a Fase 1d ligar a conta-mãe.
model PlatformConfig {
  id                        String   @id @default(cuid())
  singletonKey              String   @unique @default("singleton")
  asaasParentAccountId      String?
  defaultPlatformFeePercent Decimal  @default(0) @db.Decimal(5, 2)
  defaultBoletoFeeCents     Int      @default(0)
  defaultPixFeeCents        Int      @default(0)
  defaultCardFeePercent     Decimal  @default(0) @db.Decimal(5, 2)
  defaultPayLinkExpiryDays  Int      @default(30)
  updatedBy                 String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model PlatformConfigHistory {
  id             String   @id @default(cuid())
  configSnapshot Json
  changedBy      String?
  changeReason   String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// White-label por tenant (Fase 1a). Cores em hex; o render injeta como CSS vars
// HSL no `[data-tenant]` (ver globals.css + lib/tenant/branding.ts). poweredBy
// controla o selo "Powered by imobpro.ai" no rodapé de páginas públicas.
// FONTE CANÔNICA da marca da imobiliária (1:1 com a org). Alimenta o dashboard
// (--primary/--brand-accent), a sidebar (logo), a página pública /pay e o header
// dos e-mails — tudo via lib/tenant/branding.ts::getOrgBrand, que deriva
// displayName/supportEmail quando o dono não preencheu.
// Os campos OrgFinancialSettings.brand* (por conta Asaas) foram DEPRECADOS em
// favor destes: branding é da imobiliária, não da conta de recebimento.
model BrandingSettings {
  id             String       @id @default(cuid())
  orgId          String       @unique
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String? // hex, ex: #115E59
  secondaryColor String? // hex (mapeado pra --brand-accent)
  emailHeader    String?      @db.Text
  emailFooter    String?      @db.Text
  poweredBy      Boolean      @default(true)
  // Identidade que o cliente final vê (migrados de OrgFinancialSettings.brand*)
  displayName    String?
  supportEmail   String?
  supportPhone   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// MULTI-TENANCY
// ============================================

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  // Dados cadastrais da imobiliária — ADMINISTRADORA nomeada nos contratos de
  // locação (cláusula de pagamento). Só entra no contrato quando `creci` está
  // preenchido; sem ele o template usa o fallback genérico.
  legalName            String?
  cnpj                 String?
  creci                String?
  legalAddress         String?
  // Dados fiscais do declarante — usados na DIMOB (registro R01). `legalName`,
  // `cnpj` e `legalAddress` acima também alimentam o R01. Editáveis em
  // /settings/fiscal. Aditivos, default null.
  fiscalResponsibleCpf String? // CPF do responsável perante a RFB (R01)
  fiscalUf             String? // UF do contribuinte (R01)
  fiscalMunicipioCode  String? // Código do município RFB/IBGE (R01)
  fiscalMunicipioName  String? // Nome do município (exibição)
  // Selo de validação do leiaute DIMOB: guarda a DIMOB_LAYOUT_VERSION que o
  // usuário confirmou ter importado sem erro no PGD. Só vale enquanto casar
  // com a versão atual do layout.ts (senão o banner "provisório" volta).
  dimobLayoutValidatedVersion String?
  // White-label (Fase 1a): subdomínio `{subdomain}.imobpro.ia.br` e domínio
  // custom futuro. Resolução por host no middleware → x-org-subdomain.
  subdomain            String?  @unique
  customDomain         String?  @unique
  // Conta Asaas selecionada pelo admin como destino default de novas cobranças
  // e fonte das telas financeiras quando o user não passa hint explícito.
  activeAsaasAccountId String?
  // Budget mensal de IA da org em USD (soma de AIUsage.estimatedCostUsd do
  // mês). Null = sem teto. Mora AQUI (não em OrgFinancialSettings, que é
  // per-conta Asaas @@unique[accountId]) porque o teto é ORG-level. ≥100% →
  // chat 402; 80%/100% → sino. Ver lib/ai/budget.ts.
  aiMonthlyBudgetUsd   Decimal? @db.Decimal(10, 2)
  // Suspensão administrativa (painel super-admin): quando setado, a org está
  // suspensa — o guard do dashboard bloqueia acesso e os módulos são desligados
  // em massa. Reativar limpa o campo e religa os módulos. Aditivo, default null.
  suspendedAt          DateTime?
  // Onboarding self-service: setado quando o dono conclui/pula o tour ou gera o
  // 1º contrato. Só serve pra parar o auto-launch do wizard — o progresso em si
  // é derivado dos dados (lib/onboarding/status.ts). Aditivo, default null.
  onboardingCompletedAt DateTime?
  // Onboarding: dono já viu o modal de boas-vindas (1º acesso). Enquanto null e
  // o onboarding está incompleto, a home "/" leva o owner pro /onboarding uma vez.
  onboardingIntroSeenAt DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  brandingSettings    BrandingSettings?
  members             OrgMembership[]
  invitations         OrgInvitation[]
  pipelines           Pipeline[]
  forms               SalesForm[]
  formSettings        OrgFormSettings?
  participantCategories FormParticipantCategory[]
  garantiaOptions     GarantiaOption[]
  notificationSettings OrgNotificationSettings?
  managerSettings     OrgManagerSettings?
  dealNotificationLogs DealNotificationLog[]
  userNotificationPrefs      UserNotificationPreference[]
  userNotificationDeliveries UserNotificationDelivery[]
  templates           ContractTemplate[]
  clauses             Clause[]
  agentConfig         AgentConfig?
  agentProfiles       AgentProfile[]
  agentProvisionings  AgentProvisioning[]
  knowledgeItems      KnowledgeItem[]
  knowledgeItemUsage  KnowledgeItemUsage[]
  contractMemories    ContractMemory[]
  clauseProposals     ClauseProposal[]
  templateSuggestions TemplateSuggestion[]
  documentStyles      DocumentStyle[]
  aiUsage             AIUsage[]
  adhocCertidaoJobs   CertidaoJob[]        @relation("certidaoJobOrg")

  // Pagadoria — Fase 1a (segurança)
  customRoles    CustomRole[]
  auditLogs      AuditLog[]
  trustedDevices TrustedDevice[]
  dualApprovals  DualApproval[]

  // Pagadoria — Fase 1b (Asaas + KYC + cobrança)
  asaasAccounts      AsaasAccount[]
  activeAsaasAccount AsaasAccount?          @relation("OrgActiveAsaasAccount", fields: [activeAsaasAccountId], references: [id], onDelete: SetNull)
  asaasCustomers     AsaasCustomer[]
  commissionCharges  CommissionCharge[]
  asaasWebhookEvents AsaasWebhookEvent[]
  financialSettings  OrgFinancialSettings[]

  // Pagadoria — Fase 3 (transferências + conciliação)
  asaasTransfers      AsaasTransfer[]
  bankReconciliations BankReconciliation[]

  // Pagadoria — Fase 5 (split multi-recipient)
  splitRecipients        SplitRecipient[]
  commissionChargeDrafts CommissionChargeDraft[]

  // Clicksign — assinatura eletrônica
  envelopes Envelope[]

  // Newton — ActionIntent (dual-approval HITL)
  actionIntents ActionIntent[]

  // Newton — Lead (pré-Deal: acumula docs/contexto antes de virar negócio formal)
  leads Lead[]

  // Newton — pedidos de cobrança de informação por negócio
  newtonRequests NewtonRequest[]

  // DIMOB — histórico de arquivos gerados (auditoria + reemissão)
  dimobExports    DimobExport[]
  dimobOverrides  DimobOverride[]
  dimobExclusions DimobExclusion[]

  // Newton — vínculo deal ↔ grupo WhatsApp
  dealGroupLinks DealGroupLink[]

  // Newton — registro de grupos WhatsApp observados (p/ auto-link + candidatos)
  whatsappGroups WhatsappGroup[]

  // Pesquisas de satisfação (NPS/CSAT) — templates imutáveis por lote
  surveyTemplates   SurveyTemplate[]
  surveyAutomations SurveyAutomation[]
  surveyInvites     SurveyInvite[]
  surveyResponses   SurveyResponse[]

  // Locação — módulo de administração de aluguéis (docs/locacao/spec.md)
  propertyOwners     PropertyOwner[]
  tenants            Tenant[]
  properties         Property[]
  leaseContracts     LeaseContract[]
  rentCharges        RentCharge[]
  guarantees         Guarantee[]
  inspections        Inspection[]
  creditAnalyses     CreditAnalysis[]
  // Superlógica-parity (§4.4-§4.5)
  propertyOwnerships PropertyOwnership[]
  leaseTenants       LeaseTenant[]
  leaseAngariadores  LeaseAngariador[]
  expenses           Expense[]
  checklistTemplates ChecklistTemplate[]
  checklists         Checklist[]
  debtAgreements     DebtAgreement[]
  insurancePolicies  InsurancePolicy[]
  maintenances       Maintenance[]
  leaseReadjustments LeaseReadjustment[]
  leaseClients       LeaseClient[]
  leaseClientInsurerAnalyses LeaseClientInsurerAnalysis[]

  // Modularização — entitlements de módulos (Vendas/Locação) por tenant
  orgModules OrgModule[]

  // Google Drive da imobiliária (templates/contratos criados na conta do tenant)
  googleAccount OrgGoogleAccount?

  // Assinatura — cadastro de testemunhas padrão do sistema (auto-preenchem o
  // envelope ClickSign quando marcadas como padrão).
  defaultWitnesses DefaultWitness[]

  // ClickSign multitenant — conta própria da imobiliária (token/webhook
  // criptografados) + preferências de assinatura (tipos, orçamento, padrões).
  // Sem conta conectada, só a org compartilhada legada cai no token global.
  clicksignAccount  ClickSignAccount?
  signatureSettings OrgSignatureSettings?
  proposals         Proposal[]

  // iList/RexAPI (Gryphtech RE/MAX) — conexão região+offices por tenant e
  // espelho local de listings (a RexAPI não tem busca textual nem webhooks).
  ilistConnection IListConnection?
  ilistListings   IListListing[]

  sequences OrgSequence[]
}

/// Contador sequencial por (org, escopo) — hoje só o código da proposta
/// (`scope = "proposal:<ano>"`), mas genérico de propósito.
///
/// Por que uma tabela e não `MAX(code) + 1`: dois creates simultâneos leem o
/// mesmo máximo e geram o mesmo código (o @@unique de Proposal transformaria
/// isso num 500 aleatório). O incremento roda como statement ÚNICO
/// (`INSERT ... ON CONFLICT DO UPDATE ... RETURNING`), que o Postgres serializa
/// na row — ver `lib/proposals/code.ts`.
///
/// Por que não uma SEQUENCE do Postgres: sequence é global, e aqui o contador é
/// por (org, ano) — precisaria de DDL dinâmico a cada tenant/virada de ano.
model OrgSequence {
  orgId     String
  scope     String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, scope])
}

/// Conta Google conectada pela imobiliária (OAuth offline). Os Docs de template
/// e os contratos gerados passam a ser criados no Drive do TENANT (quota e
/// privacidade isoladas); a service account global continua recebendo writer
/// em cada doc pra operar batchUpdate/export/watch. Sem row (ou status !=
/// connected) o fluxo cai no owner OAuth global — tenants legados não quebram.
/// Refresh token criptografado com AES-256-GCM (lib/security/crypto.ts), mesmo
/// padrão da AsaasAccount.
model OrgGoogleAccount {
  id                    String    @id @default(cuid())
  orgId                 String    @unique
  email                 String
  refreshTokenEncrypted String    @db.Text
  refreshTokenIvBase64  String
  refreshTokenTagBase64 String
  scopes                String[]  @default([])
  status                String    @default("connected") // connected | revoked | error
  lastErrorMessage      String?   @db.Text
  // Pasta "Contractmaker" criada lazy no Drive da org; docs novos nascem nela.
  driveFolderId         String?
  connectedById         String?
  lastUsedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Entitlement de módulo por tenant. `module` é validado contra lib/modules/catalog.ts
/// (isValidModule) em runtime — nunca FK. Defaults das sub-funções moram no catálogo
/// (código), não aqui: `featureFlags` guarda apenas OVERRIDES; chave ausente => default
/// do catálogo (ver lib/modules/read.ts). Evita Json default drift.
model OrgModule {
  id           String   @id @default(cuid())
  orgId        String
  module       String // "vendas" | "locacao"
  enabled      Boolean  @default(true)
  featureFlags Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, module])
  @@index([orgId])
}

/// Sessão de impersonação de tenant por staff de plataforma (super_admin).
/// Standalone (sem FK) — auditoria de "super-admin agiu como org X". Portado do
/// painel /admin/orgs (feat/mt-1e-admin-orgs).
model TenantImpersonationSession {
  id          String    @id @default(cuid())
  adminUserId String
  orgId       String
  reason      String
  startedAt   DateTime  @default(now())
  endsAt      DateTime
  endedAt     DateTime?

  @@index([adminUserId, endedAt])
  @@index([orgId, startedAt])
}

model OrgMembership {
  id                String    @id @default(cuid())
  userId            String
  orgId             String
  role              String    @default("member") // owner | admin | finance | sales | viewer | custom
  customRoleId      String?
  scopeRestrictions Json?
  invitedAt         DateTime  @default(now())
  invitedBy         String?
  lastActiveAt      DateTime?
  /// Membership de usuário de serviço (agente externo), não de gente. Existe
  /// para que a tela de membros possa recusar a remoção: o Bearer do agente
  /// resolve a org pela membership do dono do token, então removê-la derruba o
  /// agente daquele tenant — em silêncio, porque nada mais falha até a próxima
  /// chamada.
  isSystem          Boolean   @default(false)

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customRole CustomRole?  @relation(fields: [customRoleId], references: [id])

  @@unique([userId, orgId])
  @@index([orgId, role])
}

// Invitation queue: owner cria, approver aprova, sistema cria User+Membership
// e dispara magic link de signin. Sem aprovação, nenhum User existe.
//
// status: "pending" | "approved" | "rejected" | "revoked" | "expired"
//
// Unicidade de pending por (orgId, email) é validada em código (Prisma não
// suporta partial unique indexes nativamente).
model OrgInvitation {
  id              String    @id @default(cuid())
  orgId           String
  email           String
  name            String?
  role            String    @default("member") // role a aplicar na approval
  status          String    @default("pending")
  invitedById     String
  approvedById    String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy  User         @relation("invitationCreator", fields: [invitedById], references: [id])
  approvedBy User?        @relation("invitationApprover", fields: [approvedById], references: [id])

  @@index([orgId, status])
  @@index([email])
  @@index([status, createdAt])
}

// ============================================
// SALES PIPELINE (Kanban)
// ============================================

model Pipeline {
  id        String   @id @default(cuid())
  orgId     String
  name      String   @default("Pipeline Principal")
  // Locação (aditivo): "venda" (default, retrocompat) | "locacao". Separa o
  // workspace recorrente do transacional — pipeline de locação tem stages
  // próprios (Esteira pré-contrato). Ver docs/locacao/spec.md §4.2.
  kind      String   @default("venda")
  createdAt DateTime @default(now())

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]
}

model PipelineStage {
  id         String  @id @default(cuid())
  pipelineId String
  name       String
  color      String?
  position   Int

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, position])
}

model Deal {
  id               String    @id @default(cuid())
  pipelineId       String
  stageId          String
  userId           String
  formId           String?   @unique
  title            String
  value            Float?
  dataJson         Json?
  // Locação (aditivo): "venda" (default) | "locacao". Discrimina a natureza
  // do negócio sem quebrar deals existentes. Ver docs/locacao/spec.md §4.2.
  kind             String    @default("venda")
  // Canal de entrada (funil por origem) — capturado na criação. Nullable:
  // deals pré-migration ficam null. Valores em lib/pipeline/source-channel.ts.
  sourceChannel    String?
  // Nome do cliente denormalizado (comprador/locatário titular) — evita
  // carregar form.dataJson inteiro no kanban só pra derivar o nome. Escrito
  // por deriveDealMetadata nos pontos que atualizam o deal; backfill na
  // migration deal_client_name. Null = form sem titular ainda.
  clientName       String?
  position         Int       @default(0)
  // SLA pós-assinatura — datas terminais do funil.
  // commissionPaidAt: setado pelo botão "Marcar comissão paga" no DealDetail.
  // contractSignedAt / chargeIssuedAt: overrides MANUAIS preenchidos quando o
  // card é arrastado pro stage e a etapa NÃO foi feita no sistema (sem envelope
  // ClickSign fechado / sem CommissionCharge). Quando feito no sistema, a data
  // vem derivada de Envelope.closedAt / CommissionCharge.createdAt e estas
  // colunas ficam nulas. A timeline usa "fonte automática ?? coluna manual".
  // lostAt + lostReason: terminal alternativo via mark-lost (qualquer stage).
  commissionPaidAt DateTime?
  contractSignedAt DateTime?
  chargeIssuedAt   DateTime?
  lostAt           DateTime?
  lostReason       String?
  // Aging por stage: quando o deal ENTROU no stage atual. Atualizado em todo
  // ponto que muda stageId (drag, auto-promotes, mark-lost/reopen, geração).
  // Null em deals pré-migração sem backfill exato — UI cai pra createdAt.
  stageEnteredAt   DateTime? @default(now())
  // SLA materializado (2026-08, plano F3): instantes ABSOLUTOS em que o deal
  // entra em "atenção" (warn) e "atrasado" (due), escritos por moveDealStage a
  // partir da política CONGELADA na entrada do stage. Query-áveis (filtro do
  // kanban e cron sla-check sem date-math por linha). Null = stage terminal ou
  // deal pré-backfill.
  slaWarnAt        DateTime?
  slaDueAt         DateTime?
  // Serasa (2026-05) — registro de consentimento LGPD por deal pra consultas
  // restritas (score, restritivos, vínculos). Shape: { serasaConsent: { at,
  // by, baseLegal } }. Sem o campo populado, POST /certidoes retorna 412
  // quando o batch inclui endpoints Serasa. Json em vez de model dedicado
  // pra evitar over-engineering — se virar 5+ tipos de consentimento, migrar.
  complianceJson   Json?
  // Arquivamento explícito (2026-06-30): tira o deal do kanban sem perdê-lo
  // nem apagar documentos. Paridade com os models de locação que já têm
  // archivedAt. Independente de stage terminal — o operador arquiva quando
  // quer "tirar da frente" (perdido/pago ou qualquer outro). null = ativo.
  archivedAt       DateTime?
  // Notificações do processo (2026-07) — override por deal do padrão da org.
  // Mesmo shape de OrgNotificationSettings.settingsJson (só as chaves
  // divergentes; ausente = herda). Ver lib/notifications/deal-events-config.ts.
  notificationsJson Json?
  // Gerente (2026-07) — usuário da plataforma responsável pelo negócio,
  // reatribuível (espelha Proposal.responsibleUserId; `userId` acima é o
  // criador, imutável). Escopo do role `gerente`: só enxerga deals onde este
  // campo = ele (dealScopeWhere em lib/security/rbac/check.ts). Null = sem
  // gerente (deals legados; permitido quando OrgManagerSettings.managerRequired
  // está off).
  managerUserId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  pipeline               Pipeline                @relation(fields: [pipelineId], references: [id])
  stage                  PipelineStage           @relation(fields: [stageId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])
  manager                User?                   @relation("DealManager", fields: [managerUserId], references: [id])
  form                   SalesForm?              @relation(fields: [formId], references: [id])
  contracts              Contract[]
  attachments            DealAttachment[]
  certidaoJobs           CertidaoJob[]
  certidoesShareLinks    CertidoesShareLink[]
  diligentedPersons      DiligentedPerson[]
  commissionCharges      CommissionCharge[]
  commissionChargeDrafts CommissionChargeDraft[]
  envelopes              Envelope[]
  newtonRequests         NewtonRequest[]
  notificationLogs       DealNotificationLog[]
  surveyInvites          SurveyInvite[]
  groupLink              DealGroupLink?
  // Proposta que originou este deal (conversão). Null = deal criado direto.
  fromProposal           Proposal?               @relation("ProposalConvertedDeal")

  // Lead que originou (se veio de conversão Lead -> Deal)
  fromLead Lead?

  stageHistory DealStageHistory[]

  @@index([pipelineId, archivedAt])
  @@index([managerUserId])
  // Filtro de SLA do kanban ("atrasados primeiro") e varredura do cron.
  @@index([pipelineId, slaDueAt])
}

// ============================================================================
// Histórico de permanência por stage (plano 2026-08-06, Fase 3). Toda mudança
// de stage passa por lib/pipeline/move-stage.ts, que fecha o intervalo aberto
// e abre o próximo — o AuditLog continua existindo, mas relatório/SLA leem
// DAQUI (metadata de audit é blob não-queryável e o formato variou ao longo
// do tempo: nome vs id).
//
// INVARIANTE: no máximo UM intervalo aberto (exitedAt IS NULL) por deal.
// O índice ÚNICO PARCIAL que garante isso vive em SQL puro na migration
// (`DealStageHistory_open_interval_key`) — Prisma não modela índice parcial;
// scripts/check-migrations.ts assere a existência via pg_indexes.
// ============================================================================
model DealStageHistory {
  id            String    @id @default(cuid())
  orgId         String
  dealId        String
  // "venda" | "locacao" — denormalizado do pipeline pro agregado não fazer join.
  kind          String
  stageId       String
  // SNAPSHOTS: stages são renomeáveis/reordenáveis; o relatório histórico
  // precisa do nome/posição DA ÉPOCA.
  stageName     String
  stagePosition Int
  fromStageId   String?
  enteredAt     DateTime  @default(now())
  // null = intervalo ABERTO (stage atual do deal).
  exitedAt      DateTime?
  durationSec   Int?
  // Política de SLA CONGELADA na entrada (mudar a política depois não
  // reclassifica o passado). Null = stage terminal (não envelhece).
  slaWarnDays   Int?
  slaDangerDays Int?
  // Por que o deal entrou aqui: drag | mark_lost | reopen | auto_signed |
  // auto_commission_paid | charge_created | charge_cancelled_regress |
  // contract_approved | contract_generation | aprovar_ficha | archive |
  // manual_update | mark_signed | mark_commission_paid | convert |
  // backfill | backfill_gap (estimados).
  reason        String
  actorUserId   String?
  // true = intervalo reconstruído por backfill (datas aproximadas). Relatórios
  // excluem por default.
  estimated     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, enteredAt])
  @@index([orgId, kind, stageId, exitedAt])
  @@index([orgId, kind, enteredAt])
}

// Política de SLA configurável por org (tela /settings/sla). Relacional de
// propósito (não blob JSON): o cron e os relatórios filtram por (orgId, scope,
// key). `key` = stageId (scope=deal_stage) ou status TEXT (scope=
// proposal_status) — SEM FK: status de proposta não é tabela e stage apagado
// não pode derrubar a política em cascata. Ausência de linha = defaults de
// código (AGING_WARN_DAYS/AGING_DANGER_DAYS); "Restaurar padrão" = DELETE.
model SlaPolicy {
  id         String   @id @default(cuid())
  orgId      String
  scope      String // "deal_stage" | "proposal_status"
  key        String
  kind       String // "venda" | "locacao"
  warnDays   Int
  dangerDays Int
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, scope, key])
  @@index([orgId, kind])
}

// Lead — pré-Deal. Newton acumula docs/notes/conversa antes de virar negocio
// formal. Quando matura, vira Deal+SalesForm via convert-to-deal endpoint.
//
// Owned por Newton: criação, update, e conversão são tipicamente disparadas
// por briefing da negociadora via WhatsApp.
//
// Lookup principal = phones (multi-phone: comprador + vendedor + interlocutor).
// Newton chama lookup_lead_by_phone antes de responder qualquer msg WhatsApp
// pra evitar contextos cruzados.
model Lead {
  id              String   @id @default(cuid())
  orgId           String
  userId          String // dono (negociadora ou Newton actor)
  title           String // "Yamamoto - Vila Mariana", "Sandra apto Pinheiros", etc
  status          String   @default("open") // open | qualified | converted | lost | archived
  phones          String[] @default([]) // E.164 das partes envolvidas (procurar por elemento)
  notes           String   @default("") // texto livre — Newton appenda timeline de eventos
  metadata        Json? // parties, imovel, valor estimado, source, etc — schema flexível
  convertedDealId String?  @unique
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org           Organization     @relation(fields: [orgId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  convertedDeal Deal?            @relation(fields: [convertedDealId], references: [id])
  attachments   LeadAttachment[]

  @@index([orgId, status])
  @@index([orgId, lastActivityAt])
  @@index([phones], type: Gin)
}

model LeadAttachment {
  id          String   @id @default(cuid())
  leadId      String
  filename    String
  mime        String
  url         String
  category    String? // "matricula" | "rg" | "cpf" | "comprovante_endereco" | etc
  contentHash String? // SHA-256 — pra dedupe
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([contentHash])
}

model DealAttachment {
  id            String   @id @default(cuid())
  dealId        String
  filename      String
  mime          String
  url           String
  category      String?
  extractedData Json?
  // ATENÇÃO: existe um UNIQUE parcial fora do schema (Prisma não representa
  // índice parcial): DealAttachment_dealId_form_summary_key em (dealId)
  // WHERE source='form_summary' (migration 20260818213000). Quem inserir com
  // source='form_summary' DEVE tratar o conflito. Writers hoje:
  // persistFormSummaryPdf (form-summary-mailer.ts — catch P2002 adota o
  // vencedor) e o restore de anexo (attachments/restore/route.ts — degrada
  // pra source='manual' quando a vaga está ocupada). `prisma migrate dev`
  // pode propor DROP deste índice por drift — revisar o SQL de toda migration.
  source        String   @default("manual")
  // Tamanho do arquivo em bytes — preenchido no upload daqui pra frente (forward
  // only). Anexos antigos ficam null. Alimenta as métricas de storage por tenant.
  byteSize      Int?
  // SHA-256 do conteúdo — dedupe por conteúdo (não só por URL exata). Paridade
  // com LeadAttachment. Forward-only: anexos antigos ficam null (dedupe cai pra
  // url). Sem @@unique dura — a dedupe é no código (evita 500 em corrida/legado).
  contentHash   String?
  // Setado quando a linha nasceu de uma restauração: aponta pro
  // `DeletedAttachment.id` de origem. Sem FK — o arquivo é imutável e não pode
  // cascatear nada. Serve pra UI não oferecer "restaurar" de novo pra algo que
  // já voltou (o registro do arquivo é mantido como histórico).
  restoredFromId String?
  createdAt     DateTime @default(now())

  deal         Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  certidaoJobs CertidaoJob[]
  envelopes    Envelope[]

  @@index([dealId])
  @@index([dealId, category])
  @@index([contentHash])
  @@index([restoredFromId])
}

/// Arquivo PERMANENTE de anexos excluídos (deal e formulário).
///
/// Por que existe: `DELETE /api/forms/[token]/attachments` era anônimo e não
/// escrevia audit nenhum — não havia como responder "esse documento foi
/// excluído por quem, quando?". A linha aqui é a fonte da verdade do rastro
/// (escrita na MESMA transação do delete), e `audit()` é só o índice
/// pesquisável, porque ele engole exceção por design.
///
/// Nada expurga esta tabela: por decisão de produto o sistema não apaga nada
/// automaticamente. Não há `purgeAfter` nem cron de retenção, e o blob no
/// storage também nunca é removido — é o que torna a restauração real.
///
/// Sem FK para Deal/SalesForm DE PROPÓSITO: `Deal → DealAttachment` é
/// `onDelete: Cascade`, então uma FK aqui levaria o arquivo junto ao apagar o
/// deal — exatamente o registro que precisa sobreviver. `dealId`/`formId` são
/// colunas soltas, e a restauração recusa quando o pai não existe mais.
model DeletedAttachment {
  id              String   @id @default(cuid())
  orgId           String
  /// "deal" | "form" | "proposal" — de qual tabela a linha veio.
  origin          String
  /// Id da linha original. Não é único: reexcluir um anexo restaurado gera
  /// uma segunda entrada, e as duas importam para a história.
  originalId      String
  dealId          String?
  formId          String?
  proposalId      String?
  filename        String
  url             String
  category        String?
  /// Linha original inteira, para recriar no restore sem depender de o schema
  /// atual ter as mesmas colunas de quando foi excluída.
  payload         Json
  /// Null quando a exclusão veio de rota pública/anônima (era o caso do
  /// formulário antes do gate de membro).
  deletedByUserId String?
  /// "ui_deal" | "ui_form" | "ui_proposal" | "deal_delete" | "certidao"
  deletedVia      String
  ipAddress       String?
  deletedAt       DateTime @default(now())

  @@index([orgId, deletedAt])
  @@index([dealId])
  @@index([formId])
  @@index([proposalId])
  @@index([url])
}

model CertidaoJob {
  id                String    @id @default(cuid())
  // Phase C — dealId nullable para suportar consultas ad-hoc (diligência
  // de CPF/CNPJ não arrolado em Deal). Ad-hoc jobs têm orgId obrigatório.
  dealId          String?
  orgId           String?
  userId          String?
  batchId         String
  provider        String    @default("infosimples")
  endpoint        String
  label           String
  targetKind      String
  targetIndex     Int
  // 2026-06-11 — âncora ESTÁVEL pro alvo "diligenciado". targetIndex é posicional
  // (ordem de createdAt) e desliza quando uma pessoa do meio é removida, fazendo o
  // guard de exclusão e o supersede de re-emissão mirarem a pessoa errada. Pra
  // diligenciado, jobs passam a se ligar à pessoa por id. Null pra partes do
  // contrato (vendedor/comprador/imóvel) e pra alvos ad-hoc (sem row no banco).
  diligentedPersonId String?
  // Locação — job escopado a um LeaseClient (prospect) em vez de um Deal. Mutuamente
  // exclusivo com dealId: crédito/certidões de cliente rodam pré-deal (dealId null).
  leaseClientId   String?
  requestPayload  Json
  status          String    @default("pending")
  resultCode      Int?
  resultMessage   String?
  resultData      Json?
  attachmentId    String?
  errorMessage    String?
  latencyMs       Int?
  costCents       Int?
  startedAt       DateTime?
  finishedAt      DateTime?
  expectedReadyAt DateTime?
  retryCount      Int       @default(0)
  // J.2 (Phase J, 2026-04-18) — retry automático inteligente por categoria.
  // nextRetryAt setado pelo classifyOutcome() com backoff específico
  // (api_error 30s/2min/10min, portal_unavailable 10min/30min/2h, etc).
  // Cron /api/cron/certidoes/poll-portal sweeps jobs com nextRetryAt < now.
  nextRetryAt       DateTime?
  maxRetries        Int       @default(3)
  // missingFields popula quando status=data_missing para UX direcionar o
  // usuário ao campo específico que precisa preencher.
  // @default([]) é obrigatório — sem ele, Prisma migrate deploy derruba o
  // DEFAULT no Postgres e quebra inserts (que omitem a coluna).
  missingFields     String[]  @default([])
  // Copia do portalUrl do endpoint no instante do job — cached para UI
  // renderizar CTA "Abrir portal oficial" sem re-consultar catálogo.
  portalUrl         String?
  // Marca quando o problema (falha terminal) já entrou no e-mail resumo diário
  // (cron problem-digest). Evita reavisar a mesma falha. Null = ainda não
  // incluído no digest.
  problemNotifiedAt DateTime?
  createdAt         DateTime  @default(now())

  deal             Deal?                 @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization     Organization?         @relation("certidaoJobOrg", fields: [orgId], references: [id], onDelete: Cascade)
  user             User?                 @relation("certidaoJobUser", fields: [userId], references: [id], onDelete: SetNull)
  attachment       DealAttachment?       @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  diligentedPerson DiligentedPerson?     @relation(fields: [diligentedPersonId], references: [id], onDelete: SetNull)
  leaseClient      LeaseClient?          @relation(fields: [leaseClientId], references: [id], onDelete: SetNull)
  auditLogs        CertidaoJobAuditLog[]

  @@index([dealId, batchId])
  @@index([orgId, batchId])
  @@index([status])
  @@index([status, expectedReadyAt])
  @@index([userId, createdAt])
  @@index([dealId, diligentedPersonId])
  @@index([leaseClientId, batchId])
}

// Phase F.II-β — audit log de transições de status do CertidaoJob. Cada
// update relevante (pending → fetching → success/failed/awaiting_portal)
// registra uma row aqui para debug e observabilidade. Retention policy:
// deletar rows > 90 dias via cron futuro.
model CertidaoJobAuditLog {
  id         String   @id @default(cuid())
  jobId      String
  fromStatus String?
  toStatus   String
  reason     String? // texto livre: "initial dispatch", "retry by user", "cron sweep", etc.
  metadata   Json? // payload livre: costCents, latencyMs, endpoint, resultCode
  createdAt  DateTime @default(now())

  job CertidaoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model CertidoesShareLink {
  id        String    @id @default(cuid())
  dealId    String
  token     String    @unique @default(cuid())
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  viewCount Int       @default(0)

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([dealId, revokedAt])
}

// F3 — Pessoas diligenciadas (externas ao contrato, tipicamente socios de PJ)
// Stored separately from vendedores/compradores so they don't pollute the
// contract data but can still have certidões extracted.
model DiligentedPerson {
  id             String   @id @default(cuid())
  dealId         String
  tipoPessoa     String // "fisica" | "juridica"
  nome           String
  cpf            String?
  cnpj           String?
  dataNascimento String?
  rg             String? // PF — exigido pelo TJSP pedido-certidao
  nomeMae        String? // PF — destrava antecedentes criminais
  sexo           String? // PF — "masculino" | "feminino" (normalizado p/ M/F no planner)
  uf             String?
  cidade         String?
  relacao        String? // "socio" | "avalista" | "procurador" | "outro"
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())

  deal         Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  certidaoJobs CertidaoJob[]

  @@index([dealId])
}

// F4 — In-app notifications. Minimal viable: bell icon + unread badge + list.
// Emitted by pollPortalJob / sweepStaleJobs / runBatch when certidão batches
// transition to terminal state. Aggregated by batchId to avoid spam.
model Notification {
  id        String    @id @default(cuid())
  orgId     String
  userId    String?
  type      String // "certidao_batch_complete" | "certidao_ready" | "certidao_failed"
  title     String
  body      String
  linkUrl   String?
  metadata  Json? // { dealId, jobId, batchId }
  // I.5 (Phase I, 2026-04-18) — batchId dedicado para dedupe atômico.
  // Query em metadata JSONB era frágil e race condition gerava 5× a mesma
  // notif no QA. Unique (type, batchId) garante dedupe no DB level.
  batchId   String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([type, batchId])
  @@index([orgId, read, createdAt])
  @@index([userId, read, createdAt])
  // Sweep do canal WhatsApp pro usuário (lib/notifications/user-channels.ts):
  // varre por `type IN (allowlist) AND createdAt >= now()-30min`. Os índices
  // acima começam por orgId/userId e não servem pra essa varredura global.
  @@index([type, createdAt])
}

// Notificações do processo (2026-07) — padrão da org. Um único blob JSON com
// defaults resolvidos em código (mesmo padrão de OrgFormSettings.
// contractDefaultsJson): matriz evento × público × canal + config do lembrete
// de preenchimento. Shape em lib/notifications/deal-events-config.ts.
model OrgNotificationSettings {
  id           String   @id @default(cuid())
  orgId        String   @unique
  settingsJson Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Gerente (2026-07) — config da org pro role `gerente`: obrigatoriedade da
// atribuição na criação de negócio (toggle único vendas+locação) e o conjunto
// de permissões concedido a TODOS os gerentes da org (overrides booleanos
// sobre ROLE_PRESETS.gerente; só chaves de MANAGER_CONFIGURABLE_PERMISSIONS).
// Row ausente = defaults (required=false, sem overrides) — resolvido em
// lib/security/rbac/check.ts::getEffectivePermissions.
model OrgManagerSettings {
  id              String   @id @default(cuid())
  orgId           String   @unique
  managerRequired Boolean  @default(false)
  permissionsJson Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Log de envios EXTERNOS (email/whatsapp) das notificações do processo por
// deal. O unique é o chokepoint de idempotência: o motor faz insert-first e
// P2002 = já enviado (pula). Sino (Notification) NÃO entra aqui — já tem
// dedupe próprio por (type, batchId). A aba Notificações do deal lê este log.
model DealNotificationLog {
  id             String   @id @default(cuid())
  orgId          String
  dealId         String
  event          String // DealNotifEvent (stage_change | form_completed | ...)
  channel        String // email | whatsapp
  audience       String   @default("broker") // broker | party (v2) | manager (v3)
  // splitRecipientId (broker) | "party:<email|telefone>" | "manager:<userId>".
  // O prefixo é obrigatório nos dois últimos: a unique abaixo NÃO inclui
  // audience, então chave crua colidiria entre públicos.
  recipientKey   String
  recipientLabel String?
  dedupeKey      String // por evento: stageId+dia, contractId, envelopeId, chargeId, formId+marco
  status         String   @default("sent") // pending (claim) | sent | skipped | failed
  detail         Json?
  // Desfecho de ENTREGA reportado pelo Max (POST /api/webhooks/max). Coluna
  // PRÓPRIA, não uma chave em `detail`: os settles substituem `detail`
  // inteiro a cada tentativa e apagariam a marca (achado de code review).
  // Só o webhook escreve aqui. Shape: {status, at, providerMessageId, receivedAt}.
  maxDeliveryJson Json?
  createdAt      DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, event, channel, recipientKey, dedupeKey], map: "DealNotificationLog_dedupe_key")
  @@index([orgId, dealId, createdAt])
}

// Preferências de canal externo do USUÁRIO da plataforma, por org — o mesmo
// User pode ser membro de N orgs e consentir em uma só (User.phone é @unique
// GLOBAL). Default de código = WhatsApp OFF; a org só pode DESLIGAR (kill
// switch em OrgNotificationSettings.settingsJson.userChannels), nunca ligar
// pelo usuário: o número é PII pessoal dele, não cadastro comercial — o
// oposto do SplitRecipient, onde a org liga e o corretor desliga.
// Shape do settingsJson em lib/notifications/user-channels-shared.ts.
model UserNotificationPreference {
  id     String @id @default(cuid())
  userId String
  orgId  String
  // { events?: { [UserNotifCategory]: { whatsapp?: boolean } } }
  settingsJson    Json      @default("{}")
  // Consentimento explícito (LGPD). Null = nunca houve opt-in → nenhum envio,
  // mesmo que um toggle apareça ligado por bug ou migração futura.
  whatsappOptInAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

// Chokepoint de idempotência dos envios externos de notificação de SISTEMA a
// usuários da plataforma. Espelha DealNotificationLog, mas SEM âncora em Deal
// — a maioria das notificações não tem deal (ai_budget_threshold,
// support_answered). O dedupeKey canônico é `n:${notificationId}`, que cobre
// o caso de Notification.batchId null. Claim-first "pending" → settle.
model UserNotificationDelivery {
  id             String  @id @default(cuid())
  orgId          String
  userId         String
  notificationId String?
  type           String // Notification.type
  category       String // UserNotifCategory
  channel        String  @default("whatsapp")
  dedupeKey      String
  // TERMINAIS: sent | skipped (opt-out, gate off — não adianta insistir)
  // RE-TENTÁVEIS: deferred (fora da janela / rate cap) | failed |
  //   pending órfão (a function morreu entre o claim e o envio)
  // O unique abaixo diz "já PROCESSEI esta notificação pra este usuário",
  // não "já ENVIEI" — por isso o sweep reivindica de volta o que ficou em
  // estado re-tentável, senão qualquer adiamento viraria perda definitiva.
  status         String    @default("pending")
  detail         Json?
  // Ver DealNotificationLog.maxDeliveryJson — mesma coluna, mesmo motivo.
  maxDeliveryJson Json?
  createdAt      DateTime  @default(now())
  settledAt      DateTime?
  attempts       Int       @default(0)
  // Marca cada reivindicação (não cada transição): é o que permite detectar
  // "pending" órfão sem confundir com claim recém-feito.
  lastAttemptAt  DateTime?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, dedupeKey], map: "UserNotificationDelivery_dedupe_key")
  @@index([orgId, createdAt])
  @@index([notificationId])
  // Rate cap por usuário/hora: count de status='sent' na última hora.
  @@index([userId, status, createdAt])
  // Repesca do sweep: status re-tentável ordenado por tentativa.
  @@index([status, lastAttemptAt])
}

// NewtonRequest — fila de "pedidos ao Newton" ancorada num Deal.
//
// A negociadora (que pode NÃO estar em nenhum grupo de WhatsApp) registra, de
// dentro do negócio, uma informação que falta e para quem cobrar. Newton recebe
// o gatilho, vai até o grupo/contato, pede o dado, agenda lembretes (crons) e
// fecha o pedido quando a info chega — reportando de volta via Notification +
// timeline + DM.
//
// Por que model dedicado (e não Notification/ContractComment): precisa de
// lifecycle de status, alvo (contato/grupo) e vínculo com crons de lembrete —
// nada disso cabe num alerta one-shot ou comentário ancorado em documento.
model NewtonRequest {
  id             String    @id @default(cuid())
  orgId          String
  dealId         String
  createdBy      String // userId da negociadora que abriu o pedido
  ask            String    @db.Text // o que falta obter ("matrícula atualizada do imóvel")
  // Dedupe ATÔMICO pra criadores programáticos (pesquisas: [survey_invite][id],
  // [survey_reminder][id][n]). Null nos pedidos manuais/da UI — Postgres permite
  // múltiplos NULLs em unique. Criar com try/catch P2002 em vez de find+create.
  dedupeTag      String?   @unique
  targetType     String // "contact" | "group"
  targetRef      String? // phone E.164 sem '+' (contact) | groupJid (group). Null em group ainda não resolvido.
  targetLabel    String? // rótulo humano: "vendedor Yamamoto", "grupo do negócio"
  status         String    @default("open") // open | chasing | awaiting_reply | fulfilled | cancelled
  priority       String    @default("normal") // normal | high
  dueAt          DateTime?
  cronJobIds     String[]  @default([]) // ids dos crons de lembrete que Newton criou (pra cancelar depois)
  lastNudgeAt    DateTime? // última cobrança disparada
  resolutionNote String?   @db.Text // resumo do que chegou, escrito por Newton no fechamento
  // Timeline append-only: [{ at, actor: "negociadora"|"newton"|"contato", type, note }]
  eventsJson     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [createdBy], references: [id])

  @@index([orgId, status, createdAt])
  @@index([dealId, status])
}

// DealGroupLink — vínculo persistido entre um Deal e o grupo de WhatsApp do
// negócio (regra "um grupo = um deal"). O groupId (JID Z-API, ex.
// "120363019502650977-group") é conhecimento do runtime do Newton; ele grava
// aqui na 1ª vez que associa (após confirmação humana). Indexado nos dois
// sentidos: deal→grupo (cobrar no grupo certo) e grupo→deal (detectar que a
// info pedida chegou quando alguém responde no grupo).
model DealGroupLink {
  id          String   @id @default(cuid())
  orgId       String
  dealId      String   @unique
  groupId     String // JID do grupo WhatsApp
  groupLabel  String? // nome humano do grupo, p/ UI
  confirmedBy String? // userId/ator que confirmou o vínculo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([orgId, groupId])
}

// WhatsappGroup / WhatsappGroupMember — registro dos grupos de WhatsApp que o
// Newton observa, sincronizado a partir do sidecar (membros = remetentes
// observados, não roster completo). Serve para (a) auto-derivar o DealGroupLink
// cruzando os telefones das partes do deal com os membros do grupo, e (b)
// mostrar grupos candidatos na UI quando o match for ambíguo.
//
// PII: telefones já conhecidos da org; escopo por orgId. Ver
// docs/newton-lgpd-compliance-2026-05-18.md.
model WhatsappGroup {
  id             String   @id @default(cuid())
  orgId          String
  groupId        String // JID Z-API (ex "120363...-group")
  name           String? // nome humano do grupo, p/ UI
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org     Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members WhatsappGroupMember[]

  @@unique([orgId, groupId])
}

model WhatsappGroupMember {
  id         String   @id @default(cuid())
  groupRowId String // FK p/ WhatsappGroup.id
  phone      String // E.164 normalizado (dígitos, com 55)
  lastSeenAt DateTime @default(now())

  group WhatsappGroup @relation(fields: [groupRowId], references: [id], onDelete: Cascade)

  @@unique([groupRowId, phone])
  @@index([phone])
}

// ============================================
// SALES FORMS (Shareable)
// ============================================

model SalesForm {
  id          String    @id @default(cuid())
  orgId       String
  token       String    @unique @default(cuid())
  title       String?
  schemaType  String    @default("compra_venda_v1")
  dataJson    Json      @default("{}")
  status      String    @default("rascunho")
  // Setado quando status transiciona pra "completo"|"vinculado". Marco SLA
  // do funil — diferente de updatedAt (qualquer auto-save bumpa updatedAt).
  // Setado UMA vez: re-finalizar depois de reabrir NÃO sobrescreve, senão o
  // kanban/timeline passariam a mostrar a data da correção em vez da do envio.
  completedAt DateTime?
  // Reabertura do formulário enviado (POST .../lock { reopen: true }).
  // `completedAt != null && reopenedAt == null` = form fechado: o link público
  // para de servir dados a quem não é da org (lib/forms/form-gate.ts). Reabrir
  // seta esta data (sem tocar completedAt) pra devolver o acesso ao cliente;
  // o finalize seguinte volta a null e fecha o gate.
  reopenedAt  DateTime?
  // Travamento (lock) do formulário público: quando setado, os endpoints de
  // escrita (PATCH do token principal, PATCH do subtoken, uploads de anexo)
  // retornam 403 e as páginas públicas renderizam somente-leitura. Congela as
  // informações num marco (manual pelo corretor ou auto no finalize se
  // Organization.autoLockFormOnFinalize). Destravar = voltar a null.
  lockedAt    DateTime?
  lockedById  String?
  // Última vez que o resumo consolidado foi enviado por e-mail. Protege a
  // automação contra re-disparo em re-finalize (form é reabrível).
  summarySentAt DateTime?
  // Consentimento LGPD (art. 7º): registrado no FINALIZE (o ato de submeter).
  // Antes o aceite era só estado de UI e nunca persistia — sem evidência do
  // consentimento nem da versão da política aceita. ipHash = sha256(ip+secret),
  // nunca o IP cru.
  privacyAcceptedAt    DateTime?
  privacyIpHash        String?
  privacyPolicyVersion String?
  // Snapshot do preset de obrigatoriedade vigente na org quando este
  // formulário NASCEU (só LOCAÇÃO grava — venda resolve ao vivo). Garante que
  // trocar a configuração da imobiliária não muda as exigências de um link já
  // entregue ao cliente. NULL = formulário anterior à feature → comportamento
  // antigo (nada obrigatório além do piso do wizard). Ver lib/forms/presets.ts
  // (locacaoSettingsForForm).
  requiredPreset       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org          Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal         Deal?
  attachments  FormAttachment[]
  participants SalesFormParticipant[]
}

// Subtoken por parte (vendedor/comprador) pro mesmo SalesForm.
// O admin gera links isolados pra cada parte preencher só seus dados —
// vendedor não vê dados do comprador e vice-versa. Token é JWT-HMAC com
// AUTH_SECRET, expira em 7d. Server enforça allowlist de paths via
// `deepMergeAtPaths` no PATCH e filtra dataJson na leitura.
//
// `partyIndex` permite múltiplos vendedores/compradores no futuro (v1
// suporta apenas 1+1 por form, mas a coluna já existe pra evitar
// migração quebrando linha).
model SalesFormParticipant {
  id           String    @id @default(cuid())
  formId       String
  role         String // "vendedor" | "comprador"
  partyIndex   Int       @default(0)
  token        String    @unique
  tokenExp     DateTime
  completedAt  DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())

  form        SalesForm        @relation(fields: [formId], references: [id], onDelete: Cascade)
  attachments FormAttachment[]

  @@index([formId, role])
}

// ============================================
// CONTRACT TEMPLATES
// ============================================

model ContractTemplate {
  id                  String    @id @default(cuid())
  orgId               String
  name                String
  description         String?
  version             String    @default("1.0.0")
  schemaType          String    @default("compra_venda_v1")
  handlebarsSource    String    @db.Text
  engine              String    @default("handlebars") // "handlebars" | "google_docs"
  status              String    @default("active")
  isDefault           Boolean   @default(false)
  modalidade          String?   @default("a_vista")
  // Categoria determinística (forma de pagamento → template, sem heurística).
  // Grupo "sem alienação fiduciária": compra_e_venda | permuta | outros
  // Grupo "com alienação fiduciária": financiamento | fgts | consorcio
  // `modalidade` é derivada do grupo (a_vista | financiamento) p/ retrocompat.
  category            String?
  // Critério de seleção pelas ESCOLHAS DO FORM (locação/proposta), lido junto
  // com a modalidade: { garantia?, fiadorPessoa?: "pf"|"pj", pessoa?: "pf"|"pj" }.
  // Null/vazio = template GENÉRICO da modalidade (comportamento pré-critério).
  // Campo que contradiz o fato do form desclassifica o template.
  // Venda não usa (a discriminação de venda é `category`); ADM também não.
  matchCriteria       Json?
  // Google Docs migration: quando engine="google_docs", aponta para o doc-modelo
  // armazenado no Drive da service account. Os contratos são criados via
  // files.copy seguido de batchUpdate(replaceAllText).
  googleTemplateDocId String?
  // Preview cache: hash do handlebarsSource usado pra gerar o GDoc apontado
  // por googleTemplateDocId como preview. Zerado quando handlebarsSource muda
  // (vira "desatualizado" na UI até o próximo POST /preview re-gerar).
  previewSourceHash   String?
  previewUpdatedAt    DateTime?
  // SHA-256 (hex) do arquivo ORIGINAL enviado na ingestão DOCX→template.
  // Identidade do modelo pra dedup no upload em lote: subir o mesmo .docx de
  // novo devolve 409 DUPLICATE_TEMPLATE em vez de criar outro draft.
  // Não confundir com `previewSourceHash` (hash do handlebarsSource do preview).
  sourceHash          String?
  // Relatório do pass de IA na ingestão DOCX→template (engine google_docs):
  // { inserted, skippedAmbiguous, notMapped, missingRequired, ranAt }.
  // Persiste após a ativação como histórico da revisão.
  draftReport         Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contracts   Contract[]
  suggestions TemplateSuggestion[]
  proposals   Proposal[]

  @@index([orgId, sourceHash])
}

// ============================================
// CLAUSE LIBRARY
// ============================================

// Legado — Clause foi unificada em KnowledgeItem (category="clause") na
// migration 20260518120000_unify_clause_to_knowledge_item. Esta tabela
// agora é "Clause_legacy" no Postgres via @@map, mantida como janela de
// rollback (30d). Não use em código novo — escreva contra KnowledgeItem.
// PR follow-up dropa o model + tabela.
model Clause {
  id          String   @id @default(cuid())
  orgId       String
  authorId    String?
  category    String
  subcategory String?
  title       String
  content     String   @db.Text
  description String?
  agentNotes  String?  @db.Text
  groupCode   String?
  isVariable  Boolean  @default(false)
  tags        String[] @default([])
  source      String   @default("manual")
  status      String   @default("approved")
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author User?        @relation("clauseAuthor", fields: [authorId], references: [id])

  @@map("Clause_legacy")
}

// ============================================
// CONTRACTS + VERSIONING
// ============================================

model Contract {
  id                  String    @id @default(cuid())
  dealId              String
  // templateId é opcional: contratos importados (upload externo) não têm
  // template Handlebars associado. Quando NULL, o conteúdo vive 100% no
  // Google Doc (`googleDocId` obrigatório nesse caso) e o export usa
  // `drive.files.export`. Quando preenchido, o contrato foi gerado a partir
  // de um ContractTemplate via `generateContractForDeal`.
  templateId          String?
  userId              String
  version             Int       @default(1)
  dataJson            Json
  htmlContent         String?   @db.Text
  templateOverride    String?   @db.Text
  status              String    @default("rascunho")
  isLatest            Boolean   @default(true)
  parentVersionId     String?
  // kind discrimina natureza do instrumento:
  //   "contract"      → CCV/locação original (default — retrocompat com rows existentes)
  //   "addendum"      → aditamento contratual (parentVersionId aponta pro CCV)
  //   "distrato"      → reservado pra fluxo futuro
  //   "administracao" → contrato de administração de locação (imobiliária↔proprietário)
  // Aditamento herda dataJson + templateId + DocumentStyle do parent.
  // Invariante: no máx 1 isLatest=true por (dealId, kind) — índice único parcial
  // `Contract_dealId_kind_isLatest_unique` (migration 20260706100000).
  kind                String    @default("contract")
  // Google Docs migration (Phase 0+): when set, the contract content lives in
  // a Google Doc owned by the Contractmaker service account; htmlContent stays
  // as a snapshot for legacy export/diff fallback.
  googleDocId         String?
  googleDocUrl        String?
  googleDocStatus     String? // "draft" | "approved_readonly" | "archived"
  // Drive watch metadata para webhook de mudança (Item 7).
  googleWatchChannel  String?
  googleWatchResource String?
  googleWatchExpires  DateTime?
  // Carimbo da última análise passiva COMPLETA: `${tier}:${sha1}` onde
  // tier = deep (open/Sonnet) | light (edit/Haiku) e o sha1 cobre texto
  // vivo + dataJson. Detector de mudança REAL (o ChangeLog não vê edição no
  // iframe Drive): edit skipa com qualquer tier; open só skipa se deep.
  // Null = nunca analisado.
  lastAnalyzedTextHash String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  deal              Deal                 @relation(fields: [dealId], references: [id])
  template          ContractTemplate?    @relation(fields: [templateId], references: [id])
  user              User                 @relation(fields: [userId], references: [id])
  parentVersion     Contract?            @relation("ContractVersions", fields: [parentVersionId], references: [id])
  childVersions     Contract[]           @relation("ContractVersions")
  chatSessions      ChatSession[]
  exports           Export[]
  clauses           ContractClause[]
  changeLogs        ContractChangeLog[]
  comments          ContractComment[]
  suggestions       ContractSuggestion[]
  commissionCharges CommissionCharge[]
  envelopes         Envelope[]

  @@index([dealId, kind, isLatest])
}

model ContractClause {
  id              String  @id @default(cuid())
  contractId      String
  knowledgeItemId String
  position        Int
  isActive        Boolean @default(true)
  overrideContent String? @db.Text

  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id])

  @@unique([contractId, knowledgeItemId])
}

// ============================================
// AI CHAT
// ============================================

model ChatSession {
  id         String   @id @default(cuid())
  contractId String
  userId     String
  /// Título da session. Auto-derivado da 1ª mensagem do usuário (primeiros
  /// 60 chars) ou rename manual via PATCH. Null em sessions recém-criadas.
  title      String?
  /// Soft delete — sessions arquivadas somem da sidebar mas mantêm mensagens.
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  /// Atualizado a cada mensagem nova (toque manual em agent.ts). Usado pra
  /// ordenar a sidebar "Recentes".
  updatedAt  DateTime @default(now()) @updatedAt

  contract    Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])
  messages    ChatMessage[]
  attachments ChatAttachment[]
  plans       ChatPlan[]

  @@index([contractId, archived, updatedAt(sort: Desc)])
}

/// Plano proposto pelo agente em modo Plan-and-approve. Cada plano tem
/// N steps (PlanStep TS shape em lib/ai/types.ts). Reads sao auto-executados;
/// writes esperam aprovacao do usuario via UI antes do execute-plan endpoint
/// rodar eles.
model ChatPlan {
  id        String   @id @default(cuid())
  sessionId String
  /// Mensagem assistant que carregou esse plan (1:1) — quando UI rehidrata
  /// historico, encontra o plan pela messageId pra renderizar PlanCard.
  messageId String   @unique
  /// JSON shape: PlanStep[] (id, type, tool, input, description, status, result?).
  stepsJson Json
  /// proposed → reads ja foram executados, writes pendentes
  /// executing → /execute-plan esta rodando writes
  /// completed → tudo terminou (sucesso ou falha em algum step)
  /// cancelled → user marcou cancel ou nao aprovou nada
  status    String   @default("proposed")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ChatAttachment {
  id            String   @id @default(cuid())
  sessionId     String
  /// Nome amigável (filename original ou hostname pra URLs).
  name          String
  /// "upload" = PDF/DOCX enviado pelo usuário; "url" = link extraído.
  source        String
  /// URL do Vercel Blob pra source=upload. Null pra source=url.
  blobUrl       String?
  /// URL original pra source=url. Null pra source=upload.
  sourceUrl     String?
  /// Texto extraído via OCR (PDF) ou Readability (URL). Pode ser null
  /// enquanto a extração ainda está em curso.
  extractedText String?  @db.Text
  byteSize      Int?
  createdAt     DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String   @db.Text
  metadata  Json?
  /// Eventos do streamContractAgent (tool_use, tool_result, verification, ...)
  /// pra rehidratar o chip timeline ao recarregar o chat. Nullable — turns
  /// pré-streaming não têm e UI esconde a seção.
  events    Json?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ============================================
// COMMENTS & SUGGESTIONS (TRACK CHANGES)
// ============================================

model ContractComment {
  id              String   @id @default(cuid())
  contractId      String
  userId          String?
  authorName      String
  authorType      String // "user" | "ai"
  text            String   @db.Text
  anchorId        String
  selectedText    String   @db.Text
  severity        String   @default("info") // "info" | "warning" | "error"
  resolved        Boolean  @default(false)
  parentId        String?
  dedupeKey       String? // hash determinístico usado pela IA para evitar duplicatas em re-análises
  // Google Docs migration: id do comment espelhado no Drive Comments API.
  googleCommentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contract Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User?             @relation("commentAuthor", fields: [userId], references: [id])
  parent   ContractComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  ContractComment[] @relation("CommentReplies")

  @@unique([contractId, dedupeKey])
  @@index([contractId, resolved])
  @@index([contractId, authorType, resolved])
}

model ContractSuggestion {
  id                 String    @id @default(cuid())
  contractId         String
  userId             String?
  authorType         String // "user" | "ai"
  type               String // "insertion" | "deletion" | "replacement"
  suggestionId       String // unique anchor id that ties to the mark in the HTML
  originalText       String?   @db.Text
  newText            String?   @db.Text
  reason             String?   @db.Text
  status             String    @default("pending") // "pending" | "accepted" | "rejected"
  // Google Docs migration: id da suggestion espelhada no documento (formato kix.*).
  googleSuggestionId String?
  resolvedAt         DateTime?
  resolvedBy         String?
  createdAt          DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User?    @relation("suggestionAuthor", fields: [userId], references: [id])

  @@index([contractId, status])
}

// ============================================
// EXPORTS
// ============================================

model Export {
  id         String   @id @default(cuid())
  contractId String
  format     String
  url        String
  fileSize   Int?
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// ============================================
// AGENT CONFIG
// ============================================

model AgentConfig {
  id           String   @id @default(cuid())
  orgId        String   @unique
  model        String   @default("claude-sonnet-4-20250514")
  ocrModel     String   @default("claude-haiku-4-5-20251001")
  temperature  Float    @default(0.3)
  maxTokens    Int      @default(4096)
  systemPrompt String   @db.Text
  // F3.7 — toggle por contexto e config global de AI Insights.
  // Shape: { enabled: bool, contexts: { dashboard: bool, contract: bool, property: bool, cashflow: bool } }
  aiInsightsConfig Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ============================================
// SUPPORT AI (assistente de suporte ao usuário)
// ============================================

// Config singleton do assistente de suporte (prompt + modelo), editável pelo
// super-admin em /admin/support-ai. systemPrompt vazio → usa o default em código
// (lib/support/config.ts::SUPPORT_DEFAULT_SYSTEM_PROMPT). Diferente de AgentConfig,
// que é por-org e serve o editor de contrato — este é único de plataforma.
// Defaults de PLATAFORMA pros especialistas do orquestrador multi-agente
// (Analyst/Legal/Editor/Curator). Singleton editável pelo super_admin em
// /admin/agent-defaults. Campo null/vazio = fallback pro prompt/modelo
// hardcoded (lib/ai/specialists/prompts*.ts). Um override de prompt vale
// pras DUAS esteiras (venda e locação) — substitui a variante inteira.
model PlatformAgentDefaults {
  id            String   @id @default(cuid())
  singletonKey  String   @unique @default("singleton")
  analystPrompt String?  @db.Text
  legalPrompt   String?  @db.Text
  editorPrompt  String?  @db.Text
  curatorPrompt String?  @db.Text
  analystModel  String?
  legalModel    String?
  editorModel   String?
  curatorModel  String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SupportAgentConfig {
  id                   String   @id @default(cuid())
  singletonKey         String   @unique @default("singleton")
  model                String   @default("claude-haiku-4-5-20251001")
  temperature          Float    @default(0.3)
  maxTokens            Int      @default(1024)
  systemPrompt         String   @default("") @db.Text
  // Abaixo desse cosseno de similaridade, nenhum hit da KB é confiável → o agente
  // é forçado ao handoff (guardrail determinístico além da decisão do LLM).
  handoffMinSimilarity Float    @default(0.55)
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Perfil de UM agente, num escopo. Unifica as três configurações que antes não
// se falavam — AgentConfig (por org), PlatformAgentDefaults (singleton dos 4
// especialistas) e SupportAgentConfig (singleton do suporte) — e cobre o buraco
// que nenhuma delas cobria: override por org E por agente.
//
// `orgId = NULL` é o DEFAULT DA PLATAFORMA; uma linha com orgId é o override
// daquele tenant. Resolução em cadeia (lib/ai/agents/resolve.ts):
//   linha da org → linha da plataforma → hardcoded no código.
// Campo null em qualquer nível significa "herda", nunca "vazio".
//
// ⚠️ `@@unique([orgId, agentKey])` NÃO garante unicidade das linhas de
// plataforma: no Postgres dois NULLs são distintos. A migration cria um índice
// PARCIAL (`WHERE "orgId" IS NULL`) pra isso — sem ele a resolução vira
// loteria entre linhas duplicadas.
//
// As 3 tabelas antigas seguem no schema por uma release como janela de
// rollback (mesmo padrão de Clause → KnowledgeItem); nenhum leitor as usa.

/// Estado do provisionamento de um agente EXTERNO num tenant.
///
/// Existe para separar três situações que, sem ela, se parecem: "nunca
/// provisionado", "provisionado e entregue" e "provisionado, mas o serviço não
/// recebeu o token". A terceira é a perigosa — o flag fica verde no painel e o
/// agente fica mudo, e a única pista era o corpo de uma resposta HTTP que
/// ninguém guarda.
///
/// Também é o que dá idempotência ao `provisionMaxForOrg`: `createApiToken` não
/// é idempotente (só o sha256 é persistido, então não há "checar se existe e
/// reusar"), e sem estado um duplo-clique no painel emite dois tokens vivos —
/// um deles invisível, porque o valor cru só aparece uma vez.
model AgentProvisioning {
  id       String @id @default(cuid())
  orgId    String
  /// Chave do agente externo (hoje só "max"). Ver lib/ai/agents/registry.ts.
  agentKey String

  /// active | pending_delivery | failed | revoked
  ///
  /// `pending_delivery` e `failed` são o alvo do cron de reconciliação. A
  /// distinção importa: `pending_delivery` é "emiti o token e não consegui
  /// entregar" (recuperável reenviando), `failed` é "não cheguei a emitir"
  /// (precisa reprovisionar).
  status        String
  serviceUserId String?
  tokenId       String?
  /// Última entrega CONFIRMADA ao serviço. Null com status active significa
  /// provisionamento por caminho fora do painel (script), não sucesso.
  deliveredAt DateTime?
  /// Motivo da última falha, zerado quando um ciclo fecha bem. Sem ele,
  /// "URL errada" e "serviço fora do ar" são indistinguíveis no painel.
  lastError String?
  /// Tentativas de entrega desde a última confirmação. O cron usa para
  /// espaçar e para parar de insistir num erro que não é transitório.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, agentKey])
  @@index([status])
}

model AgentProfile {
  id       String  @id @default(cuid())
  /// null = default da plataforma; preenchido = override do tenant.
  orgId    String?
  /// analyst | legal | editor | curator | aggregator | passive | support |
  /// ocr | insights | chat_legacy | max — catálogo em lib/ai/agents/registry.ts
  agentKey String
  enabled  Boolean @default(true)

  model         String?
  /// Usado quando o modelo principal responde 429/529 (PR4).
  fallbackModel String?
  temperature   Float?
  maxTokens     Int?

  /// APÊNDICE ao prompt-base do agente: o prompt-base é escolhido por domínio
  /// (venda × locação) e substituí-lo apagaria a variante de locação.
  /// Instrução de tenant entra cercada por <instrucoes_da_imobiliaria>.
  ///
  /// DUAS EXCEÇÕES, herdadas das tabelas que este model unificou:
  ///  - agentKey="chat_legacy": SUBSTITUI o prompt inteiro (era o
  ///    `AgentConfig.systemPrompt`, que tinha essa semântica). Só alcança o
  ///    caminho de rollback ENABLE_MULTI_AGENT=false.
  ///  - agentKey="support": SUBSTITUI o prompt-base (era o
  ///    `SupportAgentConfig.systemPrompt` — é a persona inteira do widget).
  ///    Escopo de plataforma; tenant não escreve nesse agente.
  instructions String? @db.Text

  /// { categories: string[], tags: string[], includePlatform: boolean } — filtro
  /// de RAG do agente (PR3). null = acesso aberto.
  ragScope Json?

  /// Teto mensal de custo do agente na org, em USD (PR4). null = sem teto.
  monthlyBudgetUsd Decimal? @db.Decimal(12, 2)

  /// Sobras específicas de um agente que não merecem coluna própria —
  /// aiInsightsConfig (insights) e handoffMinSimilarity (support).
  config Json?

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, agentKey])
  @@index([agentKey])
}

/// Histórico do AgentProfile — um snapshot COMPLETO por escrita, gravado
/// dentro do próprio `upsertAgentProfile` (o único caminho de escrita).
/// Existe porque um erro de config de agente é silencioso e caro: o efeito
/// aparece na QUALIDADE da resposta, dias depois, sem nada na tela apontando
/// pra mudança. Restaurar = NOVA escrita com o snapshot antigo (gera nova
/// versão, invalida o cache de resolução, aparece no audit) — nunca rewind.
/// Sem FK pro AgentProfile: a linha de perfil pode ser recriada (delete +
/// create no upsert de corrida) e o histórico não pode morrer junto.
model AgentProfileVersion {
  id        String   @id @default(cuid())
  /// Espelho das chaves do perfil — é por (orgId, agentKey) que a aba
  /// Histórico busca, não por profileId.
  orgId     String?
  agentKey  String
  /// O estado COMPLETO do perfil DEPOIS desta escrita (todas as colunas
  /// editáveis). Diff é snapshot[n] × snapshot[n-1], em memória.
  snapshot  Json
  updatedBy String?
  createdAt DateTime @default(now())

  @@index([orgId, agentKey, createdAt])
}

// Pendência de suporte: pergunta que a IA não soube responder. Vira item da base
// quando respondida (retroalimentação). answeredBy = userId do staff de suporte.
model SupportHandoff {
  id                 String    @id @default(cuid())
  orgId              String? // tenant de quem perguntou (contexto/notificação)
  userId             String? // quem perguntou
  question           String    @db.Text
  normalizedQuestion String // pra dedupe de pendências iguais
  transcriptJson     Json? // snapshot do transcript recente (contexto p/ o staff)
  screenPath         String?
  status             String    @default("pending") // pending | answered | dismissed
  answer             String?   @db.Text
  answeredBy         String?
  answeredAt         DateTime?
  knowledgeItemId    String? // item da base criado a partir da resposta
  count              Int       @default(1) // nº de vezes que a mesma pergunta caiu aqui
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([normalizedQuestion, status])
}

// Log de cada resposta do assistente — backbone de qualidade/analytics (aba
// Insights) e alvo do feedback 👍/👎 (rating). Sem PII além do que o próprio
// usuário digitou. orgId/userId são strings soltas (sem FK) de propósito.
model SupportInteraction {
  id              String   @id @default(cuid())
  orgId           String
  userId          String?
  question        String   @db.Text
  answer          String?  @db.Text
  screenPath      String?
  kbTopSimilarity Float? // maior similaridade de hit da KB nesta resposta
  kbHitIds        String[] @default([])
  handoffCreated  Boolean  @default(false)
  handoffId       String?
  rating          Int? // 1 (👍) | -1 (👎)
  createdAt       DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([rating])
}

// CronToggle (Fase staging B) — controle runtime de quais crons rodam em staging.
// Em prod existe mas é ignorada (gate só consulta se STAGING_MODE=true).
model CronToggle {
  path      String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

// ============================================
// CONTRACT CHANGE LOG
// ============================================

model ContractChangeLog {
  id         String   @id @default(cuid())
  contractId String
  userId     String?
  action     String
  summary    String   @db.Text
  details    Json?
  source     String   @default("user")
  createdAt  DateTime @default(now())
  // Snapshot do plain text antes/depois do turn de edição (populado SOMENTE
  // em turns que chamaram tools de write — reads não capturam). UI do
  // ChangesPanel renderiza diff via lib `diff`. Cap de 50kb por snapshot.
  htmlBefore String?  @db.Text
  htmlAfter  String?  @db.Text
  // Atribui o turn à session de chat — UI filtra "mudanças desta session"
  // vs todas as mudanças do contrato. Null pra edições manuais no GDoc
  // (capturadas pelo watch do Drive).
  sessionId  String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User?    @relation("userChangeLogs", fields: [userId], references: [id])

  @@index([contractId, createdAt(sort: Desc)])
  @@index([sessionId])
  // Cron de retenção deleta ruído (google_doc_updated/validation) em batches
  // filtrando action+createdAt — sem este índice cada batch é seq-scan.
  @@index([action, createdAt])
}

// ============================================
// FORM ATTACHMENTS
// ============================================

model FormAttachment {
  id                  String    @id @default(cuid())
  formId              String
  // Quando upload veio de um subtoken (PR 4), aponta para o participant.
  // Null = upload pelo admin via token principal. Usado pra filtrar visão
  // por parte: vendedor não vê documentos subidos pelo comprador.
  participantId       String?
  filename            String
  mime                String
  url                 String
  category            String?
  extractedData       Json?
  contentHash         String?
  // Idempotent OCR lock. Set by the extract routes via an atomic
  // `updateMany({ where: { id, extractingStartedAt: null } })` claim so two
  // concurrent POSTs for the same attachment don't both call Gemini. Cleared
  // back to null on failure so the user can retry.
  extractingStartedAt DateTime?
  // Phase F.I-α — OCR status machine para fila assíncrona. Valores:
  //   "queued"     — arquivo subiu, aguardando worker pegar
  //   "extracting" — worker chamando Gemini
  //   "ready"      — extractedData populado, success
  //   "failed"     — OCR falhou permanentemente (ver extractError)
  // Default "queued" permite que client retorne 202 ack instantâneo e
  // worker (fire-and-forget + cron backup) processe em background. Tab
  // pode fechar — estado vive no DB.
  status              String    @default("queued")
  // Mensagem humanizada de erro quando status="failed" (já passou por
  // humanizeOcrError). Exposta no GET /attachments para QA/debug.
  extractError        String?
  // Tamanho do arquivo em bytes — preenchido no upload daqui pra frente (forward
  // only). Anexos antigos ficam null. Alimenta as métricas de storage por tenant.
  byteSize            Int?
  createdAt           DateTime  @default(now())

  form        SalesForm             @relation(fields: [formId], references: [id], onDelete: Cascade)
  participant SalesFormParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([contentHash])
  @@index([extractingStartedAt])
  @@index([status, createdAt])
  @@index([formId, participantId])
}

// ============================================
// LEGACY (preserved for migration)
// ============================================

model Document {
  id            String   @id @default(uuid())
  userId        String
  filename      String
  mime          String
  s3Url         String
  extractedHtml String?  @db.Text
  extractedText String?  @db.Text
  ocrText       String?  @db.Text
  status        String   @default("uploaded")
  createdAt     DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id])
  legacyTemplate LegacyTemplate?
}

model LegacyTemplate {
  id                 String   @id @default(uuid())
  userId             String
  version            String
  sourceDocId        String   @unique
  handlebarsTemplate String   @db.Text
  analysisJson       Json
  status             String   @default("draft")
  createdAt          DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  document Document @relation(fields: [sourceDocId], references: [id])
}

// ============================================
// KNOWLEDGE BASE (RAG)
// ============================================

/// Base de conhecimento do RAG.
///
/// `orgId = NULL` é a base de PLATAFORMA: visível a todos os tenants, editável
/// só por super_admin. Foi escolhido em vez de org-sentinela porque a sentinela
/// (a) precisava de env pra ser resolvida e divergia entre ambientes, e (b) é um
/// tenant real com `onDelete: Cascade` — apagá-lo levaria junto a base universal.
/// Toda LEITURA passa por `lib/ai/knowledge-scope.ts`; toda ESCRITA em linha de
/// plataforma exige super_admin.
model KnowledgeItem {
  id             String   @id @default(cuid())
  orgId          String?
  category       String // "legislation" | "model" | "rule" | "glossary" | "clause" | "support"
  title          String
  content        String   @db.Text
  chunkIndex     Int      @default(0)
  chunkTotal     Int      @default(1)
  parentId       String?
  tags           String[] @default([])
  source         String? // URL, doc id, "manual", "seed"
  createdBy      String?
  // Campos herdados de Clause na unificação 2026-05-18 (migration
  // 20260518120000_unify_clause_to_knowledge_item). Aplicam quando
  // category === "clause"; em outras categorias ficam ignorados.
  agentNotes     String?  @db.Text
  groupCode      String? // G1..G6 (CLAUSE_SLOT em template)
  subcategory    String? // partes|objeto|preco|posse|...
  isVariable     Boolean  @default(false) // tem placeholders [preencher X]
  status         String   @default("approved") // approved|pending|archived
  usageCount     Int      @default(0)
  legacyClauseId String? // rastreio durante janela de rollback 30d
  /// Agentes que enxergam este item (`AgentProfile.agentKey`). VAZIO = todos —
  /// nenhum item perde alcance por existir a coluna.
  visibleToAgents String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // embedding vector(1024) - added via raw migration, not visible to Prisma

  org             Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent          KnowledgeItem?   @relation("KnowledgeChunks", fields: [parentId], references: [id], onDelete: Cascade)
  chunks          KnowledgeItem[]  @relation("KnowledgeChunks")
  contractClauses ContractClause[]
  usageByOrg      KnowledgeItemUsage[]

  @@index([orgId, category])
  @@index([orgId, parentId])
  @@index([orgId, category, groupCode])
  @@index([legacyClauseId])
}

/// Uso de um `KnowledgeItem` POR TENANT.
///
/// `KnowledgeItem.usageCount` continua existindo como total agregado (a UI de
/// cláusulas e o `find_similar_contracts` leem de lá). Esta tabela existe
/// porque, com a base de plataforma, um contador global deixou de ser inócuo:
/// o `expert-context` ordena as top-8 cláusulas por popularidade e injeta o
/// resultado no prompt de todo turn em modo Planejar. Sem separar por org, um
/// tenant que insere a mesma cláusula universal muitas vezes desloca o
/// preâmbulo do agente de OUTRO tenant.
///
/// O backfill atribui o `usageCount` histórico só às linhas que já têm dono
/// (`orgId` não nulo). Uso histórico de linha de plataforma não pertence a
/// ninguém e começa do zero — herdar o total para todas as orgs seria inventar
/// dado.
model KnowledgeItemUsage {
  id              String   @id @default(cuid())
  knowledgeItemId String
  orgId           String
  count           Int      @default(0)
  updatedAt       DateTime @updatedAt

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, orgId])
  @@index([orgId, count])
}

// ============================================
// LEARNING: CONTRACT MEMORY + PROPOSALS (Propose mode)
// ============================================

model ContractMemory {
  id                  String   @id @default(cuid())
  orgId               String
  contractId          String? // null if the contract was deleted
  templateId          String?
  dataFingerprint     Json // reduced snapshot: modality, civil status, value range, etc.
  summary             String   @db.Text
  acceptedSuggestions Json // ids + texts of AI suggestions that were accepted
  rejectedSuggestions Json // ids of rejected suggestions (learn what NOT to suggest)
  manualEdits         Json // text added manually that didn't come from the clause library
  createdAt           DateTime @default(now())
  // embedding vector(1024) - added via raw migration

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, templateId])
}

model ClauseProposal {
  id         String    @id @default(cuid())
  orgId      String
  authorType String // "ai" | "user"
  userId     String?
  title      String
  content    String    @db.Text
  groupCode  String? // G1-G6 or null
  category   String? // partes, objeto, compromisso, preco, posse, titulo, comissao, etc.
  reason     String    @db.Text
  evidence   Json? // contractIds that motivated it
  tags       String[] @default([])
  status     String    @default("pending") // "pending" | "approved" | "rejected"
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

model TemplateSuggestion {
  id         String    @id @default(cuid())
  templateId String
  orgId      String
  authorType String // "ai" | "user"
  userId     String?
  title      String
  reason     String    @db.Text
  diffHunks  Json // [{ before, after, contextBefore, contextAfter }]
  evidence   Json? // contractIds that motivated the suggestion
  status     String    @default("pending") // "pending" | "approved" | "rejected"
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  template ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([templateId, status])
  @@index([orgId, status])
}

// ============================================
// DOCUMENT STYLE (design system per organization)
// ============================================

model DocumentStyle {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  isDefault      Boolean  @default(false)
  fontFamily     String   @default("Times New Roman")
  fontSizeBase   Int      @default(12) // pt
  lineHeight     Float    @default(1.5)
  marginTopMm    Int      @default(25)
  marginBottomMm Int      @default(25)
  marginLeftMm   Int      @default(25)
  marginRightMm  Int      @default(25)
  colorPrimary   String   @default("#000000")
  colorAccent    String   @default("#C97B0A")
  headerHtml     String?  @db.Text
  footerHtml     String?  @db.Text
  pageNumbers    Boolean  @default(true)
  includeToc     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ============================================
// AI OBSERVABILITY — tracks every AI call (Anthropic, Gemini, Voyage)
// with tokens, latency, cost and context. Fire-and-forget writes from the
// helper in src/lib/ai/usage.ts; never blocks the AI flow.
// ============================================

model AIUsage {
  id               String   @id @default(cuid())
  /// `null` = custo de PLATAFORMA (ingestão/embedding da base universal), que
  /// não pertence a tenant nenhum. Antes era NOT NULL e essas chamadas ficavam
  /// SEM REGISTRO — o painel mostrava zero onde havia gasto real.
  orgId            String?
  /// Agente responsável (`AgentProfile.agentKey`). Derivado de `operation` pelo
  /// registry quando o call-site não informa; nullable porque linha histórica
  /// não tem, e porque nem toda operação pertence a um agente.
  agentKey         String?
  userId           String?
  // Coluna simples (SEM FK pra Contract). Antes era FK com onDelete:SetNull, o
  // que ZERAVA a atribuição retroativamente ao apagar o contrato — o custo já
  // gasto virava órfão sem contrato. Mantendo só o id, a atribuição histórica
  // sobrevive à deleção do contrato (id fica "dangling", mas rastreável).
  contractId       String?
  // Dimensões analíticas (mesma filosofia: id simples, sem FK — sobrevivem à
  // deleção do registro-pai). sessionId = ChatSession do turn (chat/specialists);
  // dealId = negócio associado. Nullable: operações sem chat/deal ficam null.
  sessionId        String?
  dealId           String?
  provider         String // "anthropic" | "gemini" | "voyage" | "openrouter"
  model            String
  operation        String // union canônico em lib/ai/usage.ts::AIOperation (chat, passive_*, ocr_*, embed_*, specialist_*, sentinel_classify, intent_classify, ...)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  totalTokens      Int      @default(0)
  /// O MELHOR número de custo que temos para esta linha — não necessariamente
  /// uma estimativa. Quando o provedor informa o crédito REAL cobrado (hoje só
  /// o OpenRouter, via `usage.cost`), é ele que fica aqui; senão, a tabela de
  /// preços do `calcCostUsd`. `costSource` diz qual dos dois.
  ///
  /// A coluna guarda o melhor número, e não um segundo campo, de propósito:
  /// ~60 pontos do produto somam `estimatedCostUsd` (budget por contrato, teto
  /// mensal por agente, /settings/ai-usage, métricas de admin). Um campo
  /// paralelo obrigaria todos a fazer COALESCE, e o primeiro esquecido daria
  /// um total errado em silêncio — o pior modo de falha desta tabela.
  estimatedCostUsd Decimal  @default(0) @db.Decimal(12, 6)
  /// "reported" = crédito real do provedor · "estimated" = tabela de preços.
  /// Existe porque a diferença é grande e invisível: medido em 21/08, um turn
  /// com 1792 de 1956 tokens vindos do cache de prefixo custou US$ 0,00010614
  /// e a tabela dizia US$ 0,00042870 — superestimativa de 304%.
  costSource       String   @default("estimated")
  latencyMs        Int      @default(0)
  toolsUsed        String[] @default([])
  iterations       Int      @default(1)
  success          Boolean  @default(true)
  errorMessage     String?  @db.Text
  createdAt        DateTime @default(now())

  org  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, provider, createdAt])
  @@index([orgId, operation, createdAt])
  @@index([orgId, agentKey, createdAt])
  @@index([contractId, createdAt])
}

// AgentRun (D — QA deal 20486): 1 linha por turn do chat multi-agente, com o
// LEDGER determinístico do que foi efetivamente aplicado. Serve de log pra
// análise de funcionamento/output e base de treino/memória. SEM @relation de
// propósito — o registro sobrevive à exclusão do contrato/sessão (histórico).
model AgentRun {
  id                  String   @id @default(cuid())
  orgId               String
  contractId          String?
  sessionId           String?
  messageId           String?
  userId              String?
  mode                String // "fast" | "plan"
  intent              String? // informational | edit_simple | edit_multi | review | propose
  agentsRun           String[] @default([])
  /// [{ name, success, applied?, verified? }] — timeline resumida de tools.
  toolCallsJson       Json?
  writesAttempted     Int      @default(0)
  writesApplied       Int      @default(0)
  writesPending       Int      @default(0)
  writesFailed        Int      @default(0)
  /// applied | applied_partial | pending_plan | no_op_informational | failed | confabulation_blocked
  outcome             String
  finalMessagePreview String?  @db.Text
  promptTokens        Int      @default(0)
  completionTokens    Int      @default(0)
  totalTokens         Int      @default(0)
  estimatedCostUsd    Decimal  @default(0) @db.Decimal(12, 6)
  latencyMs           Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, outcome, createdAt])
  @@index([sessionId])
  @@index([contractId, createdAt])
}

// ============================================
// PAGADORIA — SEGURANÇA BASELINE (Fase 1a)
// ============================================

// TOTP secret por usuário (Google Authenticator / 1Password / Authy).
// Obrigatório para acesso ao módulo Financeiro.
model TwoFactorSecret {
  id               String    @id @default(cuid())
  userId           String    @unique
  secretEncrypted  String    @db.Text
  secretIvBase64   String
  secretTagBase64  String
  recoveryCodesEnc String    @db.Text
  enabled          Boolean   @default(false)
  enrolledAt       DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Sudo mode — janela de 15min para operações sensíveis após reautenticação.
model SessionElevation {
  id         String    @id @default(cuid())
  userId     String
  scope      String // TRANSFER | KYC_EDIT | BANK_ACCOUNT | API_KEY_ROTATE | MEMBER_MANAGE | FEES_CONFIG
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  userAgent  String?   @db.Text
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope, expiresAt])
}

// OTP por operação — single-use, 5min TTL, bound a payloadHash.
model OperationChallenge {
  id          String    @id @default(cuid())
  userId      String
  orgId       String
  kind        String // TRANSFER | BANK_ACCOUNT_CHANGE | SUBACCOUNT_DELETE | DUAL_APPROVE
  payloadHash String
  channel     String    @default("EMAIL")
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  expiresAt   DateTime
  consumedAt  DateTime?
  cancelledAt DateTime?
  ipAddress   String?
  userAgent   String?   @db.Text
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, expiresAt])
}

// Audit log imutável — append-only.
model AuditLog {
  id           String   @id @default(cuid())
  // Nullable (Fase 0c): eventos pré-resolução de tenant (ex.: webhook ClickSign
  // antes de identificar o envelope) gravam orgId=null em vez de cair no
  // SHARED_ORG_ID. Pós-resolução usa o orgId real.
  orgId        String?
  userId       String?
  action       String
  resource     String?
  resourceType String?
  result       String // SUCCESS | FAILURE | DENIED
  metadata     Json?
  ipAddress    String?
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  org  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, action, createdAt])
  @@index([userId, createdAt])
}

/// Motor de alerta da plataforma — o registro deduplicado do que precisa
/// chegar ao dono por e-mail (destinatários = PlatformRole super_admin, do
/// banco, não env). Ocorrência repetida da mesma assinatura INCREMENTA
/// `count` em vez de criar linha — é o que impede o alerta de virar spam e
/// treinar o dono a ignorá-lo. `notifiedAt` nulo = pendente pro digest;
/// preenchido = e-mail imediato já saiu (re-arma após 24h).
/// SEM orgId FK de propósito: alerta sobrevive à exclusão da org (o evento
/// "org X quebrou e foi apagada" é exatamente o que não pode sumir junto).
model PlatformAlertEvent {
  id          String    @id @default(cuid())
  /// support_signal | integration_failure | ai_budget | model_fallback
  /// (runtime_error na fase H) — catálogo em lib/alerts/platform-alerts.ts
  kind        String
  /// Chave de dedupe DENTRO do kind (ex.: "CLICKSIGN_SEND_FAILED:org123").
  signature   String
  orgId       String?
  /// info | warning | critical — decide tom do e-mail, não roteamento.
  severity    String    @default("warning")
  title       String
  payload     Json?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  notifiedAt  DateTime?

  @@unique([kind, signature])
  @@index([lastSeenAt])
  @@index([notifiedAt])
}

// Dispositivos confiáveis — fingerprint + cookie assinado.
model TrustedDevice {
  id            String    @id @default(cuid())
  userId        String
  orgId         String
  fingerprint   String
  label         String?
  lastIpAddress String?
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

// Roles customizados por org — permissions em JSON.
model CustomRole {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  permissions Json
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members OrgMembership[]

  @@unique([orgId, name])
}

// Aprovação dupla (dual control) — operações de alto valor.
model DualApproval {
  id           String    @id @default(cuid())
  orgId        String
  initiatedBy  String
  kind         String // TRANSFER | REFUND_LARGE | SPLIT_CHANGE | FEES_CHANGE
  payloadJson  Json
  payloadHash  String
  amount       Float?
  reason       String?   @db.Text
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED | CANCELLED
  approverId   String?
  approvalNote String?   @db.Text
  expiresAt    DateTime
  resolvedAt   DateTime?
  executedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  initiator User         @relation("DualApprovalInit", fields: [initiatedBy], references: [id])
  approver  User?        @relation("DualApprovalAck", fields: [approverId], references: [id])

  @@index([orgId, status])
}

// ============================================
// PAGADORIA — ASAAS + KYC + COBRANÇA (Fase 1b)
// ============================================

// Subconta Asaas white-label da Organization (criada via POST /v3/accounts).
// Armazena walletId + apiKey encrypted + status KYC. Org pode ter N contas;
// admin escolhe qual está ativa via Organization.activeAsaasAccountId.
model AsaasAccount {
  id                     String    @id @default(cuid())
  orgId                  String
  // Rótulo livre para distinguir contas no seletor (ex: "Imobiliária PJ", "Holding").
  label                  String?
  asaasId                String    @unique
  walletId               String    @unique
  accountNumber          String?
  // White-label Asaas (Fase 1d): id da AsaasAccount-mãe da plataforma quando
  // esta é uma subconta-filha. null = é a própria conta-mãe ou conta legada
  // independente. Marca a hierarquia; o markup global vem de PlatformConfig.
  parentAccountId        String?
  apiKeyEncrypted        String    @db.Text
  apiKeyIvBase64         String
  apiKeyTagBase64        String
  personType             String // PHYSICAL | LEGAL
  kyc                    Json // snapshot do payload submetido (sem secrets)
  status                 String    @default("PENDING") // PENDING | AWAITING_DOCS | AWAITING_APPROVAL | APPROVED | REJECTED | BLOCKED
  rejectionReason        String?   @db.Text
  generalStatus          String?
  documentationStatus    String?
  commercialInfoStatus   String?
  bankAccountInfoStatus  String?
  lastStatusCheckAt      DateTime?
  approvedAt             DateTime?
  // Quando o Asaas enviou o email inicial de ativação (auto na criação).
  activationLinkSentAt   DateTime?
  // Quando o Asaas reenviou o email (limitado a 1× via API).
  activationLinkResentAt DateTime?
  // [LEGACY — não usado mais] Token público da rota /kyc/[token].
  // Mantido pra evitar migration de drop column; remover em cleanup futuro.
  kycToken               String?   @unique
  // Soft delete: archivedAt != null oculta dos seletores e impede novas cobranças,
  // mas mantém histórico (cobranças/transferências antigas continuam acessíveis).
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org               Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  activeForOrgs     Organization[]           @relation("OrgActiveAsaasAccount")
  documents         AsaasAccountDocument[]
  customers         AsaasCustomer[]
  commissionCharges CommissionCharge[]
  transfers         AsaasTransfer[]
  reconciliations   BankReconciliation[]
  webhookEvents     AsaasWebhookEvent[]
  financialSettings OrgFinancialSettings?
  permissions       AsaasAccountPermission[]

  @@index([orgId])
}

// Capabilities granulares por (conta, user). Owner da org bypassa via OrgMembership.role.
// Capability values: "view" | "create_charge" | "init_transfer" | "configure".
model AsaasAccountPermission {
  id         String   @id @default(cuid())
  accountId  String
  userId     String
  capability String
  grantedBy  String?
  createdAt  DateTime @default(now())

  account AsaasAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User         @relation("AccountPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  granter User?        @relation("AccountPermissionGranter", fields: [grantedBy], references: [id])

  @@unique([accountId, userId, capability])
  @@index([userId])
}

// Documentos KYC pendentes/enviados — mirror do GET /v3/myAccount/documents.
model AsaasAccountDocument {
  id              String    @id @default(cuid())
  accountId       String
  asaasDocumentId String
  type            String // IDENTIFICATION | ADDRESS_PROOF | SOCIAL_CONTRACT | SELFIE | CUSTOM
  title           String
  description     String?
  status          String    @default("NOT_SENT") // NOT_SENT | PENDING | APPROVED | REJECTED
  rejectionReason String?
  fileName        String?
  fileUrl         String?
  fileMime        String?
  fileSizeBytes   Int?
  uploadedAt      DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account AsaasAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, type])
  @@index([accountId, status])
}

// Cliente Asaas (pagador) — escopado por subconta (cada AsaasAccount tem seu
// próprio cadastro de customers no Asaas). Dedupe por (accountId, cpfCnpj).
// Mesmo CPF/CNPJ pode existir em N contas independentemente.
model AsaasCustomer {
  id                String    @id @default(cuid())
  orgId             String
  accountId         String?
  asaasId           String
  name              String
  cpfCnpj           String
  email             String?
  mobilePhone       String?
  addressJson       Json?
  origin            String    @default("manual") // manual | deal_sync | webhook_sync
  sourceDealId      String?
  externalReference String?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org     Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account AsaasAccount?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  charges CommissionCharge[]

  @@unique([accountId, asaasId])
  @@unique([accountId, cpfCnpj])
  @@index([orgId, name])
}

// Cobrança de comissão — pode estar vinculada a Deal ou ser avulsa.
// accountId persistido na criação: cobrança fica colada à conta que a emitiu
// (paymentId+walletId valem só naquela subconta). Trocar conta ativa NÃO
// afeta cobranças já emitidas.
model CommissionCharge {
  id                  String    @id @default(cuid())
  orgId               String
  accountId           String?
  dealId              String?
  contractId          String?
  asaasCustomerId     String
  asaasPaymentId      String    @unique
  asaasInstallmentId  String?
  kind                String    @default("commission") // commission | avulsa | aluguel | outros
  // Texto livre para identificação de cobranças avulsas (ex.: "Reembolso de
  // matrícula", "Honorários advogado"). Filtrável e agrupável no dashboard.
  // Não usado em kind="commission".
  categoryLabel       String?
  billingType         String // PIX | BOLETO
  value               Float
  netValue            Float?
  originalDueDate     DateTime
  currentDueDate      DateTime
  status              String    @default("PENDING") // ver mapa canônico no plano
  asaasStatus         String
  description         String?
  invoiceUrl          String?
  bankSlipUrl         String?
  identificationField String?
  pixQrCodePayload    String?   @db.Text
  pixQrCodeImage      String?   @db.Text
  splitJson           Json?
  payerSnapshot       Json?
  beneficiarySnapshot Json?
  cancelledAt         DateTime?
  refundedAt          DateTime?
  paidAt              DateTime?
  lastEventAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  org        Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account    AsaasAccount?       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  deal       Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contract   Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  customer   AsaasCustomer       @relation(fields: [asaasCustomerId], references: [id])
  events     AsaasWebhookEvent[]
  publicLink ChargePublicLink?
  transfers  AsaasTransfer[]

  @@index([orgId, status])
  @@index([orgId, currentDueDate])
  @@index([orgId, kind])
  @@index([accountId])
  @@index([dealId])
  @@index([contractId])
  @@index([asaasCustomerId])
}

// Log imutável de webhooks Asaas — idempotência via asaasEventId.
// accountId resolvido via charge/transfer lookup; nullable porque eventos
// non-payment sem transfer (raro) podem chegar sem inferência possível.
model AsaasWebhookEvent {
  id              String    @id @default(cuid())
  orgId           String
  accountId       String?
  asaasEventId    String    @unique
  event           String
  asaasPaymentId  String?
  chargeId        String?
  payloadJson     Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?

  org     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account AsaasAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  charge  CommissionCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([orgId, event])
  @@index([asaasPaymentId])
}

// Configurações financeiras escopadas por subconta — taxas, overprice, descontos,
// branding. accountId é canônico (1:1 com AsaasAccount). orgId mantido como
// shortcut de query/audit, mas a unicidade real é por accountId.
model OrgFinancialSettings {
  id                      String   @id @default(cuid())
  orgId                   String
  accountId               String?  @unique
  // Platform fee (Fase 3)
  platformFeePercent      Float    @default(0)
  platformFeeWalletId     String?
  // Overprice
  overpricePolicy         String   @default("none") // none | absorb | asaas_fee | custom
  overpriceType           String?
  overpriceValue          Float?
  overpriceRoundTo        String?  @default("cents")
  // Descontos (presets em JSON array)
  discountPresets         Json     @default("[]")
  // Multa / juros (limites legais: fine ≤ 2%, juros ≤ 1%/mês)
  finePercent             Float    @default(2.0)
  finePolicy              String   @default("percentage")
  interestPercentMonth    Float    @default(1.0)
  // Taxas Asaas cacheadas (display)
  asaasFeePixCents        Int      @default(199)
  asaasFeeBoletoCents     Int      @default(349)
  asaasFeeCardPercent     Float    @default(2.99)
  asaasFeeCardCents       Int      @default(49)
  // Dual control (valores em centavos; Int suporta até ~R$ 21M)
  dualApprovalCapCents    Int      @default(5000000)
  hardCapCents            Int      @default(10000000)
  // DEPRECATED — a marca da imobiliária mora em BrandingSettings (1:1 com a org).
  // Estes campos são por CONTA ASAAS, o que permitia dois logos na mesma org e
  // deixava sem marca quem não tem conta. Ninguém mais lê nem escreve: migrados
  // pela migration 20260714190000. Mantidos só como rollback; drop em release
  // futura.
  brandLogoUrl            String?
  brandPrimaryColor       String?  @default("#0f172a")
  brandDisplayName        String?
  brandSupportEmail       String?
  brandSupportPhone       String?
  // Defaults de notificação Asaas → pagador (NotificationDisabled)
  notifyEmail             Boolean  @default(true)
  notifySms               Boolean  @default(false)
  defaultDueDays          Int      @default(7)
  // Régua interna (Pagadoria 2026-05-09): notificações ao corretor/admins/comissionados
  // por email + sino quando a cobrança muda de estado. Asaas continua notificando
  // o pagador conforme `notifyEmail`/`notifySms`.
  notifyOwnerOnCreated    Boolean  @default(true)
  notifyOwnerOnPaid       Boolean  @default(true)
  notifyOwnerOnOverdue    Boolean  @default(true)
  notifyOwnerOnDueSoon    Boolean  @default(true)
  notifyAdminsOnPaid      Boolean  @default(false)
  notifyComissionados     Boolean  @default(true)
  // Política de taxa para splits PIX externos (Fase 6):
  //   "org_absorbs"           — beneficiário recebe valor cheio, org paga taxa Asaas
  //   "deduct_from_recipient" — taxa é descontada do split do beneficiário
  pixSplitFeePolicy       String   @default("org_absorbs")
  // Última taxa de PIX externo observada (em centavos). Atualizada
  // automaticamente a cada AsaasTransfer DONE com transferFee retornado.
  // Usada como estimativa em deduct_from_recipient antes do dispatch real.
  lastObservedPixFeeCents Int      @default(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account AsaasAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Configuração de obrigatoriedade dos campos do formulário público (`/f/[token]`).
// `preset` aponta para um array declarativo em `lib/forms/presets.ts` —
// "legado" preserva o STEP_REQUIRED_FIELDS hardcoded original (default em orgs
// existentes pra não quebrar fluxos ativos). Orgs novas nascem como "padrao".
// `customRequiredPaths` é union ADICIONAL ao preset quando admin clica em
// "Personalizar" — paths extras de DadosContrato (ex: "vendedores.0.rg").
model OrgFormSettings {
  id                  String   @id @default(cuid())
  orgId               String   @unique
  // VENDA. Valores canônicos da UI nova: essencial | completo | custom.
  // legado | minimo | padrao continuam válidos (orgs anteriores a 2026-07-28)
  // e resolvem os MESMOS arrays de sempre — ver lib/forms/presets.ts.
  preset              String   @default("legado") // legado | minimo | padrao | completo | essencial | custom
  customRequiredPaths Json     @default("[]")
  // LOCAÇÃO — par espelhado do de venda. Aditivo: os campos NÃO são
  // compartilhados porque os steps e os paths das duas esteiras são
  // diferentes (locação tem locadores/locatarios/imovel singular/aluguel).
  // Default "legado" = nada obrigatório, que é como locação sempre se
  // comportou antes desta config existir.
  locacaoPreset              String @default("legado") // legado | essencial | completo | custom
  locacaoCustomRequiredPaths Json   @default("[]")
  // Segurança do link do formulário: quando true, o SalesForm trava sozinho
  // (SalesForm.lockedAt) no momento em que o cliente finaliza — congela os
  // dados contra edição posterior por quem ainda tiver o link. Default false
  // preserva o comportamento atual (form reabrível pós-finalize).
  autoLockFormOnFinalize Boolean @default(false)
  // Resumo consolidado do formulário por e-mail. `summaryRecipientEmail` é o
  // destino fixo usado pela automação e sugerido no envio manual;
  // `autoSendSummaryOnComplete` liga o disparo automático no finalize.
  summaryRecipientEmail     String?
  autoSendSummaryOnComplete Boolean @default(false)
  summaryIncludeAttachments Boolean @default(true)
  // Padrão de configurações contratuais da imobiliária (multas, juros, foro,
  // desistência, local de assinatura) — o que antes o cliente respondia na
  // última etapa do form público e virou decisão da org, aplicada na geração e
  // editável na aba "Configurações" do contrato.
  //
  // Namespaced por módulo (`{ venda: {...}, locacao: {...} }`) porque os campos
  // NÃO são equivalentes entre as esteiras: em venda `foro` é enum
  // (arbitragem|justica-publica) e em locação é a comarca em texto livre. Ver
  // lib/contracts/default-config.ts. `{}` = usa o padrão de fábrica.
  contractDefaultsJson      Json    @default("{}")
  // Visibilidade de seções (etapas do wizard) por link de parte, namespaced
  // `{ venda: { comprador: [0,2,5] }, locacao: {...} }`. Null = defaults em
  // código. Sanitização e allowlists (etapa 6/Comissão nunca entra) em
  // lib/forms/participant-visibility.ts. Merge por branch no PATCH.
  participantVisibilityJson Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Categorias de TERCEIRO nos links por parte do formulário público.
//
// Os 5 papéis nativos (vendedor/comprador; locador/locatario/fiador) seguem
// fechados em código — cada um escreve numa subárvore conhecida do
// DadosContrato, com step, validação e OCR próprios. Terceiro é o caso aberto:
// a imobiliária cria a categoria (interveniente anuente, gestor do condomínio,
// procurador externo…) e declara os campos que quer coletar.
//
// `SalesFormParticipant.role` guarda "terceiro:<slug>" — a coluna sempre foi
// String, então não há migration de dados. As respostas vão pra
// `SalesForm.dataJson.terceiros.<slug>[]`, namespace ADITIVO que não colide com
// nenhuma chave dos schemas de venda ou locação.
//
// Ver lib/forms/participant-category.ts.
model FormParticipantCategory {
  id          String   @id @default(cuid())
  orgId       String
  /// kebab-case; entra no role e no path do dataJson.
  slug        String
  label       String
  description String?
  /// "venda" | "locacao" — em quais esteiras a categoria é oferecida.
  appliesTo   String[] @default([])
  /// [{ key, label, type, required }] — ver categoryFieldsSchema.
  fields      Json     @default("[]")
  /// Desativar em vez de deletar quando já houver link emitido.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId, active])
}

/// Catálogo de GARANTIAS locatícias da imobiliária (art. 37 Lei 8.245/91).
///
/// O formulário de locação pedia a modalidade num select fechado e a
/// seguradora num texto livre — cada corretor escrevia "Porto", "Porto Seguro
/// S/A", "porto seguro", e a cláusula da seguradora (taggeada por `provider`)
/// nunca casava. Aqui a imobiliária cadastra os pares tipo × garantidor que ela
/// realmente trabalha, e o form oferece cada par como UMA escolha
/// ("Seguro-fiança — Porto Seguro").
///
/// Org sem nenhuma row cai nos DEFAULTS de `lib/forms/garantia-catalog.ts`
/// (seguro-fiança × Tokio Marine / Porto Seguro / Pottencial / Too) — mesmo
/// padrão lazy do branding. Desativar (`active=false`) tira do form sem
/// quebrar contratos já gerados com aquele garantidor.
model GarantiaOption {
  id String @id @default(cuid())

  orgId String
  /// Uma das 7 modalidades de GARANTIA_TIPOS (lib/contracts/template-category.ts).
  tipo  String
  /// Seguradora/garantidora. "" = a modalidade sozinha (fiador, caução…).
  provider String @default("")
  /// Rótulo exibido no form; vazio = derivado de tipo + garantidor.
  label    String?
  active   Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, tipo, provider])
  @@index([orgId, active])
}

// Cadastro de destinatários de split de pagamento (Fase 5).
// Cada recipient representa uma wallet Asaas que pode receber repasse em
// cobranças da org. Usados pelo SplitEditor no form de nova cobrança.
model SplitRecipient {
  id                 String    @id @default(cuid())
  orgId              String
  label              String
  // Tipo do beneficiário:
  //   "asaas_wallet" — beneficiário tem conta Asaas (split nativo, gratuito, instantâneo)
  //   "pix_external" — beneficiário só tem PIX em outro banco (transferência Asaas pós-pagamento)
  recipientType      String    @default("asaas_wallet")
  // Para asaas_wallet:
  walletId           String?
  // Para pix_external:
  pixAddressKey      String?
  pixKeyType         String? // CPF | CNPJ | EMAIL | PHONE | EVP
  ownerName          String?
  ownerCpfCnpj       String?
  // Comum:
  cpfCnpj            String?
  description        String?
  // Email pra notificação interna (régua Pagadoria) quando cobrança paga
  // dispara split pra este destinatário. Opt-in: sem email, comissionado
  // não é notificado (Asaas notifica direto o pagador, não o beneficiário).
  email              String?
  // Pagadoria v2 — rascunho de cadastro: lista de campos pendentes (ex:
  // ["pixAddressKey"]). Quando não-vazio, splitDispatcher pula este recipient
  // marcando o transfer como FAILED. Comissionado pode completar via UI
  // admin OU magic link público (completionToken).
  pendingFields      String[]  @default([])
  // Magic link pra comissionado completar dados sem login. Token JWT
  // assinado com AUTH_SECRET, exp 7d. Página pública /financeiro/completar-cadastro
  // valida e marca active: true + esvazia pendingFields.
  completionToken    String?   @db.Text
  completionTokenExp DateTime?
  active             Boolean   @default(true)
  // Cadastro reutilizável de comissionado (2026-05-16). Quando kind="commissioner"
  // o recipient pode ser escolhido por autocomplete na etapa Comissão do form
  // público (/api/forms/[token]/commissioners). kind="other" mantém uso pré-existente.
  kind               String?   @default("commissioner")
  tipoPessoa         String? // fisica | juridica
  creci              String?
  papel              String? // imobiliaria_principal | captador | intermediador | indicador | outro
  phone              String?
  // Dados bancários (TED) — alternativa quando o destinatário não tem
  // conta Asaas (asaas_wallet) nem PIX cadastrado. Capturado no form.
  bankName           String?
  bankBranch         String?
  bankAccount        String?
  bankAccountType    String? // corrente | poupanca
  bankHolderName     String?
  bankHolderDoc      String?
  // Preferências de notificação do corretor (feature "atualizações do processo",
  // 2026-07). Consumidas por lib/notifications/deal-events.ts. WhatsApp é opt-in
  // (depende do gate Newton por org); notifyOptOut silencia todos os canais.
  notifyByEmail      Boolean   @default(true)
  notifyByWhatsapp   Boolean   @default(false)
  notifyOptOut       Boolean   @default(false)
  // Atribuição explícita da imobiliária: "este corretor é da minha casa e pode
  // conversar com o meu Max". NÃO é o mesmo que notifyByWhatsapp — receber aviso
  // de um negócio compartilhado é legítimo para corretor de imobiliária
  // PARCEIRA; ser reconhecido como da casa não é. `phone` aqui não tem unique
  // nenhum (ao contrário de User.phone), então o mesmo corretor existe como
  // commissioner em N orgs e só o dono de cada uma decide se ele fala com o
  // agente dela. Default false = fail-closed.
  maxEnabled         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transfers AsaasTransfer[]

  // Além dos uniques abaixo há um partial unique index só em SQL (Prisma não
  // expressa índice parcial): UNIQUE (orgId, cpfCnpj) WHERE kind='commissioner'
  // AND active=true AND cpfCnpj IS NOT NULL — garante corretor sem duplicata.
  // Ver migration 20260724*_split_recipient_notify_dedupe.
  //
  // E outro, pela mesma limitação: INDEX (orgId, phone) WHERE maxEnabled AND
  // active — serve a varredura por telefone que o Max faz a cada mensagem
  // recebida. Ver migration 20260803160000_split_recipient_max_enabled.
  @@unique([orgId, walletId])
  @@unique([orgId, pixAddressKey])
  @@index([orgId, active])
  @@index([orgId, recipientType])
  @@index([orgId, kind, active])
}

// Rascunho do wizard de geração de cobrança (Pagadoria v2 2026-05-09).
// Permite ao operador salvar progresso e retomar depois — útil quando precisa
// sair pra buscar PIX de um comissionado, conferir contrato, etc. 1 draft por
// (deal, user). Cleanup diário deleta drafts com expiresAt < now.
model CommissionChargeDraft {
  id        String   @id @default(cuid())
  orgId     String
  dealId    String
  userId    String
  state     Json // serialização completa do estado do wizard
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // now + 30d

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([orgId, expiresAt])
}

// Link público de pagamento — URL /pay/[token] com branding.
model ChargePublicLink {
  id            String    @id @default(cuid())
  chargeId      String    @unique
  publicToken   String    @unique
  brandSnapshot Json
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())

  charge CommissionCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
}

// ============================================
// PAGADORIA — TRANSFERÊNCIAS + CONCILIAÇÃO (Fase 3)
// ============================================

// Transferências (saque) da subconta Asaas → conta bancária da org.
// accountId persistido na criação: a transfer "sai" do saldo daquela subconta
// específica.
model AsaasTransfer {
  id                 String    @id @default(cuid())
  orgId              String
  accountId          String?
  asaasTransferId    String?   @unique // tra_xxx — null antes da chamada Asaas (status=PENDING_DISPATCH)
  value              Float
  netValue           Float?
  transferFee        Float?
  type               String // PIX | TED
  // Status: PENDING_DISPATCH (novo) | PENDING | DONE | FAILED | CANCELLED
  status             String
  pixAddressKey      String?
  pixKeyType         String? // CPF | CNPJ | EMAIL | PHONE | RANDOM
  ownerName          String? // nome do destinatário (validado via pix validation)
  ownerCpfCnpj       String?
  bankAccountJson    Json?
  requestedBy        String?
  scheduledDate      DateTime?
  effectiveDate      DateTime?
  description        String?
  failureReason      String?   @db.Text
  // Trigger automático (Fase 6): split PIX externo gerado a partir de cobrança paga
  commissionChargeId String?
  splitRecipientId   String?
  // Idempotência de dispatch: `${chargeId}:${splitRecipientId ?? 'ext:'+pixKey}`.
  // O @@unique([commissionChargeId, splitRecipientId]) NÃO protege PIX externo
  // one-shot (splitRecipientId NULL → NULLs distintos no índice), então o
  // webhook Asaas disparando em PAYMENT_RECEIVED e PAYMENT_CONFIRMED pagava 2×.
  // Esta chave é não-nula pra todo dispatch automático e barra a duplicata.
  dispatchDedupeKey  String?   @unique
  origin             String    @default("manual") // manual | split_dispatch
  // NFS-e por repasse (locação, A16) — emitida pela imobiliária quando
  // LeaseContract.emitirNfse=true. Provider varia por município.
  nfseRequerida      Boolean   @default(false)
  nfseEmitida        Boolean   @default(false)
  nfseNumero         String?
  nfseUrl            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account          AsaasAccount?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user             User?             @relation(fields: [requestedBy], references: [id])
  commissionCharge CommissionCharge? @relation(fields: [commissionChargeId], references: [id], onDelete: SetNull)
  splitRecipient   SplitRecipient?   @relation(fields: [splitRecipientId], references: [id], onDelete: SetNull)

  @@unique([commissionChargeId, splitRecipientId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([accountId])
  @@index([commissionChargeId])
}

// Conciliação — match entre lançamentos do extrato Asaas e cobranças locais.
// accountId identifica a subconta cujo extrato originou a row.
model BankReconciliation {
  id                     String    @id @default(cuid())
  orgId                  String
  accountId              String?
  financialTransactionId String // id do extrato Asaas (pode ser hash se sem id)
  type                   String // PAYMENT_RECEIVED | PAYMENT_FEE | TRANSFER | REFUND | CHARGEBACK | OTHER
  value                  Float
  date                   DateTime
  description            String?   @db.Text
  asaasPaymentId         String? // se type=PAYMENT_RECEIVED
  matchedChargeId        String?
  status                 String    @default("pending") // pending | matched | ignored | manual
  notes                  String?   @db.Text
  matchedAt              DateTime?
  matchedBy              String? // userId
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account AsaasAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user    User?         @relation(fields: [matchedBy], references: [id], onDelete: SetNull)

  @@unique([orgId, financialTransactionId])
  @@index([orgId, status])
  @@index([orgId, date])
  @@index([accountId])
  @@index([matchedChargeId])
}

// ============================================
// CLICKSIGN — assinatura eletrônica de contratos
// ============================================

// Envelope = uma transação de assinatura na Clicksign API v3.
// Um Contract aprovado pode gerar 1+ envelopes (cancelamento permite reenvio).
model Envelope {
  id                  String    @id @default(cuid())
  // SUJEITO do envelope — exatamente um de (contractId | attachmentId |
  // proposalId). CHECK `envelope_subject_xor` na migration garante.
  contractId          String?
  attachmentId        String?
  proposalId          String?
  // PAI do envelope — exatamente um de (dealId | proposalId). Proposta vive
  // FORA do kanban, então um envelope de proposta não tem deal ainda (o deal
  // nasce só na conversão). CHECK `envelope_parent_xor` na migration.
  dealId              String?
  orgId               String
  // source: "contract" | "attachment" | "proposal". Discrimina a origem do
  // envelope no webhook close (categoria do anexo final) e na UI.
  source              String    @default("contract")
  // Só quando source="proposal": "completa" (via do proponente, com todos os
  // campos) | "reduzida" (via do proprietário, sem os hiddenPaths). O
  // @@unique([proposalId, via]) é o que torna o encadeamento das duas vias
  // fisicamente idempotente — webhook reentregue não cria um 2º envelope.
  via                 String?
  // ID retornado pela Clicksign (data.id no payload JSON:API). Nulo enquanto
  // a row local existe mas a chamada à API ainda não completou.
  clicksignId         String?   @unique
  name                String
  // status: draft | running | closed | canceled | failed
  status              String    @default("draft")
  // authMethod default aplicado a todos os signers (email | whatsapp | selfie | icp_brasil)
  authMethod          String    @default("email")
  documentClicksignId String?
  // Snapshot do PDF enviado (s3:// ou file://). Imutável após envio.
  documentUrl         String?
  // PDF assinado, baixado da Clicksign no evento close/auto_close.
  signedDocumentUrl   String?
  costCents           Int       @default(0)
  deadlineAt          DateTime?
  sentAt              DateTime?
  closedAt            DateTime?
  canceledAt          DateTime?
  lastError           String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  contract   Contract?        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  // Cascade (não SetNull): o CHECK `envelope_subject_xor` exige exatamente um
  // de (contractId, attachmentId, proposalId) não-nulo, então anular o
  // attachmentId de um envelope source="attachment" viola a constraint e o
  // delete do anexo (ou do deal inteiro) estoura 23514. O envelope só existe
  // por causa do anexo — sem ele não tem assunto. A rota DELETE do anexo
  // bloqueia com 409 quando há envelope closed/running, então a cascata só
  // alcança draft/canceled/failed.
  attachment DealAttachment?  @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  deal       Deal?            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  proposal   Proposal?        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  signers    EnvelopeSigner[]
  events     EnvelopeEvent[]
  documents  EnvelopeDocument[]

  @@unique([proposalId, via])
  @@index([contractId])
  @@index([attachmentId])
  @@index([proposalId])
  @@index([dealId])
  @@index([orgId, status])
  @@index([status, updatedAt])
}

// Documentos de UM envelope ClickSign. A v3 aceita N documentos por envelope e
// cobra POR SIGNATÁRIO (não por documento) — então contrato + laudo de vistoria
// no mesmo envelope custam metade de dois envelopes separados.
//
// `Envelope.documentClicksignId` PERMANECE como o documento `primary` (compat:
// envelopes criados antes desta tabela não têm rows aqui e continuam lidos pela
// coluna escalar). O CHECK `envelope_subject_xor` NÃO muda: o sujeito do
// envelope segue sendo um só (contrato | anexo | proposta); os documentos
// `attachment` são carga extra do mesmo envelope, não um segundo sujeito.
model EnvelopeDocument {
  id                  String   @id @default(cuid())
  envelopeId          String
  // `data.id` do documento na ClickSign (o mesmo valor que chega no webhook
  // como `document.key`).
  documentClicksignId String
  // "primary" = o sujeito do envelope (contrato/anexo/proposta).
  // "attachment" = documento EXTRA anexado ao mesmo envelope.
  kind                String   @default("primary")
  // DealAttachment de origem quando kind="attachment" (laudo de vistoria, etc.).
  // Escalar sem FK de propósito: o documento é um SNAPSHOT enviado à ClickSign e
  // não pode sumir do histórico do envelope se o anexo for apagado da pasta.
  sourceAttachmentId  String?
  filename            String
  // PDF assinado DESTE documento, gravado no close (o do primary continua
  // espelhado em `Envelope.signedDocumentUrl`).
  signedPdfUrl        String?
  position            Int      @default(0)
  createdAt           DateTime @default(now())

  envelope Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@unique([envelopeId, documentClicksignId])
  @@index([envelopeId])
  // Lookup do webhook: evento de um documento EXTRA traz o `document.key` dele,
  // que não bate com `Envelope.documentClicksignId`.
  @@index([documentClicksignId])
}

model EnvelopeSigner {
  id             String    @id @default(cuid())
  envelopeId     String
  clicksignId    String?
  // IDs dos requirements (auth + sign) criados via POST /requirements.
  // Guardamos pra poder remover/alterar depois sem refazer GET.
  requirementIds String[] @default([])
  // sourceKind: vendedor | comprador | testemunha | corretora | outro.
  // sourceIndex aponta o array em dataJson (sempre 0 para corretora).
  sourceKind     String
  sourceIndex    Int
  // Qualificação ClickSign ("Assina como": buyer/seller/witness/party/...).
  // Persistido pra exibir na aba Assinaturas e re-criar requirement em add.
  role           String?
  // Ordem de assinatura (group ClickSign v3). Null = paralelo (sem ordem).
  signingGroup   Int?
  name           String
  // NULLABLE desde as Propostas: o signatário do lado proprietário costuma vir
  // de PropertyOwner, cujo `email` é opcional e cujo canalPreferido default é
  // WhatsApp. Notificação por WhatsApp não exige e-mail. A correlação do
  // webhook NÃO depende mais do e-mail (usa signer.key → clicksignId).
  email          String?
  // CPF limpo (11 dígitos) ou CNPJ (14 dígitos) sem máscara.
  documentation  String?
  // E.164 COM DDI (+5511987654321). Obrigatório quando notifyChannel=whatsapp.
  phone          String?
  // Método de AUTENTICAÇÃO (requirement auth). Não confundir com notifyChannel.
  authMethod     String    @default("email")
  // Canal de NOTIFICAÇÃO — vira communicate_events.signature_request na v3
  // (email | whatsapp | sms | none). Eixo ortogonal ao authMethod.
  notifyChannel  String    @default("email")
  // `key` devolvida pela ClickSign na criação do signatário. Usada pra carregar
  // o widget de assinatura embedada na nossa landing.
  signatureKey   String?
  // status: pending | notified | viewed | signed | refused | removed | email_failed
  // email_failed = e-mail voltou (bounce); derivado do evento ClickSign
  // `tracking_notification_error` no feed REST /events (nunca via webhook).
  status         String    @default("pending")
  notifiedAt     DateTime?
  viewedAt       DateTime?
  signedAt       DateTime?
  refusedAt      DateTime?
  resendCount    Int       @default(0)
  lastResendAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  envelope Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([envelopeId])
  @@index([status])
}

// Trilha de auditoria de eventos (webhook + cron). Idempotência: o mesmo
// evento Clicksign reentregue não é processado duas vezes mas é registrado
// aqui para diagnóstico.
model EnvelopeEvent {
  id         String   @id @default(cuid())
  envelopeId String
  eventName  String
  payload    Json
  // source: webhook | cron | manual
  source     String   @default("webhook")
  // Idempotência: hash estável do evento (envelope+nome+signer+occurred_at).
  // ClickSign reentrega webhooks; o create com este @unique é o lock que
  // impede reprocessar `close`/`refusal` duas vezes (auto-promote de deal,
  // download de PDF, etc.). Nullable pra eventos legados/manuais sem chave.
  dedupeKey  String?  @unique
  receivedAt DateTime @default(now())

  envelope Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([envelopeId, receivedAt])
}

// ============================================
// PROPOSTAS (vendas + locação)
// ============================================
// A proposta é o passo ANTES do negócio: o proponente oferece um valor, o
// proprietário aceita ou não. Vive FORA do kanban (ver docs/locacao/spec.md
// §4.3) e, quando aceita, converte em Deal + SalesForm com o dataJson já
// preenchido — é o que elimina a redigitação.
//
// Por que não reusa `Contract`: `Contract` não tem `orgId`; o escopo de org de
// todo contrato é derivado via `deal.pipeline.orgId`. Tornar `Contract.dealId`
// nullable arrancaria o guard cross-org de todas as rotas de contrato. A
// Proposal carrega o próprio documento (os 6 campos abaixo espelham os do
// Contract). Consequência aceita: chat IA/versões/comentários não existem na
// proposta (esses models têm FK contractId NOT NULL).
model Proposal {
  id              String    @id @default(cuid())
  orgId           String
  // Dono da proposta. Sustenta a regra "corretor vê só as dele". IMUTÁVEL (o
  // criador), diferente do responsável comercial abaixo (reatribuível).
  userId          String
  // Responsável comercial (corretor). Editável e independente do criador.
  // responsibleUserId = corretor que é usuário da plataforma; responsibleName =
  // corretor NÃO-usuário (nome livre). Mutuamente exclusivos na prática.
  // Precedência de exibição: responsibleName ?? responsibleUser.name ?? user.name.
  responsibleUserId String?
  responsibleName   String?
  // Discriminador CANÔNICO. Não usar `kind` sozinho: SalesForm.schemaType tem
  // default "compra_venda_v1", então sem isto toda proposta de locação
  // convertida viraria um form de compra e venda (→ template errado → CCV
  // gerado para um aluguel). Locação comercial tem termos próprios (destinação,
  // luvas/ponto, ação renovatória arts. 51-57) — por isso são 3, não 2.
  // "compra_venda_v1" | "locacao_residencial_v1" | "locacao_comercial_v1"
  schemaType      String    @default("compra_venda_v1")
  // Derivado do schemaType. Persistido pra facilitar filtro/índice.
  kind            String    @default("venda") // venda | locacao
  // Código humano e estável: "PROP-<ano BRT>-<seq 4 dígitos>". Alocado no
  // create a partir de OrgSequence (contador por org+ano). Substitui o
  // `id.slice(-8)` que servia de "número" — ver lib/proposals/code.ts.
  // Nullable APENAS por causa do backfill (toda proposta nova nasce com um);
  // ler sempre via `proposalNumero()`, que cai no sufixo do id se faltar.
  code            String?
  title           String
  // rascunho | aguardando_aprovacao | enviada | entregue | visualizada |
  // assinada_proponente | aguardando_vendedor | completa | convertida |
  // recusada_proponente | recusada_vendedor | expirada | cancelada | falha_envio
  status          String    @default("rascunho")

  // ── Instrumento de aceite ────────────────────────────────────────────────
  // "aceite"   = Aceite via WhatsApp da ClickSign (~R$0,99, cobrado na ENTREGA;
  //              message ≤1500 chars, sem anexo → resumo + link pra landing).
  // "envelope" = assinatura ClickSign clássica (PDF + certificado).
  instrument      String    @default("envelope")
  // ID do acceptance_term na ClickSign (só quando instrument="aceite").
  acceptanceClicksignId String?

  // ── Documento (espelha Contract, sem reusar a tabela) ────────────────────
  templateId      String?
  version         Int       @default(1)
  dataJson        Json      @default("{}")
  htmlContent     String?   @db.Text
  googleDocId     String?
  googleDocUrl    String?
  googleDocStatus String?

  // ── Comissão e as duas vias ──────────────────────────────────────────────
  // A comissão é OPCIONAL na proposta. Só quando incluída E marcada como oculta
  // é que a proposta sai em duas vias (completa p/ o proponente, reduzida p/ o
  // proprietário) — e aí custa 2 envelopes. Sem ocultação: 1 via, 1 custo.
  comissaoIncluida Boolean  @default(false)
  // Dot-paths do dataJson suprimidos na via reduzida. Vêm de uma ALLOWLIST por
  // template — nunca dot-path arbitrário do cliente (senão quebra o Handlebars).
  hiddenPaths     String[]  @default([])

  // ── Link rastreado (/p/[token]) ──────────────────────────────────────────
  // randomBytes(32).base64url — NÃO cuid(): cuid v1 tem ~40 bits imprevisíveis
  // e é monotônico no tempo (conhecendo um token você conhece o prefixo dos
  // vizinhos). Este link entrega valor de imóvel, CPF e comissão.
  token           String    @unique
  validUntil      DateTime?
  // Prazo PRÓPRIO da 2ª via (proprietário), calculado no envio dela:
  // max(validUntil, agora + proposalOwnerDeadlineDays). A 2ª via herdava
  // validUntil, que na parada de decisão já podia estar vencido (bug C).
  vendedorDeadlineAt DateTime?
  sentAt          DateTime?
  // Snapshot CONGELADO no envio: o HTML exato (via completa) que o proponente
  // viu, + hash SHA-256. O comprovante e a página /p/[token] usam ISTO, nunca
  // re-renderizam o template atual (que pode mudar via sync-templates entre o
  // envio e o aceite) — senão o comprovante reproduz um documento que a pessoa
  // nunca viu, anulando o valor probatório.
  sentSnapshotHtml String?  @db.Text
  sentSnapshotHash String?
  // Só é confiável no modo "aceite" (a ClickSign cobra na entrega, logo sabe
  // dela). No modo "envelope" não há confirmação real de entrega.
  deliveredAt     DateTime?
  // "visualizada" REAL: vem do beacon client-side, não do GET. Crawler de
  // WhatsApp/Gmail busca a URL pra montar o card de preview e dispararia o GET.
  firstViewedAt   DateTime?
  lastViewedAt    DateTime?
  viewCount       Int       @default(0)
  lastReminderAt  DateTime?
  reminderCount   Int       @default(0)

  // ── Recusa e contraproposta ──────────────────────────────────────────────
  // Quem recusou importa: o proprietário recusar (desfecho mais comum) deixa um
  // COMPRADOR JÁ COMPROMETIDO na mão — é um estado quente, não um terminal frio.
  refusedBy       String?   // "proponente" | "vendedor:<ownerId>"
  refusedAt       DateTime?
  refusedReason   String?   @db.Text
  // Valor que o proprietário aceitaria. Alimenta a rodada seguinte.
  counterAmount   Float?
  // Self-FK: liga a thread da negociação. NÃO é "modelar negociação" (threads,
  // versões comparáveis seguem fora de escopo) — é um ponteiro que faz a lista
  // contar a história em vez de mostrar duplicatas soltas.
  parentProposalId String?
  round           Int       @default(1)
  supersededById  String?

  // ── Terminais ────────────────────────────────────────────────────────────
  expiredAt       DateTime?
  canceledAt      DateTime?
  completedAt     DateTime?
  // PDF consolidado das vias assinadas (merge via pdf-lib).
  // GUARD do buildDossier é `dossierUrl != null` — nunca `dossierBuiltAt`: um
  // timestamp de TENTATIVA como guard de SUCESSO transforma falha transitória
  // em corrupção permanente (dossiê vazio marcado como pronto).
  dossierUrl      String?
  dossierBuiltAt  DateTime?
  lastError       String?   @db.Text

  // ── Custo ────────────────────────────────────────────────────────────────
  // Reservado no /send com o custo TOTAL (incluindo a via reduzida, que só nasce
  // dias depois). Sem a reserva, o envelope 2 pode estourar o orçamento com o
  // proponente já tendo assinado e o dinheiro já gasto.
  reservedCostCents Int     @default(0)

  // ── Origem / cadastros prévios (todos opcionais) ─────────────────────────
  propertyId      String?
  leaseClientId   String?
  tenantId        String?
  crmRef          String?   // id no CRM externo (Superlógica) — lookup ainda stub
  source          String    @default("manual") // manual | crm | importada | max

  // ── Conversão em negócio ─────────────────────────────────────────────────
  convertedDealId String?   @unique
  convertedAt     DateTime?
  // O corretor fechou no telefone e converteu sem esperar assinatura. Exige
  // motivo (audit) e marca o card no kanban.
  convertedWithoutSignature Boolean @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org            Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id])
  responsibleUser User?               @relation("ProposalResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  template       ContractTemplate?    @relation(fields: [templateId], references: [id])
  property       Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  leaseClient    LeaseClient?         @relation(fields: [leaseClientId], references: [id], onDelete: SetNull)
  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  convertedDeal  Deal?                @relation("ProposalConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)
  parentProposal Proposal?            @relation("ProposalThread", fields: [parentProposalId], references: [id], onDelete: SetNull)
  children       Proposal[]           @relation("ProposalThread")
  signers        ProposalSigner[]
  attachments    ProposalAttachment[]
  events         ProposalEvent[]
  envelopes      Envelope[]

  @@unique([orgId, code])
  @@index([orgId, status])
  // Lista/KPIs filtram sempre por (org, tipo, status) — venda × locação.
  @@index([orgId, kind, status])
  @@index([orgId, userId])
  @@index([orgId, responsibleUserId])
  @@index([status, validUntil])
  @@index([propertyId, status])
  @@index([parentProposalId])
}

// Signatários da proposta. Model próprio (não dataJson) porque é o que dá, de
// uma vez: seleção de quais proprietários assinam, custo recalculado ao vivo,
// dedupe com backstop no banco, e preflight por linha.
model ProposalSigner {
  id            String   @id @default(cuid())
  proposalId    String
  // proponente | vendedor | conjuge | testemunha
  role          String
  // FK lógica pra PropertyOwner quando role=vendedor (sem constraint: o dono
  // pode ter sido digitado à mão, sem cadastro).
  ownerId       String?
  name          String
  // Opcional: PropertyOwner.email é nullable e canalPreferido default é WhatsApp.
  email         String?
  cpf           String?
  phone         String?  // E.164 COM DDI
  // Copiado de PropertyOwnership.percentual no momento do envio. Se a soma dos
  // que assinaram < 100%, a proposta NÃO vincula os demais proprietários e o
  // status jamais pode ser exibido como "Completa".
  percentual    Float?
  // 1 = proponente · 2 = proprietários. A ordem é regra de negócio, não opção.
  signingGroup  Int      @default(1)
  notifyChannel String   @default("email") // email | whatsapp | sms
  included      Boolean  @default(true)
  // cpf → email lowercase → nome normalizado + phone. O @@unique abaixo é o
  // backstop da regra "sem duplicidade": hoje o mesmo CPF duas vezes no envelope
  // gera COBRANÇA DOBRADA e deixa o webhook marcando um dos dois ao acaso.
  dedupeKey     String
  // ── Rastreio do Aceite via WhatsApp por signatário ──────────────────────
  // Antes o id do acceptance_term ficava só em Proposal.acceptanceClicksignId
  // (o do 1º signatário iterado), então: (a) retry re-enviava a TODOS
  // duplicando cobrança, (b) casal virava "completa" com 1 aceite, (c) recusa
  // de um caía em unknownAcceptance. Agora cada linha guarda seu próprio id +
  // desfecho, e o @unique torna o envio idempotente por signatário.
  acceptanceClicksignId String?  @unique
  acceptanceStatus      String?  // sent | completed | refused | expired
  acceptedAt            DateTime?
  refusedAt             DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, dedupeKey])
  @@index([proposalId])
}

// Anexos da proposta. Necessário porque DealAttachment.dealId é NOT NULL — o
// PDF assinado de um envelope de proposta não teria onde pousar (não há deal
// ainda). Na conversão viram DealAttachment copiando url/contentHash, sem
// re-upload: é o mesmo blob.
model ProposalAttachment {
  id          String   @id @default(cuid())
  proposalId  String
  filename    String
  mime        String
  url         String
  // proposta_assinada_completa | proposta_assinada_reduzida | dossie | documento
  // | aceite_comprovante          (comprovante que NÓS montamos — acceptance-proof.ts)
  // | aceite_registro_clicksign   (Registro do Aceite OFICIAL da ClickSign: provas
  //                                de identidade + mensagens. A API v3 não expõe
  //                                link de download, então hoje chega por upload
  //                                manual; acceptance-record-sync.ts tenta pegar
  //                                sozinho caso a ClickSign passe a devolver.)
  category    String?
  source      String   @default("manual") // manual | clicksign_signed | clicksign_acceptance | dossier
  contentHash String?
  byteSize    Int?
  createdAt   DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([contentHash])
}

// Timeline append-only. Separa `fetched` (bot/crawler buscou a URL) de `viewed`
// (humano abriu, via beacon) — sem essa distinção, o crawler do WhatsApp marca
// toda proposta como visualizada segundos após o envio.
model ProposalEvent {
  id         String   @id @default(cuid())
  proposalId String
  // sent | delivered | fetched | viewed | signed_proponente | chained_envelope2
  // | closed | refused | expired | canceled | converted | reminder_sent
  // | revival_requested | status_transition_rejected
  // | acceptance_term_{sent,completed,refused,expired,canceled}
  // | acceptance_term_fetched  (resposta CRUA do GET do aceite na ClickSign —
  //                             é o registro que permite descobrir campos não
  //                             documentados contra a conta real)
  eventName  String
  payload    Json?
  source     String   @default("system") // system | public | webhook | cron | api
  // sha256(ip + AUTH_SECRET) — NUNCA o IP cru (LGPD).
  ipHash     String?
  userAgent  String?
  receivedAt DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, receivedAt])
}

// ============================================
// NEWTON — INTEGRAÇÃO COM AGENTE EXTERNO
// ============================================

// Token de API por usuário, com escopos. Hash SHA-256 armazenado, valor cru
// retornado uma única vez no momento da criação. Newton (e qualquer cliente
// externo no futuro) usa via header `Authorization: Bearer <token>`.
//
// Escopos suportados (string livre validada na app):
//   "deals:rw" | "contracts:rw" | "charges:rw" | "signatures:rw"
//   | "documents:rw" | "metrics:r"
model UserApiToken {
  id          String    @id @default(cuid())
  userId      String
  name        String // label humano: "Newton (VPS prod)"
  hashedToken String    @unique // sha256(rawToken) — lookup direto
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionIntents ActionIntent[]

  @@index([userId, revokedAt])
}

// Idempotência por chamada externa. Cliente envia `X-Idempotency-Key` em
// POST/PATCH/DELETE; servidor garante que mesmo (userId, key) retorna a
// mesma resposta dentro de 24h. Evita duplicação em retry de Newton.
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  key          String // valor do header X-Idempotency-Key
  method       String // POST | PATCH | DELETE
  path         String // path da rota chamada
  statusCode   Int
  responseHash String // sha256 do body de resposta (não armazena resposta inteira)
  responseBody Json? // resposta cacheada para replay (TTL 24h)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt]) // para job de cleanup TTL 24h
}

// ActionIntent — human-in-the-loop para ações high-risk vindas via Bearer.
//
// Diferente de DualApproval (segregação de funções, initiator≠approver),
// aqui o dono do token tipicamente também aprova. Semântica: "agente quis
// fazer X, humano tem que aprovar antes do servidor executar".
//
// status: pending | approved | rejected | executed | expired | failed
// action: CHARGE_CREATE | ENVELOPE_SEND | CONTRACT_APPROVE | DEAL_DELETE_HARD
//
// payloadHash = sha256(canonical(payload)) — re-conferido em executeIntent
// para detectar tampering entre approve e execute.
model ActionIntent {
  id              String    @id @default(cuid())
  orgId           String
  requestedBy     String // userId que disparou (token owner ou session user)
  actorVia        String // "session" | "bearer"
  tokenId         String? // FK UserApiToken — null se session
  action          String
  payload         Json // input validado, congelado
  payloadHash     String // sha256 — anti-tamper
  preview         Json // snapshot do que vai acontecer (taxas/splits/signers)
  status          String    @default("pending")
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?   @db.Text
  executedAt      DateTime?
  expiresAt       DateTime
  idempotencyKey  String? // se intent foi criada com X-Idempotency-Key
  resultJson      Json?
  errorMessage    String?   @db.Text
  createdAt       DateTime  @default(now())

  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requester User          @relation("IntentRequester", fields: [requestedBy], references: [id])
  approver  User?         @relation("IntentApprover", fields: [approvedBy], references: [id])
  token     UserApiToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@unique([requestedBy, idempotencyKey])
  @@index([orgId, status, expiresAt])
  @@index([requestedBy, createdAt])
}

// ApiUsage — granular telemetry de chamadas Newton API.
// Capturado por `withApi` wrapper em route handlers — uma linha por request.
// TTL 90 dias (cleanup cron diário).
model ApiUsage {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  tokenId    String? // null se via=session
  via        String // "session" | "bearer"
  method     String // GET | POST | PATCH | DELETE
  path       String // normalizado: /api/deals/:id (sem id real, evita cardinalidade)
  statusCode Int
  latencyMs  Int
  errorCode  String? // "scope_missing" | "etag_mismatch" | "rate_limited" | etc
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([tokenId, createdAt])
  @@index([path, createdAt])
}

// ============================================
// LOCAÇÃO — administração de aluguéis (docs/locacao/spec.md)
// ============================================
// Aditivo. Entidades org-scoped (orgId direto + índices compostos). Links a
// models existentes (Contract, CommissionCharge, AsaasTransfer, Deal, Envelope)
// são scalar IDs SEM FK — mantém a migration contida; FKs podem ser adicionadas
// depois. Relações reais só entre entidades novas + Organization.

// Proprietário (cadastro unificado PF/PJ). Dados bancários p/ repasse.
model PropertyOwner {
  id                    String   @id @default(cuid())
  orgId                 String
  tipoPessoa            String   @default("fisica") // fisica | juridica
  nome                  String
  cpfCnpj               String
  email                 String?
  phone                 String?
  // Repasse
  pixKey                String?
  pixKeyType            String? // CPF|CNPJ|EMAIL|PHONE|EVP
  bankName              String?
  bankBranch            String?
  bankAccount           String?
  bankAccountType       String? // corrente|poupanca
  // Split nativo Asaas quando o proprietário tem wallet própria.
  asaasWalletId         String?
  // Preferências
  canalPreferido        String?  @default("whatsapp") // whatsapp|email|sms
  repasseDia            Int?
  antecipacaoHabilitada Boolean  @default(false)
  dataJson              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  org               Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerships        PropertyOwnership[]
  leaseAngariadores LeaseAngariador[]

  @@unique([orgId, cpfCnpj])
  @@index([orgId])
}

// Inquilino (cadastro unificado PF/PJ). Ficha reutilizável entre locações.
// Múltiplos locatários por contrato via LeaseTenant (Superlógica A2).
model Tenant {
  id         String   @id @default(cuid())
  orgId      String
  tipoPessoa String   @default("fisica") // fisica | juridica
  nome       String
  cpfCnpj    String
  email      String?
  phone      String?
  dataJson   Json? // ficha (cônjuge, renda declarada, endereço, etc)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org            Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseTenants   LeaseTenant[]
  debtAgreements DebtAgreement[]
  creditAnalyses CreditAnalysis[]
  proposals      Proposal[]

  @@unique([orgId, cpfCnpj])
  @@index([orgId])
}

// Imóvel — entidade primária com ciclo de vida próprio (status ortogonal ao
// funil de negócio). Substitui o uso inline de `imoveis[]` do DadosContrato.
// Ownership N:N via PropertyOwnership (achado Superlógica A1, 28/05).
model Property {
  id                   String   @id @default(cuid())
  orgId                String
  // `kind` cobre ~45 tipos do Superlógica (A6): casa|apartamento|apartamento_duplex|
  // apartamento_triplex|cobertura|garden|loft|studio|kitnet|penthouse|flat|sobrado|
  // casa_em_condominio|casa_assobradada|casa_comercial|galpao|sala_comercial|loja|
  // salao|pavilhao|box_garagem|conjunto|andar_corporativo|edicula|bangalo|barracao|
  // chacara|sitio|rancho|fazenda|haras|pousada|hotel|resort|quiosque|ponto|ilha|
  // laje|escritorio|consultorio|predio|terreno|village|outro
  kind                 String   @default("apartamento")
  status               String   @default("disponivel") // disponivel|anunciado|em_negociacao|locado|manutencao|fora_catalogo
  // DIMOB (A15): código no TXT RFB difere entre urbano e rural.
  tipoDimob            String   @default("urbano") // urbano | rural
  // Endereço estruturado
  rua                  String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  uf                   String?
  cep                  String?
  // Registro
  matricula            String?
  cartorio             String?
  inscricaoIptu        String?
  area                 Float?
  atributos            Json? // quartos/vagas/mobiliado — específico por kind
  fotos                String[] @default([])
  descricaoIa          String?  @db.Text
  valorAluguelSugerido Float?
  // Envelope (ClickSign) da autorização de captação — scalar, sem FK.
  captacaoEnvelopeId   String?
  // Origem externa (import de CRM): "ilist" quando importado da RexAPI RE/MAX.
  // `crmId` = IListListing.ilistId (Property.ID da RexAPI, string composta) —
  // chave de dedupe do import (re-importar o mesmo listing → 409).
  source               String?
  crmId                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org               Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerships        PropertyOwnership[]
  leaseContracts    LeaseContract[]
  inspections       Inspection[]
  insurancePolicies InsurancePolicy[]
  maintenances      Maintenance[]
  expenses          Expense[]
  proposals         Proposal[]

  @@index([orgId, status])
  @@index([orgId, source, crmId])
}

/// iList/RexAPI (Gryphtech RE/MAX) — vínculo do tenant com sua região e
/// office(s). Provisionado EXCLUSIVAMENTE pelo super-admin (/admin): a
/// credencial da RexAPI é global da plataforma (env ILIST_*) e o token acessa
/// todas as regiões, então o isolamento entre tenants é 100% server-side a
/// partir desta row. Sem row (ou enabled=false) a org não vê nada do iList.
model IListConnection {
  id             String    @id @default(cuid())
  orgId          String    @unique
  regionId       Int // região RE/MAX (56..96; 71 = QA Gryphtech)
  // OfficeIDs (GryphTech) selecionados pelo admin. PUT exige min 1 — o default
  // vazio existe só pra evitar drift de array (feedback_prisma_array_default_drift).
  officeIds      Int[]     @default([])
  enabled        Boolean   @default(true) // kill-switch sem apagar o espelho
  syncStatus     String    @default("pending") // pending | syncing | ok | error
  lastSyncAt     DateTime?
  lastSyncError  String?   @db.Text
  // Maior ModifiedDate visto no delta-sync (cursor incremental).
  lastCursor     DateTime?
  // Última reconciliação completa (marca deletedAt nos listings ausentes).
  lastFullSyncAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  listings IListListing[]
}

/// Espelho local org-scoped dos listings da RexAPI — índice de busca do picker
/// (a API não tem busca textual). `raw` guarda o Property bruto do LIST
/// endpoint (nunca associates — respostas de associate contêm IListCredentials
/// com senha em claro e são redigidas no client). Descrição/fotos são buscadas
/// lazy no momento do import, não no sync.
model IListListing {
  id              String    @id @default(cuid())
  orgId           String
  connectionId    String
  // Property.ID da RexAPI — STRING composta (ex. "710031017-6"), estável;
  // chave de dedupe. ExternalID pode ser vazio/duplicado — nunca unique.
  ilistId         String
  externalId      String?
  listingCode     String? // ListingID público (o código que o corretor conhece)
  officeId        Int
  associateId     Int?
  transactionType Int // 261 For Sale | 260 For Rent/Lease
  listingStatus   Int // 160 Active, 168 Sale Agreed, 169 Sold, 167 Rented, 161 Cancelled...
  propertyTypeUid Int?
  price           Decimal?  @db.Decimal(14, 2) // null quando sentinela -999
  currency        String?
  bedrooms        Int?
  bathrooms       Int?
  builtArea       Float?
  lotSizeM2       Float?
  parkingSpaces   Int?
  yearBuilt       Int?
  comTotalPct     Float?
  comBuyAgentPct  Float?
  // Desnormalizado pro card/busca (resolvido no sync)
  streetName      String?
  streetNumber    String?
  postalCode      String?
  cityId          Int?
  city            String? // resolvido via IListGeoCity (o Property só tem CityID)
  uf              String? // sigla via PROVINCE_TO_UF; sem match → null (nunca chutar)
  associateName   String?
  associateCreci  String? // SalesLicenseNumber
  coverImageUrl   String? // preenchida lazy no primeiro import (cache)
  // lower(listingCode + endereço + cidade + corretor) — busca via contains.
  searchText      String    @db.Text
  raw             Json
  modifiedAt      DateTime?
  deletedAt       DateTime? // marcado no full resync quando some da API
  syncedAt        DateTime  @default(now())

  connection IListConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, ilistId])
  @@index([orgId, transactionType, listingStatus, deletedAt])
  @@index([orgId, listingCode])
}

/// Cache global de geodata da RexAPI (dado público da região, não org-scoped).
/// Populado por warmGeoCache(regionId) no provisioning/full-sync.
model IListGeoCity {
  regionId     Int
  cityId       Int
  cityName     String
  provinceName String
  uf           String?

  @@id([regionId, cityId])
}

// Contrato de locação ATIVO (distinto do `Contract`/Google Doc, que é o
// instrumento assinado). Carrega o ciclo de vida recorrente.
// Tenants N:N via LeaseTenant (Superlógica A2). Campos fiscais/operacionais
// A5/A7-A13/A16 vieram da inspeção do form HTML do Superlógica (28/05).
model LeaseContract {
  id               String    @id @default(cuid())
  orgId            String
  propertyId       String
  // Instrumento assinado + Deal de origem — scalar, sem FK.
  contractId       String?
  dealId           String?
  status           String    @default("rascunho") // rascunho|assinatura|ativo|renovacao|rescisao|encerrado
  // Finalidade do contrato (A5): residencial|nao_residencial|comercial|industria|temporada|por_encomenda|mista
  finalidade       String    @default("residencial")
  valorAluguel     Float
  valorEncargos    Float     @default(0) // iptu/condominio embutidos
  diaVencimento    Int       @default(10)
  indiceReajuste   String    @default("IGPM") // IGPM|IPCA|outro
  vigenciaInicio   DateTime?
  vigenciaFim      DateTime?
  taxaAdminPercent Float     @default(10)

  // Regime de cobrança (A10): quando emitir o boleto vs competência.
  regimeCobranca String @default("mes_a_vencer") // mes_vencido | mes_a_vencer
  // Retenção de IR sobre aluguel (A7) — afeta cálculo de repasse e DIMOB.
  regimeIr       String @default("nao_retem") // nao_retem | retem_sem_controle | retem_imobiliaria | retem_inquilino

  // Repasse (A9): tipo de cálculo do dia de repasse.
  repasseTipo      String @default("dias_uteis_apos") // dias_uteis_apos | dias_corridos_apos | dia_fixo
  repasseDia       Int?
  repasseSplitJson Json?

  // Repasse garantido (A8) — produto premium: imobiliária paga o proprietário
  // mesmo se o inquilino não pagar. Diferente de `Guarantee` (proteção contra
  // o inquilino); isto é uma garantia COMERCIAL da imobiliária.
  repasseGarantido       String  @default("nao") // nao | alguns_meses | todo_contrato
  repasseGarantidoMeses  Int?
  repasseGarantidoEscopo String? // boleto | aluguel | aluguel_ir | garantidos

  // Isenção de multa rescisória (A12) — janela inicial sem multa.
  isencaoMultaMeses Int?

  // Endereço de cobrança do boleto (A13).
  enderecoCobrancaTipo String @default("imovel") // imovel | locatario | outro
  enderecoCobrancaJson Json? // override quando tipo="outro"

  // Flag de emissão de NFS-e por repasse (A16). Detalhes em §7.5.
  emitirNfse Boolean @default(false)

  dataJson  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reajuste (F2): data prevista do próximo reajuste — alimenta o card
  // "Reajustes do mês" no dashboard e o cron `rent/readjust`. Default: 12 meses
  // após `vigenciaInicio` (calculado pelo app na criação).
  dataProximoReajuste DateTime?

  org               Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property          Property            @relation(fields: [propertyId], references: [id])
  tenants           LeaseTenant[]
  angariadores      LeaseAngariador[]
  guarantee         Guarantee?
  rentCharges       RentCharge[]
  inspections       Inspection[]
  expenses          Expense[]
  checklists        Checklist[]
  debtAgreements    DebtAgreement[]
  insurancePolicies InsurancePolicy[]
  maintenances      Maintenance[]
  readjustments     LeaseReadjustment[]

  @@index([orgId, status])
  @@index([propertyId])
  @@index([orgId, dataProximoReajuste])
}

// Cobrança mensal de aluguel — materializada pelo cron `rent/generate`.
// `commissionChargeId` aponta pro CommissionCharge{kind:"aluguel"} (Asaas).
// `kind` distingue aluguel vs acordo vs extra vs encargo (A18).
model RentCharge {
  id                 String    @id @default(cuid())
  orgId              String
  leaseContractId    String
  kind               String    @default("aluguel") // aluguel | acordo | extra | encargo
  debtAgreementId    String?
  competencia        String // YYYY-MM
  dueDate            DateTime
  valorBase          Float
  encargos           Float     @default(0)
  multa              Float     @default(0)
  juros              Float     @default(0)
  status             String    @default("pendente") // pendente|emitida|paga|atrasada|cancelada|repassada
  // Links a Asaas — scalar, sem FK.
  commissionChargeId String?
  repasseTransferId  String?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseContract LeaseContract  @relation(fields: [leaseContractId], references: [id], onDelete: Cascade)
  debtAgreement DebtAgreement? @relation(fields: [debtAgreementId], references: [id], onDelete: SetNull)
  expenses      Expense[]

  @@unique([leaseContractId, competencia, kind])
  @@index([orgId, competencia])
  @@index([orgId, status])
  @@index([debtAgreementId])
}

// Garantia locatícia (1:1 com LeaseContract). Fase 1 via parceiros.
// Tipos ampliados pra paridade Superlógica (A3, 7 valores) + subtipo de caução (A4).
model Guarantee {
  id              String   @id @default(cuid())
  orgId           String
  leaseContractId String   @unique
  // A3: caucionante|caucao|cessao_fiduciaria|fiador|seguro_fianca|titulo_capitalizacao|sem_garantia
  tipo            String
  // A4: quando tipo=caucao: valor|veiculo|carta_fianca|imovel|outros
  caucaoSubtipo   String?
  provider        String? // credpago|garantti|creditas|porto|...
  // Lifecycle novo: pendente|em_analise|aprovada|vigente|executada|finalizada.
  // Rows antigas ainda carregam os legados ativa|acionada|encerrada|recusada (UI mapeia label).
  status          String   @default("pendente")
  coberturaMeses  Int?
  custoJson       Json?
  externalRef     String?
  fiadorPartyJson Json?
  dadosJson       Json? // payload por modalidade (caução: banco/conta/data; capitalização: valorTitulo; etc.)
  documentoPdfUrl String? // termo/apólice/título no Blob
  historicoJson   Json? // snapshots de garantias substituídas [{snapshot, substituidaEm, motivo}]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseContract LeaseContract @relation(fields: [leaseContractId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

// Análise de crédito do inquilino. Versionada por tentativa. shapJson p/ F2.
model CreditAnalysis {
  id                   String   @id @default(cuid())
  orgId                String
  tenantId             String
  leaseDealId          String? // Deal de locação — scalar
  status               String   @default("pendente") // pendente|aprovado|aprovado_com_garantia|analise_manual|recusado
  scoreBureau          Int?
  scoreInterno         Int?
  decisionJson         Json?
  shapJson             Json?
  openFinanceConsentId String?
  biometriaJson        Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([tenantId])
}

// Cliente/prospect de locação — cadastro leve ANTES de virar Deal/Tenant.
// Separado de Tenant (que só nasce num deal): aqui o operador registra um lead
// com campos do formulário (todos opcionais) e acompanha crédito + fiança +
// certidões + documentos. `createdByUserId` = "quem cadastrou". Ver plano
// project_locacao_clientes.
model LeaseClient {
  id              String   @id @default(cuid())
  orgId           String
  createdByUserId String
  tipoPessoa      String   @default("fisica") // fisica | juridica
  nome            String
  cpfCnpj         String?
  email           String?
  phone           String?
  // Origem do cadastro. "form" reservado pra ingestão futura via formulário.
  source          String   @default("manual") // manual | crm | form
  crmId           String? // id no CRM externo (usado pelo import por ID)
  status          String   @default("novo") // novo|em_analise|aprovado|reprovado|convertido|arquivado
  // Ficha espelhando os campos opcionais do form de locação (rg, nascimento,
  // endereço, renda, cônjuge, etc). Aditivo — sem shape rígido.
  dataJson        Json?
  // Consentimento LGPD pra consulta Serasa — mesmo shape de Deal.complianceJson.
  complianceJson  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org             Organization                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy       User                         @relation(fields: [createdByUserId], references: [id])
  attachments     LeaseClientAttachment[]
  insurerAnalyses LeaseClientInsurerAnalysis[]
  certidaoJobs    CertidaoJob[]
  proposals       Proposal[]

  @@index([orgId, createdAt])
  @@index([orgId, status])
  @@index([orgId, cpfCnpj])
}

// Documento do cliente (RG, comprovante de renda, PDF de certidão gerado, etc).
// Espelha LeadAttachment. `certidaoJobId` liga o PDF ao job que o gerou (o FK
// CertidaoJob.attachmentId aponta pra DealAttachment e não serve pra cliente).
model LeaseClientAttachment {
  id            String   @id @default(cuid())
  leaseClientId String
  filename      String
  mime          String
  url           String
  category      String? // "rg" | "comprovante_renda" | "certidao" | "serasa" | etc
  contentHash   String? // SHA-256 — dedupe por conteúdo
  byteSize      Int?
  certidaoJobId String? // job de certidão/serasa que originou o PDF (quando aplicável)
  createdAt     DateTime @default(now())

  leaseClient LeaseClient @relation(fields: [leaseClientId], references: [id], onDelete: Cascade)

  @@index([leaseClientId])
  @@index([contentHash])
  @@index([certidaoJobId])
}

// Análise de fiança por seguradora (1 linha por seguradora). Status manual nesta
// entrega; resultJson/externalRef/premioMensal preparam a integração real futura.
model LeaseClientInsurerAnalysis {
  id              String   @id @default(cuid())
  orgId           String
  leaseClientId   String
  seguradora      String // credpago | porto | garantti | creditas | outro
  status          String   @default("pendente") // pendente|enviado|em_analise|aprovado|aprovado_com_restricao|recusado
  premioMensal    Float?
  resultJson      Json?
  externalRef     String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseClient LeaseClient  @relation(fields: [leaseClientId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdByUserId], references: [id])

  @@index([leaseClientId])
  @@index([orgId])
}

// Vistoria (entrada/saída/contra). Laudo PDF + QR + assinatura ClickSign.
model Inspection {
  id              String   @id @default(cuid())
  orgId           String
  propertyId      String
  leaseContractId String?
  tipo            String // entrada|saida|contra
  tipoImovel      String?
  status          String   @default("rascunho") // rascunho|em_campo|laudo_gerado|assinatura|concluida
  checklistJson   Json?
  ambientesJson   Json? // [{ambiente,fotos[],audio,descricaoIa,estado}]
  comparacaoJson  Json?
  laudoPdfUrl     String?
  // "gerado" = PDF renderizado a partir de ambientesJson (rota /laudo);
  // "externo" = PDF pronto enviado por upload (vistoria feita fora do sistema).
  laudoOrigem     String   @default("gerado")
  qrToken         String?  @unique
  // Envelope (ClickSign) do laudo — scalar, sem FK.
  envelopeId      String?
  executorId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property      Property       @relation(fields: [propertyId], references: [id])
  leaseContract LeaseContract? @relation(fields: [leaseContractId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([propertyId])
  @@index([envelopeId])
}

// ============================================
// LOCAÇÃO — Entidades Superlógica-parity (28/05)
// Adicionadas após verificação live em apps.superlogica.net (4 propr. × 25%,
// 2 locatários solidários, checklist instanciado). Ver docs/locacao/spec.md §4.4-§4.5.
// ============================================

// PropertyOwnership — relação N:N owner↔property com percentual (A1).
// Substitui o `Property.ownerId` 1:1. Soma de `percentual` por propertyId = 100
// (refine Zod, não SQL). Tipo distingue principal/secundário/beneficiário.
model PropertyOwnership {
  id         String   @id @default(cuid())
  orgId      String
  propertyId String
  ownerId    String
  percentual Float    @default(100)
  tipo       String   @default("proprietario") // proprietario_principal | proprietario | beneficiario
  createdAt  DateTime @default(now())

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    PropertyOwner @relation(fields: [ownerId], references: [id])

  @@unique([propertyId, ownerId])
  @@index([orgId, propertyId])
}

// LeaseTenant — relação N:N tenant↔lease (A2). Múltiplos locatários respondem
// solidariamente pela dívida (Lei 8.245 art.2).
model LeaseTenant {
  id              String   @id @default(cuid())
  orgId           String
  leaseContractId String
  tenantId        String
  tipo            String   @default("solidario") // titular | solidario
  createdAt       DateTime @default(now())

  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseContract LeaseContract @relation(fields: [leaseContractId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([leaseContractId, tenantId])
  @@index([orgId, leaseContractId])
}

// LeaseAngariador — corretor captador com comissão recorrente sobre aluguel (A11).
// mesesComissao=null significa "por todo o contrato".
model LeaseAngariador {
  id              String   @id @default(cuid())
  orgId           String
  leaseContractId String
  partyId         String // PropertyOwner (cadastro PF/PJ) usado como corretor.
  formaComissao   String   @default("percentual") // percentual | valor_fixo
  percentual      Float?
  valorFixo       Float?
  mesesComissao   Int?
  createdAt       DateTime @default(now())

  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseContract LeaseContract @relation(fields: [leaseContractId], references: [id], onDelete: Cascade)
  party         PropertyOwner @relation(fields: [partyId], references: [id])

  @@index([orgId, leaseContractId])
}

// Expense — despesa operacional first-class (A17/D2). Núcleo da contabilidade:
// IPTU parcelado 10x, condomínio variável, seguro, multa/juros/honorários, etc.
// Quando rentChargeId setado, aparece NO boleto do locatário. debitoDe/creditoPara
// definem se afeta o repasse ao proprietário.
model Expense {
  id              String    @id @default(cuid())
  orgId           String
  leaseContractId String?
  propertyId      String?
  // type cobre 12 valores: iptu|condominio|seguro_incendio|seguro_fianca|juros|
  // multa|honorarios|atualizacao_monetaria|custas|moratorios|taxa_locacao|outro
  type            String
  descricao       String?
  valor           Float
  dueDate         DateTime
  parcelaN        Int       @default(1)
  parcelaTotal    Int       @default(1)
  debitoDe        String // locatario | proprietario
  creditoPara     String // proprietario | imobiliaria | fornecedor
  rentChargeId    String?
  fornecedorId    String? // PropertyOwner com tipo "fornecedor" (scalar; sem FK estrita).
  status          String    @default("pendente") // pendente | pago | cancelado
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseContract LeaseContract? @relation(fields: [leaseContractId], references: [id], onDelete: SetNull)
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  rentCharge    RentCharge?    @relation(fields: [rentChargeId], references: [id], onDelete: SetNull)

  @@index([orgId, dueDate, status])
  @@index([leaseContractId, status])
  @@index([rentChargeId])
}

// ChecklistTemplate — modelos reutilizáveis ("Entrada", "Renovação", "Rescisão").
// itensJson: [{ titulo, obrigatorio, descricao? }].
model ChecklistTemplate {
  id        String   @id @default(cuid())
  orgId     String
  nome      String
  itensJson Json
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  checklists Checklist[]

  @@unique([orgId, nome])
}

// Checklist — instância de ChecklistTemplate por LeaseContract.
// itensJson: [{ titulo, status: pendente|concluido|aprovado, responsavel?, concluidoAt? }].
model Checklist {
  id              String    @id @default(cuid())
  orgId           String
  leaseContractId String
  templateId      String?
  nome            String
  status          String    @default("pendente") // pendente | em_andamento | aguardando_aprovacao | concluido
  itensJson       Json
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  org           Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseContract LeaseContract      @relation(fields: [leaseContractId], references: [id], onDelete: Cascade)
  template      ChecklistTemplate? @relation(fields: [templateId], references: [id])

  @@index([orgId, status])
  @@index([leaseContractId, status])
}

// DebtAgreement — acordo de dívida (parcelamento de inadimplência).
// componentesJson: { aluguel, multa, juros, honorarios, custas, atualizacao }.
// Parcelas viram RentCharge { kind="acordo", debtAgreementId }.
model DebtAgreement {
  id              String   @id @default(cuid())
  orgId           String
  leaseContractId String
  tenantId        String
  valorTotal      Float
  componentesJson Json
  parcelas        Int
  primeiraDataDue DateTime
  status          String   @default("ativo") // ativo | concluido | quebrado | cancelado
  createdAt       DateTime @default(now())

  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseContract LeaseContract @relation(fields: [leaseContractId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  rentCharges   RentCharge[]

  @@index([orgId, status])
}

// InsurancePolicy — apólice de seguro (incêndio/fiança/conteúdo/RD).
// responsavelPagamento (A14): quem paga o prêmio (imobiliária/locatário/proprietário).
// Index (orgId, vigenciaFim, status) p/ dashboard "Seguros vencidos próx. 60d".
model InsurancePolicy {
  id                   String   @id @default(cuid())
  orgId                String
  leaseContractId      String?
  propertyId           String?
  tipo                 String // seguro_incendio | seguro_fianca | conteudo | rd
  seguradora           String
  apoliceNumero        String?
  vigenciaInicio       DateTime
  vigenciaFim          DateTime
  premioMensal         Float?
  responsavelPagamento String? // imobiliaria | locatario | proprietario
  coberturaJson        Json? // {coberturaValor, basicas[], adicionais[]} (wizard de contratação)
  status               String   @default("ativa") // cotacao | em_analise | pendente | ativa | vencida | cancelada
  pdfUrl               String?
  origem               String   @default("manual") // manual | api (integração futura com seguradora)
  externalRef          String? // id da cotação/apólice na seguradora (futuro)
  // Primeira Expense mensal gerada pelo wizard — scalar, sem FK (padrão Maintenance.expenseId).
  expenseId            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseContract LeaseContract? @relation(fields: [leaseContractId], references: [id], onDelete: SetNull)
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([orgId, vigenciaFim, status])
}

// Maintenance — solicitação de reparo no imóvel.
// Quando debitoDe setado e status=concluida → cria Expense (linkada via expenseId).
model Maintenance {
  id              String    @id @default(cuid())
  orgId           String
  propertyId      String
  leaseContractId String?
  tipo            String // hidraulica | eletrica | pintura | estrutural | eletrodomestico | outro
  descricao       String    @db.Text
  fornecedorId    String?
  status          String    @default("solicitada") // solicitada | em_andamento | concluida | cancelada
  custoEstimado   Float?
  custoFinal      Float?
  debitoDe        String? // proprietario | locatario
  expenseId       String?
  abertaEm        DateTime  @default(now())
  concluidaEm     DateTime?

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property      Property       @relation(fields: [propertyId], references: [id])
  leaseContract LeaseContract? @relation(fields: [leaseContractId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([propertyId, status])
}

// LeaseReadjustment (Fase 2) — histórico de reajustes do contrato.
// Fluxo: cron mensal busca contratos com `dataProximoReajuste` no mês,
// calcula via API IGPM/IPCA (FGV/IBGE), cria row em status "proposto"
// → gestor aprova/recusa → cria nova `LeaseReadjustment status="aplicado"`
// e atualiza `LeaseContract.valorAluguel` + `dataProximoReajuste` (+12 meses).
model LeaseReadjustment {
  id                 String   @id @default(cuid())
  orgId              String
  leaseContractId    String
  dataReajuste       DateTime
  indice             String // IGPM | IPCA | IGP-DI | outro
  percentualAplicado Float
  valorAnterior      Float
  valorNovo          Float
  observacao         String?  @db.Text
  status             String   @default("proposto") // proposto | aprovado | aplicado | recusado
  propostoEm         DateTime @default(now())
  aprovadoEm         DateTime?
  aprovadoPor        String? // userId
  createdAt          DateTime @default(now())

  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseContract LeaseContract @relation(fields: [leaseContractId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([leaseContractId, dataReajuste])
}

// DefaultWitness — cadastro de testemunhas padrão do sistema (por org). Quando
// `isDefault=true`, a popup de envio de assinatura as injeta pré-marcadas no
// envelope ClickSign (papel "witness"). Editáveis em /settings/testemunhas.
model DefaultWitness {
  id          String   @id @default(cuid())
  orgId       String
  nome        String
  cpf         String?
  email       String
  mobilePhone String?
  isDefault   Boolean  @default(true)
  // Módulo ao qual a testemunha pertence: "venda" | "locacao" | "proposta".
  // Cada módulo pode ter um conjunto próprio de testemunhas padrão. Rows legadas
  // (pré-scope) resolvem para "venda" via default.
  scope       String   @default("venda")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, scope])
}

/// ClickSignAccount — conta ClickSign própria da imobiliária (multitenant). Uma
/// por org (`orgId @unique`), mesmo padrão do OrgGoogleAccount. Token e webhook
/// secret criptografados com AES-256-GCM (lib/security/crypto.ts), como a
/// AsaasAccount. Sem row, só a org compartilhada legada (SHARED_ORG_ID) cai no
/// CLICKSIGN_API_TOKEN global; qualquer outra org sem conta NÃO envia assinatura.
/// `webhookSlug` compõe a URL pública per-org /api/webhooks/clicksign/{slug}; o
/// secret é gerado pela ClickSign no cadastro do webhook (auto-provision) ou
/// colado manualmente (fallback).
model ClickSignAccount {
  id                     String    @id @default(cuid())
  orgId                  String    @unique
  label                  String?
  // Token de acesso da conta ClickSign (AES-256-GCM).
  apiTokenEncrypted      String    @db.Text
  apiTokenIvBase64       String
  apiTokenTagBase64      String
  baseUrl                String    @default("https://app.clicksign.com")
  // Webhook per-org: slug público na URL + HMAC secret criptografado (nullable
  // até provisionar/colar).
  webhookSlug            String    @unique
  webhookSecretEncrypted String?   @db.Text
  webhookSecretIvBase64  String?
  webhookSecretTagBase64 String?
  clicksignWebhookId     String?
  webhookProvisioned     Boolean   @default(false)
  status                 String    @default("connected") // connected | error | disconnected
  accountName            String?
  connectedById          String?
  lastValidatedAt        DateTime?
  lastError              String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// OrgSignatureSettings — preferências de assinatura por org (independentes da
/// credencial: existem mesmo na org legada que usa o token global). Guardam os
/// tipos de assinatura (método padrão + permitidos), orçamento/custo e os
/// padrões de envelope que hoje eram hardcoded (locale/auto_close/refusable/
/// prazo/ordem). Lazy-create com defaults em getSignatureSettings().
model OrgSignatureSettings {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  // Orçamento/custo (fallback: CLICKSIGN_MONTHLY_BUDGET_CENTS / tabela hardcoded).
  monthlyBudgetCents Int?
  costOverridesJson  Json? // { email: 150, whatsapp: 250, ... } — override por método
  // Sub-orçamento das PROPOSTAS, dentro do mensal. Proposta é especulativa (a
  // maioria não fecha); contrato é receita. Sem este teto, uma enxurrada de
  // propostas consome o orçamento e bloqueia o envio de um contrato assinado.
  // Null = sem sub-teto (só o mensal vale).
  proposalBudgetCents Int?
  // Aceite via WhatsApp (POST /acceptance_term/whatsapps, ~R$0,99, cobrado na
  // ENTREGA): depende do recurso estar habilitado na conta ClickSign do tenant.
  // Off até provar contra a conta real.
  acceptanceEnabled  Boolean  @default(false)
  // Capacidade DETECTADA da conta ClickSign (probe na conexão). Null = ainda não
  // probado. Roteia o WhatsApp: signatura (Plus+) vs Aceite. Ver lib/proposals/
  // routing.ts + lib/clicksign/capabilities.ts. `capabilitiesCheckedAt` permite
  // reprobar quando o tenant fizer upgrade.
  whatsappSignatureAvailable   Boolean?
  acceptanceWhatsappAvailable  Boolean?
  capabilitiesCheckedAt        DateTime?
  // Tipos de assinatura (AuthMethod: email | whatsapp | selfie | icp_brasil).
  defaultAuthMethod  String   @default("email")
  allowedAuthMethods String[] @default(["email", "whatsapp", "selfie", "icp_brasil"])
  // Padrões de envelope.
  defaultLocale      String   @default("pt-BR")
  autoClose          Boolean  @default(true)
  refusable          Boolean  @default(true)
  defaultDeadlineDays Int?
  defaultSequential  Boolean  @default(false)
  // Mensagem/assunto da notificação de assinatura das PROPOSTAS (envelope). Null
  // = usa o template padrão da ClickSign. Placeholders: {{numero}} {{proponente}}
  // {{imovel}} {{titulo}}. Editável em /settings.
  proposalEmailSubject String?
  proposalEmailMessage String?
  // Handoff comprador→proprietário (2026-08): default é PARAR na decisão humana
  // (assinada_proponente). Escape hatch por org: true = encadeia a 2ª via
  // automaticamente como antes do flip.
  proposalAutoChainVendedor Boolean @default(false)
  // Prazo próprio (dias) da 2ª via enviada ao proprietário. Null = 7. A 2ª via
  // nascia com deadline = validUntil da proposta, que na parada de decisão já
  // podia estar vencido (bug C do plano 2026-08-06).
  proposalOwnerDeadlineDays Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// DIMOB — registro de cada arquivo TXT gerado (auditoria + reemissão anual).
// Um por geração; a UI mostra o histórico e permite baixar de novo.
model DimobExport {
  id                String   @id @default(cuid())
  orgId             String
  year              Int // ano-calendário declarado
  recordCount       Int // total de linhas (R01 + R04...)
  totalOperacoes    Float // soma dos valores de alienação
  totalComissao     Float // soma da comissão do declarante
  contentHash       String // SHA-256 do TXT (dedupe/integridade)
  fileUrl           String? // storage do TXT gerado (opcional)
  retificadora      Boolean  @default(false) // declaração retificadora?
  numeroRecibo      String? // recibo da declaração anterior (se retificadora)
  generatedByUserId String?
  createdAt         DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, year])
}

// DIMOB — edições do usuário na grade de revisão (overrides por org+ano).
// state = { [recordId]: { [fieldKey]: valorString } }. Schema-free p/ o leiaute
// evoluir sem migração (mesmo padrão de CommissionChargeDraft).
model DimobOverride {
  id        String   @id @default(cuid())
  orgId     String
  year      Int
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, year])
}

// DIMOB — vendas (dealId) ou locações (leaseId) excluídas da declaração por
// (org, ano). Excluir tira o registro do TXT; "reconciliar" apaga a linha e volta.
// XOR dealId|leaseId (validado no app). `reason` é opcional (audit).
// ---------------------------------------------------------------------------
// Pesquisas de satisfação (NPS/CSAT)
// ---------------------------------------------------------------------------

// IMUTÁVEL após criação: questionsJson NUNCA recebe PATCH. Cada row é um LOTE
// com relatório próprio — "editar" = new-version (padrão Contract:
// version/isLatest/parentVersionId). Invariante: no máx 1 isLatest=true por
// (orgId, familyId) — índice único parcial `SurveyTemplate_familyId_isLatest_unique`.
// familyId agrupa as versões da mesma pesquisa (na v1, familyId = id).
model SurveyTemplate {
  id              String   @id @default(cuid())
  orgId           String
  familyId        String
  version         Int      @default(1)
  isLatest        Boolean  @default(true)
  parentVersionId String?
  name            String
  description     String?
  status          String   @default("active") // active | archived
  // [{ id, type: "nps"|"csat"|"single"|"multi"|"text", label, required, options? }]
  // Máx 15 perguntas; máx 1 NPS e 1 CSAT (mantém npsScore/csatScore não-ambíguos).
  questionsJson   Json
  // { thankYouMessage?, anonymous? (reservado), aiSummary? (cache do resumo) }
  settingsJson    Json     @default("{}")
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentVersion SurveyTemplate?  @relation("SurveyTemplateVersions", fields: [parentVersionId], references: [id])
  childVersions SurveyTemplate[] @relation("SurveyTemplateVersions")
  invites       SurveyInvite[]
  responses     SurveyResponse[]

  @@index([orgId, familyId, version])
  @@index([orgId, isLatest, status])
}

// Regra de disparo automático por etapa do pipeline. MUTÁVEL (não é lote).
// Aponta pra FAMÍLIA do template; o dispatch resolve isLatest na hora — nova
// versão redireciona os próximos envios pro novo lote sem tocar na automação.
model SurveyAutomation {
  id                  String   @id @default(cuid())
  orgId               String
  templateFamilyId    String
  dealKind            String   // "venda" | "locacao"
  triggerStageName    String   // nome canônico do stage (lib/pipeline/stage-config.ts)
  audience            String[] @default([]) // vendedor|comprador|locador|locatario|corretor
  channel             String   @default("email") // email | whatsapp | manual
  enabled             Boolean  @default(true)
  reminderOffsetsDays Int[]    @default([2, 5]) // dias após envio; para ao responder
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, dealKind, triggerStageName, enabled])
}

// Um envio (ou link manual) da pesquisa para um destinatário. Token opaco
// (padrão participant-token: randomBytes base64url — URL curta p/ WhatsApp).
// dedupeKey = `${dealId}:${templateId}:${recipientRole}:${contatoNormalizado}`
// (sem deal usa a constante "manual": mesmo lote + mesmo contato = 1 invite;
// manual sem contato usa o token como chave). Unique no banco garante que
// hook + cron concorrentes nunca dupliquem envio.
model SurveyInvite {
  id             String    @id @default(cuid())
  orgId          String
  templateId     String    // versão CONCRETA = lote (congelada no disparo)
  automationId   String?   // null = envio manual
  dealId         String?
  recipientRole  String    // vendedor|comprador|locador|locatario|corretor
  recipientName  String?
  recipientEmail String?
  recipientPhone String?
  channel        String    // email | whatsapp | manual
  token          String    @unique
  tokenExp       DateTime
  status         String    @default("pending") // pending|sent|responded|expired|optout|failed
  sentAt         DateTime?
  respondedAt    DateTime?
  remindersSent  Int       @default(0)
  lastReminderAt DateTime?
  dedupeKey      String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template SurveyTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  deal     Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  response SurveyResponse?

  @@index([orgId, templateId, status])
  @@index([dealId, createdAt])
  @@index([status, sentAt])
}

model SurveyResponse {
  id             String   @id @default(cuid())
  orgId          String
  templateId     String   // lote — agregação SQL direta, sem join
  inviteId       String   @unique // idempotência do POST público
  dealId         String?
  respondentRole String
  // [{ questionId, type, value }] — value: number (nps/csat), string (single/text), string[] (multi)
  answersJson    Json
  // Derivadas da pergunta nps/csat do template (máx 1 de cada) — agregação sem parse de Json
  npsScore       Int?
  csatScore      Int?
  createdAt      DateTime @default(now())

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template SurveyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  invite   SurveyInvite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([orgId, templateId, createdAt])
  @@index([dealId])
}

model DimobExclusion {
  id               String   @id @default(cuid())
  orgId            String
  year             Int
  dealId           String?
  leaseId          String?
  reason           String?
  excludedByUserId String?
  createdAt        DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, year, dealId])
  @@unique([orgId, year, leaseId])
  @@index([orgId, year])
}
