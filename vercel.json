{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w apps/web",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/certidoes/poll-portal",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/ocr-queue",
      "schedule": "*/1 * * * *"
    }
  ]
}

