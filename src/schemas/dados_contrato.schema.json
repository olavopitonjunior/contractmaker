{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "schema_dados_v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "vendedores",
    "compradores",
    "imoveis",
    "status_propriedade",
    "tem_debitos",
    "debitos",
    "vicios",
    "debitos_assumidos",
    "regularizacoes",
    "pagamento",
    "incluso_no_preco",
    "ocupacao",
    "entrega_posse",
    "titulo_definitivo",
    "comissao",
    "desistencia",
    "foro",
    "assinatura",
    "testemunhas",
    "config"
  ],
  "properties": {
    "vendedores": { "$ref": "#/$defs/partes" },
    "compradores": { "$ref": "#/$defs/partes" },
    "anuente": { "$ref": "#/$defs/parte" },
    "imoveis": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/imovel" }
    },
    "status_propriedade": {
      "type": "string",
      "enum": ["financiamento-quitado", "financiado-saldo", "quitado-registrado"]
    },
    "saldo_devedor": { "type": "number" },
    "tem_debitos": { "type": "boolean" },
    "debitos": {
      "type": "object",
      "additionalProperties": true,
      "required": ["iptu", "condominio"],
      "properties": {
        "iptu": {
          "type": "object",
          "required": ["selecionado", "valor"],
          "properties": {
            "selecionado": { "type": "boolean" },
            "valor": { "type": "number" }
          }
        },
        "condominio": {
          "type": "object",
          "required": ["selecionado", "valor"],
          "properties": {
            "selecionado": { "type": "boolean" },
            "valor": { "type": "number" }
          }
        },
        "outros": { "type": "string" }
      }
    },
    "vicios": {
      "type": "object",
      "required": ["opcao"],
      "properties": {
        "opcao": {
          "type": "string",
          "enum": ["padrao", "reparar", "desocultados", "renuncia", "detalhado"]
        },
        "descricao_reparar": { "type": "string" },
        "descricao_desocultados": { "type": "string" }
      }
    },
    "debitos_assumidos": {
      "type": "object",
      "required": ["assume"],
      "properties": {
        "assume": { "type": "boolean" },
        "descricao": { "type": "string" }
      }
    },
    "regularizacoes": {
      "type": "object",
      "required": ["tem"],
      "properties": {
        "tem": { "type": "boolean" },
        "prazo_dias": { "type": "number" },
        "descricao": { "type": "string" }
      }
    },
    "pagamento": {
      "type": "object",
      "required": [
        "valor_total",
        "sinal_arras",
        "recursos_proprios",
        "fgts",
        "cessao_consorcio",
        "alienacao_fiduciaria",
        "outras_formas",
        "meio_pagamento",
        "parcelas"
      ],
      "properties": {
        "valor_total": { "type": "number" },
        "sinal_arras": { "type": "number" },
        "recursos_proprios": { "type": "number" },
        "fgts": { "type": "number" },
        "cessao_consorcio": { "type": "number" },
        "cessao_consorcio_descricao": { "type": "string" },
        "alienacao_fiduciaria": { "type": "number" },
        "outras_formas": { "type": "number" },
        "outras_formas_descricao": { "type": "string" },
        "meio_pagamento": { "type": "string" },
        "parcelas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["valor"],
            "properties": {
              "tipo_texto": { "type": "string" },
              "dias": { "type": "number" },
              "valor": { "type": "number" }
            }
          }
        }
      }
    },
    "incluso_no_preco": { "type": "string" },
    "ocupacao": {
      "type": "string",
      "enum": ["desocupado", "ocupado-vendedor", "ocupado-terceiro"]
    },
    "locacao": {
      "type": "object",
      "properties": {
        "data_preferencia": { "type": "string" },
        "situacao": {
          "type": "string",
          "enum": ["vendedor-entregara", "comprador-mantem"]
        }
      }
    },
    "entrega_posse": {
      "type": "object",
      "required": ["momento", "momento_texto"],
      "properties": {
        "momento": { "type": "string" },
        "momento_texto": { "type": "string" }
      }
    },
    "titulo_definitivo": {
      "type": "object",
      "required": ["prazo_dias", "opcao"],
      "properties": {
        "prazo_dias": { "type": "number" },
        "opcao": {
          "type": "string",
          "enum": ["padrao", "usufruto", "certidoes-apos"]
        }
      }
    },
    "comissao": {
      "type": "object",
      "required": [
        "valor",
        "quem_paga",
        "quem_paga_texto",
        "quando_paga",
        "quando_paga_texto",
        "imobiliaria_nome",
        "imobiliaria_cnpj"
      ],
      "properties": {
        "valor": { "type": "number" },
        "quem_paga": { "type": "string" },
        "quem_paga_texto": { "type": "string" },
        "quando_paga": { "type": "string" },
        "quando_paga_texto": { "type": "string" },
        "imobiliaria_nome": { "type": "string" },
        "imobiliaria_cnpj": { "type": "string" }
      }
    },
    "desistencia": {
      "type": "object",
      "required": ["permite"],
      "properties": {
        "permite": { "type": "boolean" },
        "prazo_dias": { "type": "number" }
      }
    },
    "foro": {
      "type": "string",
      "enum": ["arbitragem", "justica-publica"]
    },
    "assinatura": {
      "type": "object",
      "required": ["cidade", "uf", "data"],
      "properties": {
        "cidade": { "type": "string" },
        "uf": { "type": "string" },
        "data": { "type": "string" }
      }
    },
    "testemunhas": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["nome", "cpf"],
        "properties": {
          "nome": { "type": "string" },
          "cpf": { "type": "string" }
        }
      }
    },
    "config": { "$ref": "#/$defs/config" }
  },
  "$defs": {
    "partes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/parte" }
    },
    "parte": {
      "type": "object",
      "required": ["tipo_pessoa"],
      "properties": {
        "tipo_pessoa": { "type": "string", "enum": ["fisica", "juridica"] },
        "nome": { "type": "string" },
        "nacionalidade": { "type": "string" },
        "estado_civil": { "type": "string" },
        "profissao": { "type": "string" },
        "rg": { "type": "string" },
        "cpf": { "type": "string" },
        "email": { "type": "string" },
        "endereco": { "type": "string" },
        "numero": { "type": "string" },
        "complemento": { "type": "string" },
        "cidade": { "type": "string" },
        "uf": { "type": "string" },
        "cep": { "type": "string" },
        "conjuge": {
          "type": "object",
          "properties": {
            "nome": { "type": "string" },
            "cpf": { "type": "string" },
            "rg": { "type": "string" },
            "nacionalidade": { "type": "string" },
            "profissao": { "type": "string" }
          }
        },
        "tem_procurador": { "type": "boolean" },
        "procurador": {
          "type": "object",
          "properties": {
            "nome": { "type": "string" },
            "cpf": { "type": "string" },
            "rg": { "type": "string" },
            "endereco": { "type": "string" },
            "numero": { "type": "string" },
            "cidade": { "type": "string" },
            "uf": { "type": "string" }
          }
        },
        "razao_social": { "type": "string" },
        "cnpj": { "type": "string" },
        "representante": {
          "type": "object",
          "properties": {
            "nome": { "type": "string" },
            "cpf": { "type": "string" },
            "nacionalidade": { "type": "string" },
            "estado_civil": { "type": "string" },
            "profissao": { "type": "string" }
          }
        }
      }
    },
    "imovel": {
      "type": "object",
      "properties": {
        "rua": { "type": "string" },
        "numero": { "type": "string" },
        "complemento": { "type": "string" },
        "bairro": { "type": "string" },
        "cidade": { "type": "string" },
        "uf": { "type": "string" },
        "cep": { "type": "string" },
        "matricula": { "type": "string" },
        "cartorio": { "type": "string" },
        "inscricao_iptu": { "type": "string" },
        "descricao": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "multa_penal_moratoria",
        "base_calculo_multa",
        "juros_mensais_atraso",
        "atualizacao_monetaria",
        "prazo_atraso_rescisao",
        "multa_cominatoria_diaria",
        "multa_penal_compensatoria",
        "prazo_multa_rescisoria"
      ],
      "properties": {
        "multa_penal_moratoria": { "type": "number" },
        "base_calculo_multa": { "type": "string" },
        "juros_mensais_atraso": { "type": "number" },
        "atualizacao_monetaria": { "type": "string" },
        "prazo_atraso_rescisao": { "type": "number" },
        "multa_cominatoria_diaria": { "type": "number" },
        "multa_penal_compensatoria": { "type": "number" },
        "prazo_multa_rescisoria": { "type": "number" }
      }
    }
  }
}
