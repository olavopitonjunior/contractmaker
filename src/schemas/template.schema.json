{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "schema_template_v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "nome",
    "versao",
    "origem",
    "status",
    "compatibilidade",
    "criado_em",
    "atualizado_em"
  ],
  "properties": {
    "id": { "type": "string" },
    "nome": { "type": "string" },
    "descricao": { "type": "string" },
    "versao": { "type": "string" },
    "origem": { "type": "string", "enum": ["library", "upload", "manual"] },
    "status": { "type": "string", "enum": ["draft", "active", "archived"] },
    "compatibilidade": {
      "type": "object",
      "required": ["schema_dados", "engine", "exportacao"],
      "properties": {
        "schema_dados": { "type": "string" },
        "engine": { "type": "string", "enum": ["handlebars"] },
        "exportacao": {
          "type": "array",
          "items": { "type": "string", "enum": ["html", "docx", "pdf"] }
        }
      }
    },
    "arquivo_original_url": { "type": "string" },
    "criado_em": { "type": "string" },
    "atualizado_em": { "type": "string" }
  }
}
