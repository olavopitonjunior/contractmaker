  {{!-- ================= PÁGINA 1 ================= --}}

  <table style="width:100%;border-collapse:collapse;margin-bottom:6px;">
    <tr>
      <td style="vertical-align:middle;font-size:19pt;font-weight:bold;letter-spacing:.3px;">PROPOSTA DE LOCAÇÃO{{#if (eq locatarios.[0].tipo_pessoa "juridica")}} PJ{{/if}}</td>
      <td style="vertical-align:middle;text-align:right;">
        <div style="font-size:7pt;letter-spacing:3px;color:#333;">IMÓVEIS</div>
        <div style="font-size:17pt;font-weight:bold;color:#003da5;">RE/MAX</div>
        <div style="font-size:11pt;font-weight:bold;color:#003da5;">Ativa I</div>
        <div style="font-size:6.5pt;color:#555;">CRECI: 25319-J</div>
      </td>
    </tr>
  </table>
  <div style="border-top:4px solid #002f6c;margin-bottom:8px;"></div>

  <table style="width:100%;border-collapse:collapse;border:1px solid #000;table-layout:fixed;">
    <tr>
      <td style="border:1px solid #000;padding:4px 7px;font-size:9pt;text-align:center;width:9%;">{{#unless (or (eq imovel.kind "comercial_sala") (eq imovel.kind "loja") (eq imovel.kind "galpao"))}}<strong>X</strong>{{else}}&nbsp;{{/unless}}</td>
      <td style="border:1px solid #000;padding:4px 7px;font-size:8.5pt;font-weight:bold;width:16%;">Residencial</td>
      <td style="border:1px solid #000;padding:4px 7px;font-size:9pt;text-align:center;width:9%;">{{#if (or (eq imovel.kind "comercial_sala") (eq imovel.kind "loja") (eq imovel.kind "galpao"))}}<strong>X</strong>{{else}}&nbsp;{{/if}}</td>
      <td style="border:1px solid #000;padding:4px 7px;font-size:8.5pt;font-weight:bold;width:16%;">Comercial</td>
      <td style="border:1px solid #000;padding:4px 7px;font-size:8.5pt;width:16%;"><span style="font-weight:bold;">REF.</span> {{numero_proposta}}</td>
      <td style="border:1px solid #000;padding:4px 7px;font-size:8.5pt;width:17%;"><span style="font-weight:bold;">Consultor</span></td>
      <td style="border:1px solid #000;padding:4px 7px;font-size:8.5pt;width:17%;"><span style="font-weight:bold;">Mídia</span></td>
    </tr>
  </table>

  <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-top:none;table-layout:fixed;">

    <tr><td colspan="4" style="background:#d9d9d9;border:1px solid #000;padding:3px 7px;font-size:8.5pt;font-weight:bold;">INFORMAÇÕES DO IMÓVEL</td></tr>
    <tr>
      <td colspan="2" style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Endereço</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{imovel.rua}}</div></td>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Nº</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{imovel.numero}}</div></td>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Compl.</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{imovel.complemento}}</div></td>
    </tr>
    <tr>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Bairro</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{imovel.bairro}}</div></td>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Condomínio</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{imovel.condominio_nome}}</div></td>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Cidade/Município</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{imovel.cidade}}</div></td>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">UF</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{imovel.uf}}</div></td>
    </tr>

    <tr><td colspan="4" style="background:#d9d9d9;border:1px solid #000;padding:3px 7px;font-size:8.5pt;font-weight:bold;">PROPOSTA / VALORES</td></tr>
    <tr>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Aluguel</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{#if (gt aluguel.valor 0)}}{{moeda aluguel.valor}}{{/if}}</div></td>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">IPTU / ITR</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{#if (gt aluguel.iptu_mensal 0)}}{{moeda aluguel.iptu_mensal}}{{/if}}</div></td>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Condomínio</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{#if (gt aluguel.condominio_mensal 0)}}{{moeda aluguel.condominio_mensal}}{{/if}}</div></td>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Garantia</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{#if (eq garantia.tipo "fiador")}}Fiador{{else if (eq garantia.tipo "caucao")}}Caução{{else if (eq garantia.tipo "seguro_fianca")}}Seguro-fiança{{else if (eq garantia.tipo "garantia_digital")}}Garantia digital{{else if (eq garantia.tipo "titulo_capitalizacao")}}Título de capitalização{{else if (eq garantia.tipo "propria")}}Garantia própria{{else if (eq garantia.tipo "sem_garantia")}}Sem garantia{{/if}}</div></td>
    </tr>
    <tr>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">PG Fiança</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{#if (gt garantia.caucao_meses 0)}}{{garantia.caucao_meses}} aluguel(éis){{else if (gt garantia.titulo_valor 0)}}{{moeda garantia.titulo_valor}}{{else if (existe garantia.provider)}}{{garantia.provider}}{{/if}}</div></td>
      <td colspan="2" style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Finalidade da locação</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{#if (existe imovel.destinacao)}}{{imovel.destinacao}}{{else}}{{#unless (or (eq imovel.kind "comercial_sala") (eq imovel.kind "loja") (eq imovel.kind "galpao"))}}Residencial{{else}}Comercial{{/unless}}{{/if}}</div></td>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Tempo da locação</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">{{#if (gt aluguel.vigencia_meses 0)}}{{aluguel.vigencia_meses}} meses{{/if}}</div></td>
    </tr>
    <tr>
      <td colspan="4" style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Cláusulas Específicas</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
    </tr>
    <tr>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Nº de Moradores</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
      <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Nº de Animais</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
      <td colspan="2" style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Tipos / Observações</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
    </tr>

    <tr><td colspan="4" style="background:#d9d9d9;border:1px solid #000;padding:3px 7px;font-size:8.5pt;font-weight:bold;">INFORMAÇÕES PESSOAIS E PROFISSIONAIS DO(A) LOCATÁRIO(A)</td></tr>
    {{#if (eq locatarios.[0].tipo_pessoa "juridica")}}
      {{> campoPJ locatarios.[0]}}
      <tr><td colspan="4" style="background:#d9d9d9;border:1px solid #000;padding:3px 7px;font-size:8.5pt;font-weight:bold;">INFORMAÇÕES REPRESENTANTE LEGAL</td></tr>
      {{> campoRepr locatarios.[0].representante}}
      {{!-- O schema tem UM `representante` por PJ. O 2º representante da ficha da
           Ativa não tem chave: sai em branco (`{{> campoRepr}}` sem contexto). --}}
      <tr><td colspan="4" style="background:#d9d9d9;border:1px solid #000;padding:3px 7px;font-size:8.5pt;font-weight:bold;">INFORMAÇÕES REPRESENTANTE LEGAL / 2º REPRESENTANTE</td></tr>
      {{> campoRepr}}
    {{else}}
      {{> campoPF locatarios.[0]}}
      {{!-- "Cônjuge / 2º locatário": usa o 2º locatário PF quando existe; senão o
           cônjuge do titular. As duas chaves são do schema de locação. --}}
      <tr><td colspan="4" style="background:#d9d9d9;border:1px solid #000;padding:3px 7px;font-size:8.5pt;font-weight:bold;">INFORMAÇÕES PESSOAIS E PROFISSIONAIS DO(A) CÔNJUGE / 2º LOCATÁRIO(A)</td></tr>
      {{#if (eq locatarios.[1].tipo_pessoa "fisica")}}{{> campoPF locatarios.[1]}}{{else}}{{> campoPF locatarios.[0].conjuge}}{{/if}}
    {{/if}}

    {{> referencias}}
  </table>

  {{#unless (eq garantia.tipo "fiador")}}
    {{> clausulas}}
  {{/unless}}

  <table style="width:100%;border-collapse:collapse;margin-top:22px;">
    <tr>
      <td style="width:34%;font-size:9pt;vertical-align:bottom;padding-right:16px;">{{#if (existe assinatura.cidade)}}{{assinatura.cidade}}{{else}}{{imovel.cidade}}{{/if}},<span style="display:inline-block;min-width:150px;border-bottom:1px solid #000;">&nbsp;{{#if (existe assinatura.data)}}{{dataExtenso assinatura.data}}{{/if}}</span></td>
      <td style="width:33%;text-align:center;vertical-align:bottom;"><div style="border-top:1px solid #000;padding-top:3px;font-size:8pt;">ASSINATURA LOCATÁRIO</div><div style="font-size:7.5pt;color:#555;">{{#each locatarios}}{{#if (eq this.tipo_pessoa "fisica")}}{{this.nome}}{{else}}{{this.razao_social}}{{/if}}{{#unless @last}}; {{/unless}}{{/each}}</div></td>
      <td style="width:33%;text-align:center;vertical-align:bottom;"><div style="border-top:1px solid #000;padding-top:3px;font-size:8pt;">ASSINATURA LOCADOR</div><div style="font-size:7.5pt;color:#555;">{{#each locadores}}{{#if (eq this.tipo_pessoa "fisica")}}{{this.nome}}{{else}}{{this.razao_social}}{{/if}}{{#unless @last}}; {{/unless}}{{/each}}</div></td>
    </tr>
  </table>

  {{!-- ================= PÁGINA 2 — FIADOR ================= --}}
  {{#if (eq garantia.tipo "fiador")}}
  <div style="page-break-before:always;"></div>

  <table style="width:100%;border-collapse:collapse;margin-bottom:6px;">
    <tr>
      <td style="vertical-align:middle;font-size:19pt;font-weight:bold;letter-spacing:.3px;">FIADOR</td>
      <td style="vertical-align:middle;text-align:right;">
        <div style="font-size:7pt;letter-spacing:3px;color:#333;">IMÓVEIS</div>
        <div style="font-size:17pt;font-weight:bold;color:#003da5;">RE/MAX</div>
        <div style="font-size:11pt;font-weight:bold;color:#003da5;">Ativa I</div>
        <div style="font-size:6.5pt;color:#555;">CRECI: 25319-J</div>
      </td>
    </tr>
  </table>
  <div style="border-top:4px solid #002f6c;margin-bottom:8px;"></div>

  <table style="width:100%;border-collapse:collapse;border:1px solid #000;table-layout:fixed;">
    <tr><td colspan="4" style="background:#d9d9d9;border:1px solid #000;padding:3px 7px;font-size:8.5pt;font-weight:bold;">INFORMAÇÕES PESSOAIS E PROFISSIONAIS DO(A) FIADOR(A)</td></tr>
    {{#if (eq garantia.fiador.tipo_pessoa "juridica")}}
      {{> campoPJ garantia.fiador}}
      <tr><td colspan="4" style="background:#d9d9d9;border:1px solid #000;padding:3px 7px;font-size:8.5pt;font-weight:bold;">INFORMAÇÕES REPRESENTANTE LEGAL</td></tr>
