      {{> campoRepr}}
    {{else}}
      {{> campoPF garantia.fiador}}
      <tr><td colspan="4" style="background:#d9d9d9;border:1px solid #000;padding:3px 7px;font-size:8.5pt;font-weight:bold;">INFORMAÇÕES PESSOAIS E PROFISSIONAIS DO(A) CÔNJUGE / 2º FIADOR(A)</td></tr>
      {{> campoPF garantia.fiador.conjuge}}

      <tr><td colspan="4" style="background:#d9d9d9;border:1px solid #000;padding:3px 7px;font-size:8.5pt;font-weight:bold;">INFORMAÇÕES DO(S) IMÓVEL(EIS) DO(A) FIADOR(A)</td></tr>
      <tr>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Imóvel 1</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Nº</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Compl.</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Bairro</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
      </tr>
      <tr>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Cidade/Município</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">UF</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Matrícula</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">CPD</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
      </tr>
      <tr>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Imóvel 2</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Nº</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Compl.</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Bairro</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
      </tr>
      <tr>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Cidade/Município</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">UF</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">Matrícula</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
        <td style="padding:4px 7px 1px;vertical-align:bottom;"><div style="font-size:7pt;color:#444;line-height:1.1;">CPD</div><div style="font-size:9.5pt;min-height:15px;border-bottom:1px solid #000;">&nbsp;</div></td>
      </tr>
    {{/if}}

    {{> referencias}}
  </table>

  {{> clausulas}}

  <table style="width:100%;border-collapse:collapse;margin-top:22px;">
    <tr>
      <td style="width:34%;font-size:9pt;vertical-align:bottom;padding-right:16px;">{{#if (existe assinatura.cidade)}}{{assinatura.cidade}}{{else}}{{imovel.cidade}}{{/if}},<span style="display:inline-block;min-width:150px;border-bottom:1px solid #000;">&nbsp;{{#if (existe assinatura.data)}}{{dataExtenso assinatura.data}}{{/if}}</span></td>
      <td style="width:33%;text-align:center;vertical-align:bottom;"><div style="border-top:1px solid #000;padding-top:3px;font-size:8pt;">ASSINATURA LOCATÁRIO</div><div style="font-size:7.5pt;color:#555;">{{#each locatarios}}{{#if (eq this.tipo_pessoa "fisica")}}{{this.nome}}{{else}}{{this.razao_social}}{{/if}}{{#unless @last}}; {{/unless}}{{/each}}</div></td>
