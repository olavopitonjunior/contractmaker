  {{#if via_reduzida}}
  <p style="margin-top:22px;font-size:8pt;color:#555;border-top:1px solid #ccc;padding-top:7px;">
    Este instrumento reproduz as condições essenciais da Proposta nº {{numero_proposta}},
    arquivada na íntegra junto à imobiliária.
  </p>
  {{/if}}

</div>
