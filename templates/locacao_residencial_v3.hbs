s.estado_civil)}}, {{this.estado_civil}}{{/if}}{{#if (existe this.profissao)}}, {{this.profissao}}{{/if}}{{#if (existe this.rg)}}, portador(a) da cédula de identidade RG nº {{this.rg}}{{/if}}{{#if (existe this.cpf)}}, inscrito(a) no CPF/MF sob nº {{cpf this.cpf}}{{/if}}{{#if (existe this.endereco)}}, residente e domiciliado(a) na {{this.endereco}}, nº {{this.numero}}{{#if this.complemento}}, {{this.complemento}}{{/if}}{{#if this.bairro}}, {{this.bairro}}{{/if}}{{#if (existe this.cep)}}, CEP {{cep this.cep}}{{/if}}{{#if (existe this.cidade)}}, {{this.cidade}}/{{this.uf}}{{/if}}{{/if}}{{#if (existe this.email)}}, endereço eletrônico e-mail {{this.email}}{{/if}}{{else}}{{this.razao_social}}, pessoa jurídica de direito privado, inscrita no CNPJ/MF sob nº {{cnpj this.cnpj}}{{#if (existe this.endereco)}}, com sede na {{this.endereco}}, nº {{this.numero}}{{#if this.complemento}}, {{this.complemento}}{{/if}}{{#if this.bairro}}, {{this.bairro}}{{/if}}{{#if (existe this.cep)}}, CEP {{cep this.cep}}{{/if}}{{#if (existe this.cidade)}}, {{this.cidade}}/{{this.uf}}{{/if}}{{/if}}{{#if this.representante.nome}}, neste ato representada por {{this.representante.nome}}, inscrito(a) no CPF/MF sob nº {{cpf this.representante.cpf}}{{/if}}{{/if}}{{#if this.conjuge.nome}}{{#if (temConjuge this.estado_civil)}}, casado(a) com {{this.conjuge.nome}}{{#if (existe this.conjuge.cpf)}}, inscrito(a) no CPF/MF sob nº {{cpf this.conjuge.cpf}}{{/if}}{{/if}}{{/if}}{{#unless @last}}; {{/unless}}{{/each}}{{#if (eq garantia.tipo "fiador")}}, e, na qualidade de FIADOR(A), {{#if (eq garantia.fiador.tipo_pessoa "juridica")}}{{garantia.fiador.razao_social}}, pessoa jurídica de direito privado, inscrita no CNPJ/MF sob nº {{cnpj garantia.fiador.cnpj}}{{#if (existe garantia.fiador.endereco)}}, com sede na {{garantia.fiador.endereco}}, nº {{garantia.fiador.numero}}{{#if garantia.fiador.bairro}}, {{garantia.fiador.bairro}}{{/if}}{{#if (existe garantia.fiador.cep)}}, CEP {{cep garantia.fiador.cep}}{{/if}}{{#if (existe garantia.fiador.cidade)}}, {{garantia.fiador.cidade}}/{{garantia.fiador.uf}}{{/if}}{{/if}}{{#if garantia.fiador.representante.nome}}, neste ato representada por {{garantia.fiador.representante.nome}}, inscrito(a) no CPF/MF sob nº {{cpf garantia.fiador.representante.cpf}}{{/if}}{{else}}{{garantia.fiador.nome}}{{#if (existe garantia.fiador.nacionalidade)}}, {{garantia.fiador.nacionalidade}}{{/if}}{{#if (existe garantia.fiador.estado_civil)}}, {{garantia.fiador.estado_civil}}{{/if}}{{#if (existe garantia.fiador.rg)}}, portador(a) da cédula de identidade RG nº {{garantia.fiador.rg}}{{/if}}{{#if (existe garantia.fiador.cpf)}}, inscrito(a) no CPF/MF sob nº {{cpf garantia.fiador.cpf}}{{/if}}{{#if (existe garantia.fiador.endereco)}}, residente e domiciliado(a) na {{garantia.fiador.endereco}}, nº {{garantia.fiador.numero}}, {{garantia.fiador.cidade}}/{{garantia.fiador.uf}}{{/if}}{{/if}}{{/if}}, têm entre si, justo e acertado o seguinte:</p>

<h2>1. IMÓVEL</h2>
<p>1.1. A PARTE LOCADORA, proprietária do(a) {{#if (existe imovel.tipo_texto)}}{{imovel.tipo_texto}}{{else}}{{imovel.kind}}{{/if}}{{#if (existe imovel.complemento)}} {{imovel.complemento}}{{/if}}{{#if (existe imovel.condominio_nome)}}, do {{imovel.condominio_nome}}{{/if}}{{#if (existe imovel.rua)}}, localizado(a) na {{imovel.rua}}{{#if (existe imovel.numero)}}, nº {{imovel.numero}}{{/if}}{{/if}}{{#if imovel.bairro}}, {{imovel.bairro}}{{/if}}{{#if (existe imovel.cep)}}, CEP {{cep imovel.cep}}{{/if}}{{#if (existe imovel.cidade)}}, {{imovel.cidade}}{{#if (existe imovel.uf)}}/{{imovel.uf}}{{/if}}{{/if}}{{#if (gt imovel.area 0)}}, com área de {{numero imovel.area}} m²{{/if}}{{#if (gt imovel.vagas_garagem 0)}}, com {{imovel.vagas_garagem}} ({{numeroExtenso imovel.vagas_garagem "f"}}) vaga(s) de garagem{{/if}}{{#if imovel.inscricao_iptu}}, regularmente cadastrado na Prefeitura Municipal de {{imovel.cidade}} pelo contribuinte nº {{imovel.inscricao_iptu}}{{/if}}{{#if imovel.matricula}}, objeto da matrícula nº {{imovel.matricula}}{{#if imovel.cartorio}} do {{imovel.cartorio}}{{/if}}{{/if}}, pelo presente e na melhor forma de direito, loca-o à PARTE LOCATÁRIA, mediante as cláusulas e condições seguintes.</p>
<p>1.2. Descrição do imóvel: {{imovel.descricao}}</p>

<h2>2. PRAZO</h2>
<p>2.1. O prazo de locação é de {{aluguel.vigencia_meses}} ({{numeroExtenso aluguel.vigencia_meses}}) meses{{#if (existe config.vigencia_inicio_texto)}}, a contar de {{config.vigencia_inicio_texto}}{{/if}}{{#if (existe config.vigencia_fim_texto)}} e com término fixado em {{config.vigencia_fim_texto}}{{/if}}, data em que a PARTE LOCATÁRIA se compromete a devolver o imóvel completamente livre e desocupado de coisas e pessoas.</p>
<p>2.1.1. Findo o prazo estipulado, se a PARTE LOCATÁRIA permanecer no imóvel por mais de 30 (trinta) dias sem oposição da PARTE LOCADORA, presumir-se-á prorrogada a locação nas condições ajustadas, passando o contrato a vigorar por prazo indeterminado.</p>
<p>2.1.2. Para a devolução do imóvel e entrega das chaves, por qualquer motivo que seja, mesmo que por término do contrato, ou após, se a locação se prorrogar por prazo indeterminado, obriga-se a PARTE LOCATÁRIA a notificar por escrito a PARTE LOCADORA com antecedência mínima de 30 (trinta) dias da desocupação.</p>

<h2>3. ALUGUEL</h2>
<p>3.1. O valor do aluguel mensal é de {{moeda aluguel.valor}} ({{extenso aluguel.valor}}) que se corrigirá a cada 12 (doze) meses, {{#if (eq aluguel.indice_reajuste "IGPM")}}pelo Índice Geral de Preços - Mercado (IGP-M){{else if (eq aluguel.indice_reajuste "IPCA")}}pelo Índice Nacional de Preços ao Consumidor Amplo (IPCA){{else}}pelo índice ajustado entre as partes{{/if}} pelo tempo que perdurar a locação, ou o índice que, em sua substituição, for eventualmente imposto.</p>
<p>3.2. Não se aplica ao presente contrato para fins de reajuste do valor locativo, a variação negativa do índice indicado para medir a inflação no período.</p>

<h2>4. FORMA DE PAGAMENTO DO ALUGUEL E ENCARGOS DA LOCAÇÃO</h2>
{{#if (existe config.administradora_nome)}}
<p>4.1. Os aluguéis e demais encargos da locação deverão ser pagos pela PARTE LOCATÁRIA até o dia {{aluguel.dia_vencimento}} ({{numeroExtenso aluguel.dia_vencimento}}) de cada mês vencido para {{config.administradora_nome}}{{#if (existe config.administradora_creci)}}, regularmente inscrita no CRECI sob nº {{config.administradora_creci}}{{/if}}{{#if (existe config.administradora_endereco)}}, com sede na {{config.administradora_endereco}}{{/if}}, empresa nomeada para exercer a administração da presente locação (doravante "ADMINISTRADORA").</p>
{{else}}
<p>4.1. Os aluguéis e demais encargos da locação deverão ser pagos pela PARTE LOCATÁRIA até o dia {{aluguel.dia_vencimento}} ({{numeroExtenso aluguel.dia_vencimento}}) de cada mês vencido, diretamente à PARTE LOCADORA ou a quem esta indicar.</p>
{{/if}}
<p>4.2. A PARTE LOCATÁRIA concorda com a cobrança dos aluguéis e encargos locatícios através de {{#if (existe config.meio_pagamento_texto)}}{{config.meio_pagamento_texto}}{{else}}boleto bancário{{/if}}, estabelecendo-se desde logo que o e-mail indicado no preâmbulo fica definido como endereço eletrônico para o recebimento dos boletos, sendo certo que qualquer alteração desse endereço deverá comunicar por escrito à PARTE LOCADORA.</p>
<p>4.3. Na eventualidade de a PARTE LOCATÁRIA deixar de pagar o aluguel e demais encargos até a data do seu vencimento, o débito será acrescido de {{config.multa_atraso_percent}}% ({{numeroExtenso config.multa_atraso_percent}} por cento) a título de multa, fazendo-se o devido acréscimo, independentemente de qualquer procedimento judicial, à simples caracterização do atraso.</p>
<p>4.4. Fica estabelecido que, em caso de mora da PARTE LOCATÁRIA no pagamento do aluguel e demais encargos, a importância devida vencerá juros de {{config.juros_mensais_atraso}}% ({{numeroExtenso config.juros_mensais_atraso}} por cento) ao mês, ficando igualmente sujeita à correção monetária que a lei admitir, se o atraso for superior a 30 (trinta) dias.</p>
<p>4.5. Caso a entrega das chaves se dê antes do início do prazo contratual ajustado, serão cobrados da PARTE LOCATÁRIA os dias proporcionais de aluguel e encargos da locação, cujo vencimento será a data inicial do contrato, mantendo-se esta como data base, para todos os efeitos.</p>

<h2>5. FINALIDADE</h2>
<p>5.1. Ficará expressamente convencionado que o imóvel será utilizado pela PARTE LOCATÁRIA exclusivamente para uso residencial.</p>
<p>5.2. A PARTE LOCATÁRIA não poderá transferir o presente contrato, nem tampouco sublocar ou emprestar o imóvel, no todo ou em parte, sem prévio consentimento por escrito da PARTE LOCADORA, devendo, no caso de este ser dado, agir oportunamente, junto aos ocupantes, no sentido de obter ao término do contrato, a total desocupação, de modo a assegurar a devolução do imóvel livre de coisas e pessoas.</p>
<p>5.3. Em se tratando de imóvel de condomínio sujeito a regulamento interno, obriga-se, por si, seus prepostos e visitas, a respeitá-lo integralmente sob pena de rescisão contratual.</p>
<p>5.3.1. Responsabiliza-se a PARTE LOCATÁRIA por eventuais multas decorrentes do descumprimento do regulamento interno, ainda que referida cobrança recaia sobre a PARTE LOCADORA.</p>
<p>5.4. Fica expressamente vedada à PARTE LOCATÁRIA a alteração ou indicação do endereço do imóvel objeto do presente contrato como sede, filial, sucursal ou local de atendimento de qualquer pessoa jurídica de que sejam sócios ou qualquer outra, sob pena de caracterização de infração contratual passível de aplicação da multa prevista no item 7.1. e rescisão contratual.</p>

<h2>6. ESTADO DO IMÓVEL E BENFEITORIAS</h2>
<p>6.1. A PARTE LOCATÁRIA declara haver vistoriado o imóvel objeto do presente contrato, declarando-se ciente e aceitando-o no estado em que constatado no laudo de vistoria anexo - que passa a fazer parte integrante ao presente contrato, - obrigando-se a mantê-lo em perfeito estado de uso e conservação até o final da locação, notadamente no que diz respeito às instalações hidráulicas, elétricas e sanitárias, vidraças, fechaduras, esquadrias, pisos, portas, espelhos de interruptores de tomadas e demais acessórios, de modo que tudo seja restituído à PARTE LOCADORA.</p>
<p>6.2. Caso o imóvel possua vícios aparentes anteriores à locação, assim entendidos aqueles que são de fácil constatação e que tenham sido identificados na vistoria inicial do imóvel, como por exemplo rachaduras em vidros e/ou ladrilhos, desgastes na pintura, falta de espelhos nas tomadas, falta de chaves em portas internas ou nos armários, a PARTE LOCADORA não estará obrigada a efetuar qualquer reparo, uma vez que o imóvel foi apresentado nestas condições à PARTE LOCATÁRIA, e o preço e demais condições do aluguel foram definidos considerando estes fatores. Por outro lado, a PARTE LOCATÁRIA também não estará obrigada a efetuar o reparo dos referidos vícios quando da devolução do imóvel, tendo em vista que assim o recebera da PARTE LOCADORA.</p>
<p>6.3. A PARTE LOCATÁRIA obriga-se a manter em perfeitas condições de funcionamento e higiene todos os equipamentos eletroeletrônicos, sistemas de climatização (ar-condicionado), aquecedores a gás, bombas e demais instalações que guarnecem o imóvel.</p>
<p>6.3.1. É de responsabilidade exclusiva da PARTE LOCATÁRIA a realização de manutenções preventivas e periódicas, conforme recomendação dos fabricantes ou normas técnicas vigentes, arcando integralmente com os custos de mão de obra e peças de reposição decorrentes do uso normal.</p>
<p>6.3.2. No ato da rescisão contratual e entrega das chaves, a PARTE LOCATÁRIA deverá obrigatoriamente apresentar a PARTE LOCADORA ou à sua Administradora todos os comprovantes, notas fiscais e relatórios técnicos das manutenções realizadas durante o período de locação, bem como o comprovante da manutenção final de entrega.</p>
<p>6.3.3. A ausência de comprovação das manutenções periódicas ou a entrega de equipamentos sem a devida revisão técnica autorizará a PARTE LOCADORA a realizar os reparos necessários, cujos custos serão repassados a PARTE LOCATÁRIA e/ou seus fiadores, sem prejuízo da aplicação de multa contratual por descumprimento de obrigação de zelo.</p>
<p>6.4. Ao final da locação, considerar-se-ão incorporadas ao imóvel às benfeitorias eventualmente introduzidas pela PARTE LOCATÁRIA, sem que lhes assista o direito de retenção, ou a indenização qualquer, mesmo que tais benfeitorias possam ser consideradas úteis, ou necessárias.</p>
<p>6.5. Obriga-se, porém, a PARTE LOCATÁRIA, a remover, por sua conta e às suas expensas, as benfeitorias que à PARTE LOCADORA não interessar.</p>
<p>6.6. Qualquer benfeitoria a ser realizada pela PARTE LOCATÁRIA, seja necessária, útil ou voluptuária, somente poderá ser introduzida ao imóvel mediante autorização por escrito da PARTE LOCADORA.</p>
<p>6.7. Quaisquer danos ocasionados ao imóvel e às instalações, bem como as despesas a que as PARTE LOCADORA for obrigada, em razão de eventuais modificações feitas no imóvel pela PARTE LOCATÁRIA, não ficam compreendidas na multa do item 7.1., mas serão ressarcidas à parte.</p>
<p>6.8. A PARTE LOCATÁRIA desde já faculta à PARTE LOCADORA examinarem ou vistoriarem o imóvel, sempre que entender necessário, desde que se faça durante o horário comercial e mediante comunicação, com 24 (vinte e quatro) horas de antecedência.</p>

<h2>7. MULTA</h2>
{{#if config.clausula_rescisoria}}
<p>7.1. Fica estipulada a multa equivalente a {{config.multa_rescisoria_meses}} ({{numeroExtenso config.multa_rescisoria_meses}}) aluguéis vigentes na oportunidade da infração, para ser aplicada à parte que descumprir qualquer das cláusulas do presente contrato.</p>
<p>7.2. Em caso de rescisão antecipada, na aplicação da multa prevista nesta cláusula, será observada a proporcionalidade prevista disposto do artigo 4º da Lei nº 8.245, de 18/10/91 (Lei do Inquilinato).</p>
{{else}}
<p>7.1. A parte que descumprir qualquer das cláusulas do presente contrato responderá pelas perdas e danos a que der causa. As partes convencionam que não haverá multa pré-fixada por rescisão antecipada, observado, quanto à devolução do imóvel, o disposto no artigo 4º da Lei nº 8.245, de 18/10/91 (Lei do Inquilinato).</p>
{{/if}}

<h2>8. GARANTIA</h2>
{{#if (eq garantia.tipo "titulo_capitalizacao")}}
<p>8.1. Para garantir as obrigações assumidas neste contrato, a PARTE LOCATÁRIA, por ser de seu interesse, dá neste ato, em caução à PARTE LOCADORA o Título de Capitalização{{#if (gt garantia.titulo_valor 0)}} no valor nominal de {{moeda garantia.titulo_valor}} ({{extenso garantia.titulo_valor}}){{/if}}{{#if garantia.provider}} subscrito pela {{garantia.provider}}{{/if}}{{#if (existe garantia.titulo_proposta)}}, representado pela proposta/formulário n.º {{garantia.titulo_proposta}}{{/if}}.</p>
<p>8.2. Ao término do prazo de vigência do Título, a PARTE LOCATÁRIA autoriza a {{#if garantia.provider}}{{garantia.provider}}{{else}}Sociedade de Capitalização{{/if}}, a REAPLICAR o valor de resgate, sempre em seu nome, dando origem a novo Título com as mesmas Condições Gerais dos Títulos inicialmente adquirido, sendo que este permanecerá como caução à locação supra referida até a efetiva desocupação do imóvel e entrega das chaves.</p>
<p>8.3. A PARTE LOCATÁRIA se responsabiliza em comunicar qualquer alteração cadastral ou então se manifestar contrariamente à reaplicação do título, com no mínimo 15 (quinze) dias de antecedência da data do vencimento do título.</p>
<p>8.4. Ao término do prazo de locação, desde que cumpridas pela PARTE LOCATÁRIA todas as obrigações decorrentes deste contrato, inclusive, a desocupação do imóvel e entrega das chaves sem a existência de qualquer débito, será liberado junto à {{#if garantia.provider}}{{garantia.provider}}{{else}}Sociedade de Capitalização{{/if}} a caução do(s) Título(s), apresentando(s). Para tanto, deverá ser apresentado documento rescisório da locação firmado pela PARTE LOCADORA e PARTE LOCATÁRIA, com o reconhecimento de firma das assinaturas, bem como outros documentos requeridos pela Sociedade de Capitalização.</p>
<p>8.5. Se a PARTE LOCATÁRIA não observar quaisquer das cláusulas do presente contrato, fica, desde já, a PARTE LOCADORA autorizada a resgatar o(s) Título(s) caucionado(s), a qualquer momento, mesmo antes do prazo final de capitalização, inclusive com a correção devida, independentemente de interpelação judicial ou extrajudicial, a fim de que o valor do resgate quite eventual importância que lhe seja devida em razão de débitos oriundos deste contrato, respeitando os termos descritos nas condições gerais do título de capitalização.</p>
<p>8.6. Se por acaso a PARTE LOCATÁRIA contestar o valor apresentado e ajuizar a competente ação cautelar de prestação de contas, correrão por conta dos mesmos todas as despesas consequentes, inclusive custas e honorários advocatícios.</p>
{{else if (eq garantia.tipo "fiador")}}
<p>8.1. Para garantir as obrigações assumidas neste contrato, o(a) FIADOR(A) qualificado(a) no preâmbulo assume responsabilidade solidária com a PARTE LOCATÁRIA, com expressa renúncia ao benefício de ordem (arts. 827 e 838 do Código Civil), respondendo até a efetiva entrega das chaves, ainda que a locação se prorrogue por prazo indeterminado.</p>
{{else if (eq garantia.tipo "caucao")}}
<p>8.1. Para garantir as obrigações assumidas neste contrato, a PARTE LOCATÁRIA dá neste ato, a título de caução, o equivalente a {{garantia.caucao_meses}} ({{numeroExtenso garantia.caucao_meses}}) aluguéis, nos termos do art. 38 da Lei nº 8.245/91, a ser restituído ao final da locação, deduzidos eventuais débitos e danos apurados em vistoria.</p>
{{else if (eq garantia.tipo "seguro_fianca")}}
<p>8.1. Para garantir as obrigações assumidas neste contrato, a locação é garantida por seguro de fiança locatícia{{#if garantia.provider}} contratado junto a {{garantia.provider}}{{/if}}{{#if (gt garantia.cobertura_meses 0)}}, com cobertura de {{garantia.cobertura_meses}} ({{numeroExtenso garantia.cobertura_meses}}) meses de aluguel{{/if}}, cujas condições e apólice integram este contrato.</p>
{{else if (eq garantia.tipo "garantia_digital")}}
<p>8.1. Para garantir as obrigações assumidas neste contrato, a locação é garantida por garantia locatícia{{#if garantia.provider}} prestada por {{garantia.provider}}{{/if}}{{#if (gt garantia.cobertura_meses 0)}}, com cobertura de {{garantia.cobertura_meses}} ({{numeroExtenso garantia.cobertura_meses}}) meses de aluguel{{/if}}, na forma do respectivo termo de adesão, que integra este contrato.</p>
{{else if (eq garantia.tipo "sem_garantia")}}
<p>8.1. As partes ajustam a presente locação sem modalidade de garantia, nos termos do art. 37 da Lei nº 8.245/91.</p>
{{else}}
<p>8.1. A locação é garantida na modalidade ajustada entre as partes, observado o art. 37 da Lei nº 8.245/91.</p>
{{/if}}

<h2>9. ENCARGOS DA LOCAÇÃO E SEGURO CONTRA INCÊNDIO</h2>
<p>9.1. Correrão por conta exclusiva da PARTE LOCATÁRIA, os pagamentos da integralidade dos impostos e taxas que sobre o imóvel recaem ou venham a recair, respondendo ainda, a PARTE LOCATÁRIA, pela totalidade das despesas decorrentes do consumo de energia, água (se houver), gás (se houver) e IPTU, qualquer que seja a forma da respectiva cobrança.</p>
<p>9.1.1. Compromete-se a PARTE LOCATÁRIA a entregar à PARTE LOCADORA a "notificação de lançamento" do IPTU.</p>
{{#if (existe config.administradora_nome)}}
{{#if (eq config.encargos_repasse "paga_e_retem")}}
<p>9.1.2. Os valores correspondentes ao IPTU{{#if (gt aluguel.iptu_mensal 0)}} ({{moeda aluguel.iptu_mensal}} por mês – valor de referência){{/if}} e despesas ordinárias de condomínio{{#if (gt aluguel.condominio_mensal 0)}} ({{moeda aluguel.condominio_mensal}} – valor de referência){{/if}}, de responsabilidade final da PARTE LOCATÁRIA, serão pagos diretamente pela ADMINISTRADORA junto aos respectivos credores, sendo os valores correspondentes deduzidos dos repasses mensais devidos à PARTE LOCADORA e cobrados da PARTE LOCATÁRIA juntamente com o aluguel.{{#if (gt aluguel.encargos 0)}} O total dos encargos mensais, na data de assinatura deste contrato, é de {{moeda aluguel.encargos}}, sujeito a alteração conforme os lançamentos do condomínio e do Município.{{/if}}</p>
{{else}}
<p>9.1.2. Os valores correspondentes ao IPTU{{#if (gt aluguel.iptu_mensal 0)}} ({{moeda aluguel.iptu_mensal}} por mês – valor de referência){{/if}} e despesas ordinárias de condomínio{{#if (gt aluguel.condominio_mensal 0)}} ({{moeda aluguel.condominio_mensal}} – valor de referência){{/if}}, são de responsabilidade da PARTE LOCATÁRIA e serão lançados pela ADMINISTRADORA, juntamente com o valor do aluguel, no mesmo boleto, devendo ser efetuado o respectivo pagamento na data do vencimento do aluguel.{{#if (gt aluguel.encargos 0)}} O total dos encargos mensais lançados no boleto, na data de assinatura deste contrato, é de {{moeda aluguel.encargos}}, sujeito a alteração conforme os lançamentos do condomínio e do Município.{{/if}}</p>
<p>9.1.3. A PARTE LOCATÁRIA declara-se ciente de que o IPTU e despesas ordinárias de condomínio são pagos a vencer, ao contrário do aluguel que será pago vencido, declarando-se ciente também que antes do vencimento do primeiro mês de locação haverá a cobrança desse encargo.</p>
{{/if}}
{{/if}}
<p>9.2. A PARTE LOCATÁRIA será responsável ainda pelo pagamento de todas as despesas, multas e demais sanções decorrentes do mau uso do imóvel e ou eventual retenção dos avisos de impostos, taxas e demais encargos públicos que incidem ou vierem incidir sobre o mesmo.</p>
{{#if (eq config.contas_consumo_individualizadas false)}}
<p>9.3. As contas de consumo de {{config.contas_no_condominio_texto}} não são individualizadas e integram o rateio de despesas do condomínio, sendo pagas pela PARTE LOCATÁRIA juntamente com as despesas condominiais, não havendo transferência de titularidade junto às respectivas concessionárias.</p>
<p>9.3.1. As demais contas de consumo individualizadas, se houver, deverão ser transferidas para o nome da PARTE LOCATÁRIA, por sua conta e suas expensas, junto às respectivas concessionárias, no prazo de até 30 (trinta) dias da assinatura do presente contrato, obrigando-se a PARTE LOCATÁRIA, ao final da locação e na oportunidade da entrega das chaves, a apresentar as 03 (três) últimas contas quitadas e o comprovante de solicitação de suspensão dos respectivos serviços.</p>
{{else}}
<p>9.3. A PARTE LOCATÁRIA se compromete, sempre que solicitado e na ocasião da entrega das chaves do imóvel, a apresentar as 03 (três) últimas contas quitadas junto às concessionárias de energia elétrica, água (se houver) e gás (se houver).</p>
<p>9.3.1. Compromete-se ainda a PARTE LOCATÁRIA por sua conta e suas expensas, providenciar a transferência para seu nome das contas de consumo de energia, água (se houver) e gás (se houver) junto às respectivas concessionárias no prazo de até 30 (trinta) dias da assinatura do presente contrato.</p>
<p>9.3.2. Ao final da locação e na oportunidade da entrega das chaves obriga-se a PARTE LOCATÁRIA a apresentar também o comprovante de solicitação de suspensão dos serviços de fornecimento de energia, água (se houver) e gás (se houver) junto às respectivas concessionárias.</p>
{{/if}}
<p>9.4. A PARTE LOCATÁRIA se compromete a efetuar seguro contra incêndio de todo do imóvel no valor de 100 (cem) vezes o valor do aluguel, que deverá ser periodicamente reajustado, de sorte a se manter atualizado, emitindo-se a apólice em favor da PARTE LOCADORA, em cujo poder ficará para que, no caso de sinistro, possam os mesmos reconstruir o imóvel, facultado à PARTE LOCATÁRIA reocupá-lo, terminada a obra, pelo tempo que restar a locação.</p>

<h2>10 - CONDIÇÕES GERAIS</h2>
<p>10.1. Na hipótese de o imóvel sofrer desapropriação, estará o presente contrato rescindido a partir da citação para a ação expropriatória, sendo certo que caberá à PARTE LOCADORA receber o valor da indenização, podendo a PARTE LOCATÁRIA, se assim entender, promover, contra o órgão expropriante, a ação de indenização a que porventura tiver direito.</p>
<p>10.1.1. A rescisão deste contrato, na hipótese prevista nesta cláusula, não obrigará nenhuma das partes a indenizar a outra.</p>
<p>10.1.2. Os aluguéis serão contados até a data da efetiva desocupação e entrega das chaves do imóvel à PARTE LOCADORA.</p>
<p>10.2. Tudo quanto for devido, em razão deste contrato, e que não comporte processo executivo, será cobrado em ação competente, respondendo o devedor, em qualquer hipótese, pelos honorários advocatícios fixados em 20% (vinte por cento) sobre o valor do débito que o credor constituir para o patrocínio dos seus direitos.</p>
<p>10.3. Obriga-se a PARTE LOCATÁRIA a não praticar e proibir a prática, dentro dos limites do imóvel locado, de atos contrários aos bons costumes, à moral, e a perturbação da vizinhança, além de zelarem e efetuarem as suas expensas, pela manutenção, asseio e conservação das instalações e dependências do imóvel objeto da presente locação, inclusive quanto aos reparos e obras a serem realizadas, oriundas de exigências formuladas pelo Poder Público.</p>
<p>10.4. A PARTE LOCATÁRIA autoriza proceder sua citação inicial, interpelações, intimações, notificações, ou qualquer outro ato de comunicação processual, mediante correspondência com AR/MP (aviso de recebimento), ou mensagem enviada ao endereço eletrônico indicado no preâmbulo, ou ainda, sendo necessário, pelas demais formas previstas no Código de Processo Civil, em toda e qualquer ação judicial ou procedimento extrajudicial, decorrentes da relação locatícia ora ajustada, especialmente as intimações referidas nos artigos 62, inciso III e 67 incisos II e VII da lei 8.245/91.</p>
<p>10.5. Quaisquer questões oriundas do presente contrato serão dirimidas no Foro {{#if (existe config.foro_texto)}}da comarca de {{config.foro_texto}}{{else}}da comarca de localização do imóvel{{/if}}, eleito pelas partes como o único competente para tal, com renúncia a qualquer outro, por mais privilegiado que seja ou possa vir a ser.</p>

<p>E por estarem justos e acertados, assinam este instrumento, em 03 (três) vias de igual teor e forma, na presença de duas testemunhas abaixo nomeadas.</p>

